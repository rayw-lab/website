# 构建产物
dist/

# 依赖与生成缓存
node_modules/
.astro/

# 日志
npm-debug.log*
pnpm-debug.log*

# 环境变量（密钥禁止入库）
.env
.env.*
!.env.example

# 系统文件
.DS_Store

# 浏览器测试临时产物
.playwright-mcp/

# Playwright E2E 运行产物（报告与截图入库路径为 docs/spec/assets/）
test-results/
playwright-report/

# Lighthouse CI 本地复跑产物（lhci autorun，见鸟瞰图 §12 cheatsheet）
.lighthouseci/

# 第三方参考仓库 clone（约 760MB，静态资产过大不入库；见 vendor/README.md）
vendor/*
!vendor/README.md
dist-next/
dist-before/
.tmp/
