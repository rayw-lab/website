{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4321/website/",
        "http://127.0.0.1:4321/website/home/",
        "http://127.0.0.1:4321/website/work/",
        "http://127.0.0.1:4321/website/work/multilingual-cockpit/",
        "http://127.0.0.1:4321/website/about/",
        "http://127.0.0.1:4321/website/lab/car-configurator/",
        "http://127.0.0.1:4321/website/lab/tts-cockpit/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/website/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": ".*/website/$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": ".*/website/.+",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }]
          }
        }
      ]
    }
  }
}
