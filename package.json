{
  "name": "website",
  "version": "0.1.0",
  "description": "个人网站：Astro + TypeScript + MDX，部署到 GitHub Pages（见 docs/website-plan/master-plan.md）",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:e2e": "astro build && playwright test",
    "test:e2e:report": "playwright show-report",
    "test:visual": "astro build && playwright test --project=visual-chromium --no-deps",
    "lhci:local": "node scripts/run-quality-loop.mjs --full --skip-e2e --skip-score",
    "quality:loop": "node scripts/run-quality-loop.mjs --quick",
    "quality:loop:full": "node scripts/run-quality-loop.mjs --full",
    "score": "node scripts/score-loop.mjs",
    "human-gate:preview": "node scripts/human-gate-preview.mjs",
    "human-gate:verify": "node scripts/verify-human-gate.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.185.4",
    "astro": "^7.2.4",
    "typescript": "^5.9.3",
    "vite-plugin-wasm": "^3.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.20.0",
    "three": "^0.185.1"
  }
}
