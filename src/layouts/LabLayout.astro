---
// Lab Demo 页壳（SRD §7 [P2]；Track C · C1）：嵌入 BaseLayout 获得全站导航 /
// SEO meta / JSON-LD / 统计（LAB-03/04「接入全站布局与导航」），并读 manifest
// 渲染页眉（LAB 编号 / 状态 / 技术角标）、面包屑与页脚回链。
// LAB-05「30 秒结论 + 跳过出口」内建于本布局：页面经 slot="conclusion"（两三句话）
// 与 slot="capability-figure"（一张能力示意）供稿，结论区无需任何交互即可读完；
// 跳过出口 = 「跳过演示直接看说明」锚点 + 「返回 Lab 索引」双链。
// 演示主体（LabStage + 模块专属控制面）仍由页面经默认 slot 组装。
import BaseLayout from './BaseLayout.astro';
import type { LabModule } from '../lab/contracts';
import { breadcrumbJsonLd } from '../data/jsonld';

interface Props {
  module: LabModule;
  /** 视觉主题：dark（配置器系）/ paper（技术编辑部系） */
  theme?: 'dark' | 'paper';
  /** 附加命名空间 class（旧页面样式命名空间，如 ttsc），挂在 .lab-scope 包装层 */
  bodyClass?: string;
  /** 「跳过演示」锚点（默认页脚说明区 #lab-notes；页面可指向自己的说明章节） */
  skipHref?: string;
}

const { module, theme = 'dark', bodyClass, skipHref = '#lab-notes' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const title = `${module.title}｜LAB ${module.code}｜王磊`;
const statusLabel = { live: 'LIVE', wip: 'WIP', archived: 'ARCHIVED' }[module.status];

const homeUrl = new URL(`${base}/`, Astro.site).href;
const jsonLd = breadcrumbJsonLd([
  { name: '首页', url: homeUrl },
  { name: 'Lab 实验室', url: new URL(`${base}/lab/`, Astro.site).href },
  { name: module.title, url: new URL(`${base}/lab/${module.slug}/`, Astro.site).href },
]);
---

<BaseLayout title={title} description={module.description} jsonLd={jsonLd} trackScroll>
  <Fragment slot="head"><slot name="head" /></Fragment>

  <div class:list={['lab-scope', `lab-theme-${theme}`, bodyClass]}>
    <div class="lab-page">
      <header class="lab-masthead">
        <nav class="lab-crumb lab-mono" aria-label="面包屑">
          <a href={`${base}/`}>首页</a>
          <span aria-hidden="true">/</span>
          <a href={`${base}/lab/`}>Lab</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{module.slug}</span>
        </nav>
        <p class="lab-code lab-mono">
          LAB / {module.code} · {module.kind.toUpperCase()}
          <span class:list={['lab-status', `lab-status-${module.status}`]}>{statusLabel}</span>
        </p>
        <h1 class="lab-title">{module.title}</h1>
        <p class="lab-lede"><slot name="lede">{module.description}</slot></p>
        <ul class="lab-chips lab-mono" aria-label="技术要点">
          {module.techChips.map((chip) => <li>{chip}</li>)}
        </ul>
        <slot name="masthead-extra" />
      </header>

      <!-- LAB-05：30 秒结论区（零交互可读）+ 跳过出口 -->
      {
        Astro.slots.has('conclusion') && (
          <section class="lab-tldr" aria-labelledby="lab-tldr-heading">
            <div class="lab-tldr-bar">
              <h2 class="lab-tldr-heading" id="lab-tldr-heading">
                <span class="lab-mono lab-tldr-tag">30 SEC</span>这个演示证明什么
              </h2>
              <p class="lab-skip lab-mono">
                不想交互？
                <a href={skipHref}>跳过演示，直接看实现说明 ↓</a>
                <span aria-hidden="true">·</span>
                <a href={`${base}/lab/`}>返回 Lab 索引</a>
              </p>
            </div>
            <div class="lab-tldr-grid">
              <div class="lab-tldr-text">
                <slot name="conclusion" />
              </div>
              {Astro.slots.has('capability-figure') && (
                <div class="lab-tldr-figure">
                  <slot name="capability-figure" />
                </div>
              )}
            </div>
          </section>
        )
      }

      <div class="lab-main">
        <slot />
      </div>

      <footer class="lab-foot" id="lab-notes">
        <slot name="footer" />
        <p class="lab-back"><a href={`${base}/`}>← 返回首页</a> · <a href={`${base}/lab/`}>Lab 索引</a></p>
      </footer>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* ---------- Lab 主题 token（LabLayout / LabStage / 页面共用） ----------
     挂在 .lab-scope 包装层（非 body）：站点 Header/Footer 保持全站主题，
     演示画布区独立配色（C1 接入 BaseLayout 后的分层约定）。 */
  .lab-scope.lab-theme-dark {
    --lab-bg: #0b0c0f;
    --lab-panel: #101216;
    --lab-line: #23252c;
    --lab-line-strong: #34373f;
    --lab-text: #e8e9eb;
    --lab-muted: #9aa0aa;
    --lab-accent: #9ecbff;
    --lab-accent-on-stage: #9ecbff;
    color-scheme: dark;
  }
  .lab-scope.lab-theme-paper {
    --lab-bg: #f5f4ef;
    --lab-panel: #fffdf7;
    --lab-line: #d8d5c9;
    --lab-line-strong: #b0ac9d;
    --lab-text: #1c1d1f;
    --lab-muted: #595b60;
    --lab-accent: #cf4a17;
    --lab-accent-on-stage: #ff8a4b;
    color-scheme: light;
  }
  .lab-scope {
    --lab-mono: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace;
    background: var(--lab-bg);
    color: var(--lab-text);
    font-family: Inter, 'Source Han Sans SC', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei',
      system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  .lab-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.6rem 1.25rem 3rem;
  }
  .lab-page a {
    color: var(--lab-accent);
    text-decoration: none;
  }
  .lab-page a:hover {
    text-decoration: underline;
  }
  .lab-mono {
    font-family: var(--lab-mono);
  }

  /* ---------- 页眉（manifest 驱动） ---------- */
  .lab-crumb {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lab-muted);
    display: flex;
    gap: 0.6em;
    border-top: 3px solid var(--lab-line-strong);
    padding-top: 0.6rem;
  }
  .lab-crumb a {
    color: var(--lab-muted);
  }
  .lab-crumb a:hover {
    color: var(--lab-accent);
  }
  .lab-code {
    margin: 1.5rem 0 0.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--lab-accent);
  }
  .lab-status {
    margin-left: 0.8em;
    border: 1px solid var(--lab-line-strong);
    border-radius: 999px;
    padding: 0.1em 0.75em;
    font-size: 0.9em;
    letter-spacing: 0.12em;
    color: var(--lab-muted);
  }
  .lab-status-live {
    color: #59c99a;
    border-color: #59c99a66;
  }
  .lab-title {
    margin: 0.35rem 0 0.5rem;
    font-size: clamp(1.6rem, 3.6vw, 2.3rem);
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
  .lab-lede {
    margin: 0 0 1rem;
    max-width: 64ch;
    color: var(--lab-muted);
    font-size: 0.98rem;
  }
  .lab-lede b {
    color: var(--lab-text);
  }
  .lab-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 1.1rem;
    padding: 0;
    font-size: 0.7rem;
  }
  .lab-chips li {
    border: 1px solid var(--lab-line);
    background: color-mix(in srgb, var(--lab-panel) 72%, transparent);
    padding: 3px 10px;
    border-radius: 3px;
    letter-spacing: 0.06em;
    color: var(--lab-muted);
    white-space: nowrap;
  }

  /* ---------- LAB-05：30 秒结论区 + 跳过出口 ---------- */
  .lab-tldr {
    margin-top: 1.2rem;
    border: 1px solid var(--lab-line);
    border-left: 3px solid var(--lab-accent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--lab-panel) 82%, transparent);
    padding: 1rem 1.2rem 1.1rem;
  }
  .lab-tldr-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1.2rem;
    margin-bottom: 0.7rem;
  }
  .lab-tldr-heading {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }
  .lab-tldr-tag {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--lab-accent);
    border: 1px solid var(--lab-line-strong);
    border-radius: 999px;
    padding: 0.15em 0.75em;
    margin-right: 0.8em;
    vertical-align: 0.12em;
  }
  .lab-skip {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--lab-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
  }
  .lab-tldr-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1.2rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .lab-tldr-grid {
      grid-template-columns: 1fr;
    }
  }
  .lab-tldr-text p {
    margin: 0 0 0.7rem;
    font-size: 0.95rem;
    color: var(--lab-text);
  }
  .lab-tldr-text p:last-child {
    margin-bottom: 0;
  }
  .lab-tldr-text b {
    color: var(--lab-accent);
  }

  /* 能力示意（一张图讲清管线；HTML 流程图，随主题配色） */
  .lab-flowfig {
    margin: 0;
    border: 1px dashed var(--lab-line-strong);
    border-radius: 10px;
    padding: 0.9rem 1rem 0.75rem;
  }
  .lab-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }
  .lab-flow-node {
    font-family: var(--lab-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    border: 1px solid var(--lab-line-strong);
    border-radius: 6px;
    padding: 0.32em 0.7em;
    background: var(--lab-panel);
    color: var(--lab-text);
    white-space: nowrap;
  }
  .lab-flow-node.hl {
    border-color: var(--lab-accent);
    color: var(--lab-accent);
  }
  .lab-flow-arrow {
    font-family: var(--lab-mono);
    font-size: 0.78rem;
    color: var(--lab-muted);
  }
  .lab-flow-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .lab-flowfig figcaption {
    margin-top: 0.7rem;
    font-size: 0.7rem;
    color: var(--lab-muted);
    font-family: var(--lab-mono);
    letter-spacing: 0.04em;
  }

  .lab-main {
    margin-top: 1.4rem;
  }

  /* ---------- 页脚 ---------- */
  .lab-foot {
    margin-top: 3.2rem;
    border-top: 1px solid var(--lab-line);
    padding-top: 1.4rem;
  }
  .lab-back {
    margin: 1.4rem 0 0;
    font-size: 0.88rem;
  }
</style>
