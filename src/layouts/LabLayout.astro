---
// Lab Demo 页壳（SRD §7 [P2]）：读 manifest 渲染页眉（LAB 编号 / 状态 / 技术角标）、
// 面包屑与页脚回链；演示主体（LabStage + 模块专属控制面）由页面经默认 slot 组装。
// 页面瘦身目标：pages/lab/*.astro = LabLayout + 静态控制面 + facade 挂载点（§12.1 Phase 2）。
import type { LabModule } from '../lab/contracts';

interface Props {
  module: LabModule;
  /** 视觉主题：dark（配置器系）/ paper（技术编辑部系） */
  theme?: 'dark' | 'paper';
  /** 附加 body class（旧页面样式命名空间，如 ttsc） */
  bodyClass?: string;
}

const { module, theme = 'dark', bodyClass } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const title = `${module.title}｜LAB ${module.code}｜王磊`;
const statusLabel = { live: 'LIVE', wip: 'WIP', archived: 'ARCHIVED' }[module.status];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={module.description} />
    <meta name="color-scheme" content={theme === 'dark' ? 'dark' : 'light'} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class:list={[`lab-theme-${theme}`, bodyClass]}>
    <div class="lab-page">
      <header class="lab-masthead">
        <nav class="lab-crumb lab-mono" aria-label="面包屑">
          <a href={`${base}/`}>首页</a>
          <span aria-hidden="true">/</span>
          <a href={`${base}/lab/`}>Lab</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{module.slug}</span>
        </nav>
        <p class="lab-code lab-mono">
          LAB / {module.code} · {module.kind.toUpperCase()}
          <span class:list={['lab-status', `lab-status-${module.status}`]}>{statusLabel}</span>
        </p>
        <h1 class="lab-title">{module.title}</h1>
        <p class="lab-lede"><slot name="lede">{module.description}</slot></p>
        <ul class="lab-chips lab-mono" aria-label="技术要点">
          {module.techChips.map((chip) => <li>{chip}</li>)}
        </ul>
        <slot name="masthead-extra" />
      </header>

      <main class="lab-main">
        <slot />
      </main>

      <footer class="lab-foot">
        <slot name="footer" />
        <p class="lab-back"><a href={`${base}/`}>← 返回首页</a> · <a href={`${base}/lab/`}>Lab 索引</a></p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  /* ---------- Lab 主题 token（LabLayout / LabStage / 页面共用） ---------- */
  body.lab-theme-dark {
    --lab-bg: #0b0c0f;
    --lab-panel: #101216;
    --lab-line: #23252c;
    --lab-line-strong: #34373f;
    --lab-text: #e8e9eb;
    --lab-muted: #9aa0aa;
    --lab-accent: #9ecbff;
    --lab-accent-on-stage: #9ecbff;
    color-scheme: dark;
  }
  body.lab-theme-paper {
    --lab-bg: #f5f4ef;
    --lab-panel: #fffdf7;
    --lab-line: #d8d5c9;
    --lab-line-strong: #b0ac9d;
    --lab-text: #1c1d1f;
    --lab-muted: #595b60;
    --lab-accent: #cf4a17;
    --lab-accent-on-stage: #ff8a4b;
    color-scheme: light;
  }
  body.lab-theme-dark,
  body.lab-theme-paper {
    --lab-mono: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace;
    margin: 0;
    background: var(--lab-bg);
    color: var(--lab-text);
    font-family: Inter, 'Source Han Sans SC', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei',
      system-ui, sans-serif;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  .lab-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.6rem 1.25rem 3rem;
  }
  .lab-page a {
    color: var(--lab-accent);
    text-decoration: none;
  }
  .lab-page a:hover {
    text-decoration: underline;
  }
  .lab-mono {
    font-family: var(--lab-mono);
  }

  /* ---------- 页眉（manifest 驱动） ---------- */
  .lab-crumb {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lab-muted);
    display: flex;
    gap: 0.6em;
    border-top: 3px solid var(--lab-line-strong);
    padding-top: 0.6rem;
  }
  .lab-crumb a {
    color: var(--lab-muted);
  }
  .lab-crumb a:hover {
    color: var(--lab-accent);
  }
  .lab-code {
    margin: 1.5rem 0 0.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--lab-accent);
  }
  .lab-status {
    margin-left: 0.8em;
    border: 1px solid var(--lab-line-strong);
    border-radius: 999px;
    padding: 0.1em 0.75em;
    font-size: 0.9em;
    letter-spacing: 0.12em;
    color: var(--lab-muted);
  }
  .lab-status-live {
    color: #59c99a;
    border-color: #59c99a66;
  }
  .lab-title {
    margin: 0.35rem 0 0.5rem;
    font-size: clamp(1.6rem, 3.6vw, 2.3rem);
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
  .lab-lede {
    margin: 0 0 1rem;
    max-width: 64ch;
    color: var(--lab-muted);
    font-size: 0.98rem;
  }
  .lab-lede b {
    color: var(--lab-text);
  }
  .lab-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 1.1rem;
    padding: 0;
    font-size: 0.7rem;
  }
  .lab-chips li {
    border: 1px solid var(--lab-line);
    background: color-mix(in srgb, var(--lab-panel) 72%, transparent);
    padding: 3px 10px;
    border-radius: 3px;
    letter-spacing: 0.06em;
    color: var(--lab-muted);
    white-space: nowrap;
  }
  .lab-main {
    margin-top: 1.4rem;
  }

  /* ---------- 页脚 ---------- */
  .lab-foot {
    margin-top: 3.2rem;
    border-top: 1px solid var(--lab-line);
    padding-top: 1.4rem;
  }
  .lab-back {
    margin: 1.4rem 0 0;
    font-size: 0.88rem;
  }
</style>
