---
// /world/{slug}/ —— 楼内展厅 HTML（ADR-2）。不是世界引擎入口：
// 不 import src/lab/world/**，不进 Lab manifest，不走 Lab facade。
// slug 白名单 = src/data/world-halls.json；未知 slug 不生成。
import WorldHallLayout from '../../layouts/WorldHallLayout.astro';
import HallChrome from '../../components/city/HallChrome.astro';
import Hero from '../../components/city/halls/about/Hero.astro';
import Curator from '../../components/city/halls/about/Curator.astro';
import Stations from '../../components/city/halls/about/Stations.astro';
import Transition from '../../components/city/halls/about/Transition.astro';
import Crystal from '../../components/city/halls/about/Crystal.astro';
import Epilogue from '../../components/city/halls/about/Epilogue.astro';
import Yin from '../../components/city/halls/nexus/Yin.astro';
import Flow from '../../components/city/halls/nexus/Flow.astro';
import Seal from '../../components/city/halls/nexus/Seal.astro';
import Trial from '../../components/city/halls/nexus/Trial.astro';
import ledger from '../../data/nexus-ledger.json';
import hallsDoc from '../../data/world-halls.json';
import cityMap from '../../data/cyber-city-buildings.json';
import { TITLE_SUFFIX } from '../../data/site';
import { breadcrumbJsonLd } from '../../data/jsonld';
import { HALL_SUBTITLE } from '../../data/about-copy';

interface HallEntry {
  slug: string;
  buildingId: string;
  trick: string;
  scenes: unknown[];
}

// 墨迹展厅的副题从台账派生，正文一个数字都不手写（与组件同一条纪律）。
const nx = ledger.totals as Record<string, number>;
const nxRange = ledger.range as { from: string; to: string };

// 🔴 每个展厅的头部文案必须显式登记，缺了**构建期就炸**：
// 原代码的标题写死为 about 文案，照原样静默兜底会让新厅顶着
// 「在技术与落地之间架桥」上线且零报错——正是「沉默的垃圾桶」形态。
const HALL_COPY: Record<string, { title: string; description: string }> = {

/**
 * 文案表与票册的**双向**闭合。
 * 🔴 只挡「有 slug 无文案」是单向的：反过来「文案表里有一个谁也不认识的键」
 * （改名后留下的孤儿、或提前写好的下一个厅）会一直静默待着，
 * 直到某天有人以为它已经接线了。异源反核（glm）点名了这一侧，补上。
 * 两个方向都在构建期抛错，不留运行期惊喜。
 */
function assertHallCopyClosed(slugs: readonly string[]): void {
  const missing = slugs.filter((s) => !(s in HALL_COPY));
  if (missing.length > 0) {
    throw new Error(`world/[slug]：这些 slug 没有登记头部文案（见 HALL_COPY）：${missing.join(', ')}`);
  }
  const orphan = Object.keys(HALL_COPY).filter((k) => !slugs.includes(k));
  if (orphan.length > 0) {
    throw new Error(`world/[slug]：HALL_COPY 有孤儿键（world-halls.json 里没有这些 slug）：${orphan.join(', ')}`);
  }
}

export function getStaticPaths() {
  const halls = hallsDoc.halls as HallEntry[];
  assertHallCopyClosed(halls.map((h) => h.slug));
  return halls.map((hall) => {
    const building = cityMap.buildings.find((b) => b.id === hall.buildingId);
    if (!building) {
      throw new Error(
        `world-halls.json buildingId「${hall.buildingId}」不在 cyber-city-buildings.json`,
      );
    }
    return { params: { slug: hall.slug }, props: { hall, building } };
  });
}

interface Props {
  hall: HallEntry;
  building: (typeof cityMap.buildings)[number];
}

const { hall, building } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const copy = HALL_COPY[hall.slug]!;   // 存在性已由 assertHallCopyClosed() 在构建期担保
  'about-pavilion': { title: '在技术与落地之间架桥', description: HALL_SUBTITLE },
  'agent-nexus': {
    title: '墨迹 · Ink Ledger',
    description:
      `${nx.sessions} 次真实 AI 协作会话、${nx.days} 天、${nx.seats} 个席位，` +
      `按机器台账渲染成水墨（${nxRange.from} — ${nxRange.to}）。`,
  },
};
const title = `${copy.title}${TITLE_SUFFIX}`;
const description = copy.description;
const homeUrl = new URL(`${base}/`, Astro.site).href;
const hallUrl = new URL(`${base}/world/${hall.slug}/`, Astro.site).href;
const jsonLd = breadcrumbJsonLd([
  { name: '首页', url: homeUrl },
  { name: building.title.zh, url: hallUrl },
]);
---

<WorldHallLayout
  title={title}
  description={description}
  slug={hall.slug}
  neonColor={building.neonColor}
  jsonLd={jsonLd}
>
  <HallChrome slot="ritual" buildingId={hall.buildingId} />
  {hall.slug === 'about-pavilion' && (
    <>
      <Hero />
      <Curator />
      <Stations />
      <Transition />
      <Crystal />
      <Epilogue />
    </>
  )}
  {hall.slug === 'agent-nexus' && (
    <>
      <Yin />
      <section class="nx-band">
        <div class="nx-band__head">
          <h2 class="nx-band__t">墨流 · 这 {nx.days} 天落在同一张纸上</h2>
          <p class="nx-band__n">
            <span><b>{nx.sessions}</b> 会话　</span>
            <span><b>{nx.days}</b> 天　</span>
            <span><b>{nx.seats}</b> 席位　</span>
            {nxRange.from} — {nxRange.to}
          </p>
        </div>
        <Flow spanSeconds={16} />
      </section>
      <section class="nx-seals"><Seal limit={24} /></section>
      <section class="nx-seals"><Trial /></section>
    </>
  )}
</WorldHallLayout>

<style>
  /* 墨迹展厅的分带排版。只在本路由用到，跟着页面走不进 hall.css，
     免得一个全站样式表里塞两套互相矛盾的主题。 */
  .nx-band {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.4rem;
    padding: clamp(2rem, 7vh, 5rem) clamp(1.5rem, 6vw, 6rem) clamp(3rem, 9vh, 6rem);
  }
  .nx-band__head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1.5rem; flex-wrap: wrap;
    border-bottom: 1px solid #1c1f2622; padding-bottom: .9rem;
  }
  .nx-band__t {
    margin: 0; font-weight: 400; letter-spacing: .05em;
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-family: "Songti SC", "STSong", "Source Han Serif SC", "Noto Serif CJK SC", "SimSun", serif;
  }
  .nx-band__n {
    margin: 0; letter-spacing: .12em; opacity: .62;
    font: 400 clamp(.72rem, 1.1vw, .84rem)/1.7 ui-sans-serif, system-ui, sans-serif;
  }
  .nx-band__n b { font-weight: 600; opacity: .9; }
  .nx-seals { padding: 0 clamp(1.5rem, 6vw, 6rem) clamp(3rem, 9vh, 6rem); }
</style>
