  /* ---------- 驾驶 HUD ----------
     [CC-L2 A7] 霓虹面板化：1px 霓虹描边 + 8% 填色（设计提案 §5.2 HUD 面板规范）；
     visibility 门控代替 aria-hidden——隐藏态不可聚焦不进 AT（销 aria-hidden-focus），
     ready 态成为世界内 HUD（与 3D 同族光效语言，销 A4 观察⑨「挂载后退化素面」） */
  /* [CC-L2-a+ V6] HUD 字级/留白/画面占比收紧（AL2-a §6-2）：速度表 28.8→38.4px、
     单位/按钮字级同步上调，面板内衬与整栏留白放宽——挂载后 HUD 从「角落小件」
     升为世界内可读仪表（画面占比↑，仍不压 3D 主体） */
  .hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 4;
    display: flex;
    align-items: flex-end;
    gap: 1.3rem;
    padding: 1rem 1.35rem 1.1rem;
    background: linear-gradient(180deg, transparent, rgba(4, 6, 10, 0.62));
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 400ms ease,
      visibility 0s linear 400ms;
    pointer-events: none;
  }
  .world[data-state='ready'] .hud {
    opacity: 1;
    visibility: visible;
    transition: opacity 400ms ease;
  }
  .hud-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    padding: 0.5em 1.1em 0.55em;
    border: 1px solid color-mix(in srgb, var(--neon-cyan) 50%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--neon-cyan) 8%, rgba(5, 9, 15, 0.66));
    backdrop-filter: blur(6px);
    box-shadow: inset 0 0 14px color-mix(in srgb, var(--neon-cyan) 10%, transparent);
  }
  .hud-num {
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 2.4rem;
    font-weight: 650;
    color: #eef2f7;
    text-shadow: 0 0 12px color-mix(in srgb, var(--neon-cyan) 55%, transparent);
  }
  /* [Tier-C T-2] 霓虹弧线：220° 弧随速点亮（--speed-ratio 由引擎 HUD 拍写入 0-1；
     拦截态 .hud visibility:hidden 零像素影响；boost 时变品红由 data-boost 选择器承接） */
  .hud-arc {
    position: absolute;
    inset: -3px;
    width: calc(100% + 6px);
    height: calc(100% + 6px);
    pointer-events: none;
    overflow: visible;
  }
  .hud-arc-track,
  .hud-arc-bar {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    /* 220° 弧长: 2π×42×(220/360) ≈ 161.3；dasharray 后段为空白 */
    stroke-dasharray: 161.3 264;
    transform-origin: 50% 50%;
    transform: rotate(160deg);
  }
  .hud-arc-track {
    stroke: color-mix(in srgb, var(--neon-cyan) 15%, transparent);
  }
  .hud-arc-bar {
    stroke: var(--neon-cyan);
    filter: drop-shadow(0 0 6px var(--neon-cyan));
    stroke-dashoffset: calc(161.3px * (1 - var(--speed-ratio, 0)));
    transition:
      stroke-dashoffset 150ms ease-out,
      stroke 200ms ease;
  }
  .hud-unit {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--neon-cyan) 65%, #dfe5ec);
  }
  .hud-respawn {
    pointer-events: auto;
    margin-left: auto;
    font: inherit;
    font-size: 0.88rem;
    letter-spacing: 0.06em;
    color: var(--neon-ink);
    background: color-mix(in srgb, var(--neon-cyan) 8%, rgba(10, 16, 22, 0.78));
    border: 1px solid color-mix(in srgb, var(--neon-cyan) 45%, transparent);
    border-radius: 10px;
    padding: 0.5em 1.15em;
    cursor: pointer;
  }
  .hud-respawn:hover,
  .hud-respawn:focus-visible {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 14px color-mix(in srgb, var(--neon-cyan) 35%, transparent);
  }

  /* [CC-L2 A7] mini 楼宇快览：右下常驻 5 栋 hero 楼（1px 描边 + 8% 填色同族面板；
     visibility 门控同 .hud——ready 前不可聚焦，ready 后链接键盘可达真实 URL）。
     [CC-L2-a+ V6] 字级/留白/占比收紧（AL2-a §6-2「mini 字级偏小」）：行字级
     12.8→14.4px、标题 12→12.8px、面板加宽 15.5→17.5rem、行距/内衬同步放宽 */
  .hud-city {
    position: absolute;
    right: 1.1rem;
    bottom: 6rem;
    z-index: 4;
    width: 17.5rem;
    max-width: calc(100vw - 2.2rem);
    padding: 0.95rem 1.05rem 1rem;
    border: 1px solid color-mix(in srgb, var(--neon-cyan) 45%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--neon-cyan) 8%, rgba(5, 9, 15, 0.66));
    backdrop-filter: blur(6px);
    box-shadow: inset 0 0 16px color-mix(in srgb, var(--neon-cyan) 8%, transparent);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 400ms ease,
      visibility 0s linear 400ms;
  }
  .world[data-state='ready'] .hud-city {
    opacity: 1;
    visibility: visible;
    transition: opacity 400ms ease;
  }
  .hud-city-title {
    margin: 0 0 0.55rem;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--neon-cyan);
    text-shadow: 0 0 8px color-mix(in srgb, var(--neon-cyan) 55%, transparent);
  }
  .hud-city ul {
    margin: 0;
    padding: 0;
