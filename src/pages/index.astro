---
// `/` —— Full Entry 科技城入口壳（CC-E7 路由原子切换；PRD 终裁 D1 / CITY-01/02/09；
// SRD §12.7.1 路由表 v2.0）。原五区块宪法首页整体平移 /home/（零回归）。
//
// 预算红线（SRD §12.7.2 G-A′，audit-budget 硬阻断）：壳静态段 HTML+CSS ≤35KB /
// 引导 JS ≤15KB / poster ≤40KB / 合计 ≤90KB gzip；world 分包零静态标签——
// 只允许引导脚本动态 import（本页 HTML 中无任何 three/GLB/HDRI/world chunk 的
// <script src> / <link rel=preload>）。
//
// 壳结构（实施方案 §4.2「静态壳即加载屏即速览页」）：
//   poster（LCP 元素，实景压缩关键帧）+ H1 定位语 + 三支柱硬数字 + 六导航 <a>
//   + 楼宇快览（DOM 版 12 楼列表 → 真实 URL，爬虫可读、挂载前可点）+ noscript 全导航；
//   「跳过 3D」= DOM 首个可聚焦元素，第 0 秒可点直达 /home/（新承诺二 / CITY-02）。
//
// 挂载策略（§4.3 四条件，任一不满足 → 静态壳 + 显式「进入科技城」按钮）：
//   window.load 后 ①非 prefers-reduced-motion ②非 Save-Data ③视口宽 ≥768px
//   ④WebGPU 或 WebGL 2 可用——全过才自动挂载（再静置一拍，给「秒点跳过」的
//   访客让路：跳过路径全程零 world 字节，SRD §12.7.8 出口①）。
//
// SEO：canonical 自指；WebSite + Person JSON-LD 留在 `/`（§4.1）；index,follow。
// 深链契约（SRD §12.7.8 出口⑧）：?poi=<id>（id = buildings JSON slug）出生于对应楼
// parkingBay；PARAM_ALLOWLIST 七参数见引导脚本（M4/M6/M9 全部转正，无 location.search 旁路）。
import cityMap from '../data/cyber-city-buildings.json';
import { personJsonLd, webSiteJsonLd } from '../data/jsonld';
import { NEON } from '../data/neon-tokens';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const title = '王磊｜汽车智能座舱与 AI 解决方案经理 · 智能座舱科技城';
const description =
  '全屏赛博科技城 Full Entry：座舱 AI 机器人 ↔ CarConcept 一键变形、十字路口 WASD 驾驶，12 栋主题大楼即全站导航；可随时跳过 3D 直达内容首页。';

const homeUrl = new URL(`${base}/`, Astro.site).href;
const jsonLdAll = [personJsonLd(homeUrl), webSiteJsonLd(homeUrl)];

// 六导航（品牌区 Home=/home/ 内容首页 + 五栏目，与 SiteHeader 清单同源；noscript 复用）
const nav = [
  { href: `${base}/home/`, label: 'Home' },
  { href: `${base}/work/`, label: 'Work' },
  { href: `${base}/insights/`, label: 'Insights' },
  { href: `${base}/ai-lab/`, label: 'AI Lab' },
  { href: `${base}/about/`, label: 'About' },
  { href: `${base}/contact/`, label: 'Contact' },
];

// 三支柱硬数字（与 /home/ 区块 2 同源锚点，master-plan §3）
const pillars = [
  '16 语种 · RTL/CJK 全覆盖',
  '端 × 云 · 2 层选型框架',
  '需求 → 复盘 · 4 阶段覆盖',
];

// 楼宇快览（数据单源 buildings JSON：12 栋在册楼 → deepLink 真实 URL，
// 「楼即产品线」的 DOM 面——挂载前可点、爬虫可读；进站纪律 = 真实 URL 直跳）
const buildings = cityMap.buildings.map((b) => ({
  id: b.id,
  title: b.title.zh,
  en: b.title.en,
  href: `${base}${b.deepLink}`,
  color: b.neonColor,
  hero: b.lodProfile === 'hero',
}));

// [CC-L2 A7] 挂载后 mini 楼宇快览：5 栋 hero 楼（lodProfile=hero 单源筛选，
// 与 streaming.spawnHd 五钉同集）——cover 淡出后世界内常驻的「楼即产品线」DOM 面
const heroTowers = buildings.filter((b) => b.hero);

// [NX-W17 回城协议] 回城幕布小表：id → { fx, zh, en }（buildings JSON 单源；arrivalFx 缺席 = 'fade'）。
// 同时是 head 脚本的 poi 合法性白名单——sessionStorage 里的陌生 id 一律不续驶。
const returnMap = Object.fromEntries(
  cityMap.buildings.map((b) => [b.id, { fx: b.arrivalFx ?? 'fade', zh: b.title.zh, en: b.title.en }]),
);
---

<!doctype html>
<!-- [CC-L2-a+] 霓虹 token 真单源（AL2-a §2 收窄条款销账）：--neon-cyan/--neon-magenta
     不再是 CSS 字面量拷贝，构建期从 src/data/neon-tokens.ts 注入（引擎 Roads/
     NeonMaterials/Reveal 同一 import）——跨 TS/CSS 单一事实源，改色只改 token 模块 -->
<html lang="zh-CN" style={`--neon-cyan: ${NEON.cyan}; --neon-magenta: ${NEON.magenta};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={homeUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="theme-color" content="#05070d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={homeUrl} />
    <meta property="og:locale" content="zh_CN" />
    <!-- [CC-L2 A10] OG 与壳 poster 同源同帧（重拍主帧一拍三吃：静态壳/移动端/OG） -->
    <meta
      property="og:image"
      content={new URL(`${base}/posters/cyber-city-poster.webp`, Astro.site).href}
    />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdAll)} />
    <!-- [NX-W17 回城协议] 回城幕布的**首帧**部分（ArriveHead 同纪律：必须在 <head> 执行，抢在首绘前给
         <html> 挂类，否则跨文档接驳的白闪期幕布缺席、poster 先闪一下）。判定两路：
         ① URL ?poi=<id>&from=hall（HallChrome「返回科技城」链接）
         ② 无显式场景参数 + sessionStorage[world-return-v1]（浏览器后退/手势返回兜底，body 脚本读后即清）
         fx 由 buildings JSON arrivalFx 构建期内联（12 项小表），楼侧零代码接入。 -->
    <script is:inline define:vars={{ returnMap }}>
      (function () {
        try {
          var p = new URLSearchParams(location.search);
          var poi = null;
          if (p.get('from') === 'hall' && p.get('poi')) {
            poi = p.get('poi');
          } else if (!p.has('ritual') && !p.has('poi') && !p.has('city') && !p.has('robot')) {
            var raw = sessionStorage.getItem('world-return-v1');
            if (raw) {
              var snap = JSON.parse(raw);
              if (snap && typeof snap.poi === 'string') poi = snap.poi;
            }
          }
          if (!poi || !Object.prototype.hasOwnProperty.call(returnMap, poi)) return;
          var root = document.documentElement;
          root.classList.add('world-return');
          root.dataset.returnPoi = poi;
          root.dataset.returnFx = returnMap[poi].fx || 'fade';
          root.dataset.returnLabel = returnMap[poi].zh + ' · ' + returnMap[poi].en;
        } catch (e) { /* 判定失败 = 正常首幕 */ }
      })();
    </script>
    <style is:global>
      /* 首帧幕布：纯色满屏，0 计算首绘即在；body 内 [data-world-return] 就位后让位（同色无闪） */
      html.world-return::before {
        content: ''; position: fixed; inset: 0; z-index: 99; pointer-events: none; background: #05070d;
      }
      html.world-return[data-return-fx='ink']::before { background: #1c1f26; }
      html.world-return--dom::before { display: none; }
    </style>
  </head>
  <body>
    <!-- 跳过出口：DOM 首个可聚焦元素，第 0 秒可点（CITY-02 / Persona 2 猎头 30 秒路径） -->
    <a class="skip mono" data-world-skip href={`${base}/home/`}>跳过 3D，直达内容首页 →</a>

    <div class="world" data-world-host data-state="idle">
      <!-- 顶栏：六导航 <a>（挂载前后恒在，全键盘可达） -->
      <header class="topbar">
        <span class="brand mono" aria-hidden="true">W.L. · CYBER CITY</span>
        <nav class="nav mono" aria-label="全站导航">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <span class="backend mono" data-world-backend>—</span>
      </header>

      <div class="stage" data-lab-stage>
        <canvas
          class="canvas"
          data-world-canvas
          aria-label="智能座舱科技城：变形仪式后 W/A/S/D 或方向键驾驶 CarConcept，靠近大楼按 E 进站"
        ></canvas>

        <!-- 驾驶 HUD（DOM，挂载后可见；引擎经 data-ws-* 挂点接线，缺席容忍）。
             [CC-L2 A7] 霓虹面板化（1px 描边 + 8% 填色，设计提案 §5.2）；容器不再
             aria-hidden——改 visibility 门控（隐藏时不可聚焦、不进 AT），
             销 L0 观察 aria-hidden-focus（baseline §A.5-2） -->
        <div class="hud">
          <div class="hud-cell">
            <!-- [Tier-C T-2] 速度表装饰化：霓虹弧线随速点亮（SVG 220° 弧 + --speed-ratio 变量；
                 拦截态 .hud 为 visibility:hidden 对 VIS-01 基线零像素影响） -->
            <svg class="hud-arc" viewBox="0 0 96 96" aria-hidden="true">
              <circle class="hud-arc-track" cx="48" cy="48" r="42"></circle>
              <circle class="hud-arc-bar" cx="48" cy="48" r="42"></circle>
            </svg>
            <span class="hud-num" data-ws-speed>0</span>
            <span class="hud-unit">km/h</span>
          </div>
          <button class="hud-respawn" type="button" data-world-respawn>回到路口 (R)</button>
        </div>

        <!-- [CC-L2 A7] mini 楼宇快览：5 栋 hero 楼右下常驻（cover 淡出后世界内的
             「楼即产品线」DOM 面，真实 URL 直跳；销 A4 观察⑨「挂载后快览随 cover 消失」） -->
        <nav class="hud-city" aria-label="楼宇快览（5 栋 hero 楼）">
          <p class="hud-city-title mono">HERO TOWERS · 05</p>
          <ul>
            {
              heroTowers.map((b) => (
                <li>
                  <a href={b.href} style={`--neon: ${b.color};`}>
                    <i class="dot" aria-hidden="true" />
                    <span class="b-zh">{b.title}</span>
                    <span class="b-en mono">{b.en}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <p class="hint" data-ws-hint aria-hidden="true">
          W/A/S/D 或方向键驾驶 · Shift 加速 · Space/B 刹车 · R 回到路口 · 靠近大楼按 E 进站 · Esc 菜单
        </p>

        <!-- 静态壳覆盖层：poster（LCP）+ 定位语 + 三支柱 + 楼宇快览 + 显式进入（挂载前零 world 字节） -->
        <div class="cover" data-world-cover>
          <!-- [CC-L2 A10] poster 重拍（rubric §4 协议 B robot_idle 主帧，canvas 纯帧）：
               desktop 16:9 + mobile 9:16 竖版裁切（销 L0 观察「移动 poster 无构图」）；
               <picture> 按断点单选加载——预算口径两图皆入 G-A′ 壳静态段合计 -->
          <picture>
            <source
              media="(max-width: 767.98px)"
              srcset={`${base}/posters/cyber-city-poster-mobile.webp`}
              width="720"
              height="1280"
            />
            <img
              class="poster"
              data-world-poster
              src={`${base}/posters/cyber-city-poster.webp`}
              alt=""
              width="1280"
              height="720"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          <div class="scrim" aria-hidden="true"></div>

          <div class="intro">
            <p class="chip mono">CYBER CITY · FULL ENTRY</p>
            <h1>王磊｜汽车智能座舱与 AI 解决方案经理</h1>
            <p class="sub">
              把复杂技术转化为可决策、可交付、可复用的解决方案——这座科技城里的每栋楼，都是一条真实产品线。
            </p>
            <ul class="pillars mono" aria-label="能力三支柱">
              {pillars.map((p) => <li>{p}</li>)}
            </ul>

            <div class="actions">
              <button class="enter" type="button" data-world-enter>进入科技城</button>
              <p class="note" data-world-note>
                变形仪式 + WASD 驾驶 · WebGPU 优先，WebGL 2 自动回退 · 3D 资产点击后才加载
              </p>
            </div>
            <div class="progress" role="progressbar" aria-label="世界加载进度">
              <i data-world-progress-bar></i>
            </div>
            <p class="error" data-world-error hidden>
              3D 引擎初始化失败：当前浏览器可能不支持 WebGPU / WebGL 2。全部内容可经上方导航直达。
            </p>
            <noscript>
              <p class="error">
                本页 3D 体验需要 JavaScript；以下导航直达全部内容：
                {nav.map((item) => <a href={item.href}>{item.label}</a>)}
              </p>
            </noscript>
          </div>

          <!-- 楼宇快览：12 栋在册楼 = 全站导航的 DOM 面（挂载前可点，真实 URL） -->
          <nav class="city-nav" aria-label="楼宇快览（12 栋主题大楼）">
            <h2 class="city-nav-title mono">楼即产品线 · 12 栋在册</h2>
            <ul>
              {
                buildings.map((b) => (
                  <li>
                    <a href={b.href} style={`--neon: ${b.color};`}>
                      <i class="dot" aria-hidden="true" />
                      <span class="b-zh">{b.title}</span>
                      <span class="b-en mono">{b.en}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    <!-- [NX-W17 回城协议] 回城幕布「墨退霓虹」：从展厅回城时首帧即满屏（head 脚本挂 html.world-return），
         替代首访封面；车就位（host[data-world-state=car_ready]）后墨从车位收拢成一滴散去——
         正是进站「墨吞霓虹」的逆播。fx=ink 走墨拓色 + 三层墨团；其余楼 'fade' 走城市底色淡出。
         拦截态（save-data/reduced-motion/webgl）与 mount 失败：幕布让位，封面按钮/错误照常。 -->
    <div class="return" data-world-return aria-hidden="true">
      <p class="return-line mono"><span data-world-return-from></span> → CYBER CITY</p>
      <p class="return-sub">引擎待命 · 正在回到街上</p>
      <div class="return-progress"><i data-world-return-bar></i></div>
    </div>
    </div>

    <!-- ESC 菜单（SRD §12.7.8 出口④ / PRD CITY-09②，A4 硬条件 M11）：Escape 开合的
         最小 DOM 出口——原生 <dialog>（showModal = 焦点陷阱 + 背景 inert + Esc 原生可关），
         零框架零动画库；挂载前后均可用，链接为真实 URL（内容永不进 3D） -->
    <dialog class="esc-menu" data-world-esc-menu aria-label="ESC 菜单：快速出口">
      <p class="esc-title mono">ESC 菜单 · 快速出口</p>
      <nav class="esc-links" aria-label="快速出口">
        <a data-world-esc-work href={`${base}/work/`} autofocus>招聘方速览 → Work 案例索引</a>
        <a href={`${base}/home/`}>内容首页 → 纯 HTML 全站速览</a>
      </nav>
      <p class="esc-note">
        这座科技城是全站导航的 3D 形态：楼即产品线，靠近大楼按 E 进站；全部内容均有真实
        URL，不依赖 3D。再按 Esc 或点关闭可回到城市。
      </p>
      <button class="esc-close" type="button" data-world-esc-close>关闭（Esc）</button>
    </dialog>
  </body>
</html>

<script>
  // 引导脚本（≤15KB gzip 红线，实测 ~2KB）：只做条件判定 + 动态 import 触发。
  // world 分包与资产零静态标签——挂载前唯一网络开销 = 本脚本 + poster（G-A′）。
  import type { LabInstance } from '../lab/contracts';

  /** 深链参数白名单（M4/M6/M9 全部转正，SRD §12.7.8 出口⑧）：仅名单内参数经
   *  opts.params 透传给 mount，其余一律忽略且不回写 URL。
   *  gl=1 强制 WebGL 2 · vehicle=kinematic 运动学回退档 · city=1 灰盒挂城 ·
   *  robot=1 机器人演示 · ritual=1 首幕全流程 · quality=0|1|2 画质档（M9，
   *  引擎侧 Quality 不再兜底 location.search）· poi=<id> 楼宇深链（id=buildings JSON slug）·
   *  shot=<id> 镜头预设深链（CC-CAM-VIEW，仅与 poi 组合生效；id 白名单 = camera-shots.json 注册表） */
  const PARAM_ALLOWLIST = ['gl', 'vehicle', 'city', 'robot', 'ritual', 'quality', 'poi', 'shot', 'from'] as const;
  /** [NX-W17 回城协议] 续驶记忆键（HallChrome 合法到达时写，此处读后即清——浏览器后退/手势
   *  返回不带 from=hall 的兜底；与 world-arrival-v1（城→厅）方向相反） */
  const RETURN_KEY = 'world-return-v1';

  /** 自动挂载静置一拍（ms）：load 后给「秒点跳过」的访客让路——跳过路径
   *  全程零 world 字节（SRD §12.7.8 出口①，CITY-E2E-02 断言口径） */
  const AUTO_MOUNT_DELAY = 1800;

  const host = document.querySelector<HTMLElement>('[data-world-host]');
  if (host) {
    const enterBtn = host.querySelector<HTMLButtonElement>('[data-world-enter]');
    const progressBar = host.querySelector<HTMLElement>('[data-world-progress-bar]');
    const errorEl = host.querySelector<HTMLElement>('[data-world-error]');
    const backendEl = host.querySelector<HTMLElement>('[data-world-backend]');
    const noteEl = host.querySelector<HTMLElement>('[data-world-note]');
    const respawnBtn = host.querySelector<HTMLButtonElement>('[data-world-respawn]');
    let instance: LabInstance | null = null;
    let starting = false;

    const incoming = new URLSearchParams(location.search);
    const params = new URLSearchParams();
    for (const key of PARAM_ALLOWLIST) {
      const value = incoming.get(key);
      if (value !== null) params.set(key, value);
    }
    // 默认剧本 = 首幕变形仪式（终裁 D4）：显式场景参数（poi 深链 / city / robot
    // 灰盒验证参数）或显式 ritual 时让位，不叠加
    if (!params.has('ritual') && !params.has('poi') && !params.has('city') && !params.has('robot')) {
      // [NX-W17] head 内联脚本已按 sessionStorage 判定过续驶（html[data-return-poi]）：
      // 无显式场景参数时据此接上，一次性消费
      const remembered = document.documentElement.dataset.returnPoi;
      if (remembered) {
        params.set('poi', remembered);
        params.set('from', 'hall');
      } else {
        params.set('ritual', '1');
      }
    }
    try {
      sessionStorage.removeItem(RETURN_KEY);
    } catch {
      /* 无 storage = 无记忆可清 */
    }
    /** [NX-W17] 续驶：幕布接管封面、免 viewport 门、免 1.8s 让路拍 */
    const resume = params.get('from') === 'hall' && params.has('poi');
    const returnBar = host.querySelector<HTMLElement>('[data-world-return-bar]');
    if (resume) {
      document.documentElement.classList.add('world-return--dom');
      const fromEl = host.querySelector<HTMLElement>('[data-world-return-from]');
      if (fromEl) fromEl.textContent = document.documentElement.dataset.returnLabel ?? '';
    } else {
      document.documentElement.classList.remove('world-return');
    }

    const setState = (s: string) => {
      host.dataset.state = s;
    };

    const mount = async (): Promise<void> => {
      if (starting) return;
      starting = true;
      setState('loading');
      if (progressBar) progressBar.style.width = '4%';
      try {
        // 懒分包：确认进入后才拉取（G-A′ 恒硬两条之一）
        const { default: mountWorld } = await import('../lab/modules/world/index');
        instance = await mountWorld({
          host,
          mode: 'full',
          params,
          onProgress: (loaded, total) => {
            const pct = `${Math.round(4 + (loaded / Math.max(total, 1)) * 96)}%`;
            if (progressBar) progressBar.style.width = pct;
            if (returnBar) returnBar.style.width = pct;
          },
          onBackend: (backend) => {
            if (backendEl) backendEl.textContent = backend === 'webgpu' ? 'WebGPU' : 'WebGL 2';
          },
        });
        setState('ready');
      } catch (err) {
        console.error('[world] mount 失败：', err);
        setState('error');
        if (errorEl) errorEl.hidden = false;
      }
    };

    /** §4.3 四条件检查：返回 null = 可自动挂载，否则为拦截原因（记入 data-blocked） */
    const blockReason = (): string | null => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return 'reduced-motion';
      const conn = (navigator as { connection?: { saveData?: boolean } }).connection;
      if (conn?.saveData) return 'save-data';
      // [NX-W17] 续驶免 viewport 门：本机已付过 3D 成本且已选 3D，回城不再点第二次
      //（save-data / reduced-motion / webgl 三门不免——那是设备与偏好，不是首访礼节）
      if (window.innerWidth < 768 && !resume) return 'viewport';
      if (!('gpu' in navigator)) {
        const probe = document.createElement('canvas');
        if (!probe.getContext('webgl2')) return 'webgl';
      }
      return null;
    };

    const BLOCK_NOTES: Record<string, string> = {
      'reduced-motion': '检测到系统减少动态偏好：不自动加载 3D。点击「进入科技城」为终态直出（无动画序列）。',
      'save-data': '检测到省流量模式：不自动加载 3D（约 5.5MB）。点击「进入科技城」可显式进入。',
      viewport: '窄屏设备默认不自动加载 3D。点击「进入科技城」可显式进入（触屏为虚拟摇杆）。',
      webgl: '当前浏览器不支持 WebGPU / WebGL 2，无法进入 3D。全部内容可经导航直达。',
    };

    // 显式进入：跳过条件拦截（reduced-motion 由引擎侧终态直出，§12.4 语义沿用）
    enterBtn?.addEventListener('click', () => {
      void mount();
    });

    // 条件自动挂载：window.load 后评估（关键路径已清空，实施方案 §4.3）
    const evaluate = () => {
      const reason = blockReason();
      if (reason) {
        host.dataset.blocked = reason;
        if (noteEl && BLOCK_NOTES[reason]) noteEl.textContent = BLOCK_NOTES[reason];
        return;
      }
      // [NX-W17] 续驶不留 1.8s 让路拍——从楼里出来的人已经选择进城
      window.setTimeout(() => void mount(), resume ? 0 : AUTO_MOUNT_DELAY);
    };
    if (document.readyState === 'complete') evaluate();
    else window.addEventListener('load', evaluate, { once: true });

    // 复位按钮（触屏）：复用键盘 R 语义（down+up 成对，Inputs toggle 语义）
    respawnBtn?.addEventListener('click', () => {
      window.dispatchEvent(new KeyboardEvent('keydown', { code: 'KeyR', key: 'r' }));
      window.dispatchEvent(new KeyboardEvent('keyup', { code: 'KeyR', key: 'r' }));
    });

    // 生命周期（SRD §9.2 契约）：标签页隐藏暂停 RAF；离页释放 GPU
    document.addEventListener('visibilitychange', () => {
      if (!instance) return;
      if (document.visibilityState === 'hidden') instance.pause();
      else instance.resume();
    });
    window.addEventListener('pagehide', (e) => {
      if (!e.persisted && instance) {
        instance.dispose();
        instance = null;
      }
    });
  }

  // ESC 菜单（SRD §12.7.8 出口④ / PRD CITY-09②，A4 M11）：Escape 开合。
  // showModal 自带焦点陷阱 + 背景 inert（键盘/读屏可达）；关闭后焦点自动还原
  // 触发前元素。preventDefault 必须：不吞则同一次按键的原生 close request
  // （close watcher，keydown cancel + keyup close）会把刚 showModal 的菜单立即关回。
  const escMenu = document.querySelector<HTMLDialogElement>('[data-world-esc-menu]');
  if (escMenu) {
    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || e.repeat) return;
      e.preventDefault();
      if (escMenu.open) {
        escMenu.close();
      } else {
        escMenu.showModal();
        // [CC-OBS-C1] 壳桥埋点（观测规格 §3.5）：壳零 import world——SessionTimeline
        // 监听 world-obs（仅放行 ux/error 族）；world 未挂载时无人监听自然丢失（可接受）
        window.dispatchEvent(new CustomEvent('world-obs', { detail: { type: 'esc-menu-open' } }));
      }
    });
    escMenu
      .querySelector('[data-world-esc-close]')
      ?.addEventListener('click', () => escMenu.close());
  }
</script>

<style>
