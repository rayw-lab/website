---
// /work/{slug}/ —— 案例详情（master-plan §2.3）。
// MDX 正文经 CaseLayout 渲染；白名单组件（SRD §9.1）经 components 映射注入，
// 内容作者无需逐篇 import；draft 条目不出静态路径（schema 守则 2）。
import { getCollection, render } from 'astro:content';
import CaseLayout from '../../layouts/CaseLayout.astro';
import EvidenceTag from '../../components/content/EvidenceTag.astro';
import CompareBlock from '../../components/content/CompareBlock.astro';
import StageBadge from '../../components/content/StageBadge.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).filter((e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<CaseLayout entry={entry} headings={headings}>
  <Content components={{ EvidenceTag, CompareBlock, StageBadge }} />
</CaseLayout>
