---
// LAB RA-01：多语言 TTS × 智能座舱可视化（路线A MVP，见 docs/research/tts-cockpit-visualization.md）
import manifest from '../../data/tts-manifest.json';

const title = '多语言 TTS × 智能座舱可视化 — LAB · 王磊';
const description =
  '16 个语种的座舱语音播报对照演示：词级时间戳驱动字幕逐词点亮、SVG 路线推进与真实频谱波形（离线预生成，零第三方请求）。';

const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

// Noto 子集（可变字重，unicode-range 命中才会下载）
const fontFaces = [
  {
    family: 'Noto Sans Arabic',
    file: 'noto-sans-arabic-var.woff2',
    range:
      'U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC',
  },
  {
    family: 'Noto Sans Hebrew',
    file: 'noto-sans-hebrew-var.woff2',
    range: 'U+0307-0308, U+0590-05FF, U+200C-2010, U+20AA, U+25CC, U+FB1D-FB4F',
  },
  {
    family: 'Noto Sans Thai',
    file: 'noto-sans-thai-var.woff2',
    range: 'U+02D7, U+0303, U+0331, U+0E01-0E5B, U+200C-200D, U+25CC',
  },
  {
    family: 'Noto Sans Devanagari',
    file: 'noto-sans-devanagari-var.woff2',
    range:
      'U+0900-097F, U+1CD0-1CF9, U+20A8, U+20B9, U+20F0, U+25CC, U+A830-A839, U+A8E0-A8FF, U+11B00-11B09',
  },
];
const fontCss = fontFaces
  .map(
    (f) => `@font-face{font-family:'${f.family}';font-style:normal;font-weight:400 700;` +
      `font-display:swap;src:url('${BASE}fonts/${f.file}') format('woff2');unicode-range:${f.range};}`
  )
  .join('\n');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global set:html={fontCss}></style>
  </head>
  <body class="ttsc">
    <div class="wrap">
      <!-- ============ 页眉 ============ -->
      <header class="masthead">
        <div class="rule-row">
          <a class="home-link mono" href={BASE}>← rayw-lab</a>
          <span class="mono page-code">LAB / RA-01 · TTS-COCKPIT · v0.1</span>
        </div>
        <p class="kicker mono">INTERACTIVE DEMO · 旗舰案例 A 切片</p>
        <h1>多语言 TTS × 智能座舱可视化</h1>
        <p class="lede">
          同一组座舱语音指令，在 <b>16 个语种</b>下的可听、可看对照——词级时间戳驱动字幕逐词点亮、
          SVG 路线随播报推进、Canvas 波形来自真实音频频谱。「多语种不是翻译一遍」：切换语言，
          听节奏差异，看 RTL 布局镜像与字宽变化。
        </p>
        <ul class="specs mono">
          <li>16 LOCALES × 5 SCENES</li>
          <li>词级时间戳同步</li>
          <li>RTL ×2（ar · he）</li>
          <li>离线预生成 · 零第三方请求</li>
          <li>无 API KEY</li>
        </ul>
        <p class="disclaimer">
          <b>免责声明</b>——本页为个人技术演示：语料系参考公开报道的智能座舱语音交互范式（如理想汽车
          OTA 8.0「理想同学 / Livis」相关公开信息<a href="#fn" class="fn-ref">¹</a>）改编的<b>虚构示例</b>，
          非任何厂商官方产品或话术；目的地均为公开地标或虚构组合；座舱界面为 100% 原创抽象设计；
          合成引擎为开源 eSpeak NG，与作者参与的任何量产项目的供应商选择无关。
        </p>
      </header>

      <!-- ============ 演示主体 ============ -->
      <main class="demo">
        <!-- 控制区 -->
        <aside class="controls">
          <section class="ctl">
            <h2 class="ctl-h"><span class="mono">01</span>语言 · Locale</h2>
            <div class="locale-grid" id="locale-grid">
              {
                manifest.locales.map((l) => (
                  <button
                    type="button"
                    class="locale-btn"
                    data-locale={l.code}
                    data-dir={l.dir}
                    aria-pressed={l.code === 'zh-CN' ? 'true' : 'false'}
                    title={l.name}
                  >
                    <b dir={l.dir}>{l.nativeName}</b>
                    <span class="mono">
                      {l.code}
                      {l.dir === 'rtl' && <i class="rtl-tag">RTL</i>}
                    </span>
                  </button>
                ))
              }
            </div>
          </section>

          <section class="ctl">
            <h2 class="ctl-h"><span class="mono">02</span>指令场景 · Scene</h2>
            <div class="scene-list" id="scene-list">
              {
                manifest.scenes.map((s) => (
                  <button
                    type="button"
                    class="scene-btn"
                    data-scene={s.id}
                    aria-pressed={s.id === 'nav' ? 'true' : 'false'}
                  >
                    <span class="scene-row">
                      <b>{s.label}</b>
                      <span class="mono tag">{s.tag}</span>
                    </span>
                    <span class="cmd">「{s.user['zh-CN']}」</span>
                  </button>
                ))
              }
            </div>
          </section>

          <section class="ctl">
            <h2 class="ctl-h"><span class="mono">03</span>播放 · Playback</h2>
            <button type="button" id="play-btn" class="play-btn mono">▶&nbsp;播放播报</button>
            <div class="progress"><div id="progress-fill"></div></div>
            <p id="status-line" class="status mono">待机 · 选择语言与场景后播放</p>

            <dl class="stats mono" id="stats" hidden>
              <div><dt>字符数</dt><dd id="stat-chars">–</dd></div>
              <div><dt>播报时长</dt><dd id="stat-dur">–</dd></div>
              <div><dt>平均语速</dt><dd id="stat-rate">–</dd></div>
              <div><dt>词界 token</dt><dd id="stat-words">–</dd></div>
            </dl>
            <p class="engine-note">
              引擎：eSpeak NG · 构建期离线预生成（mp3 + timeline.json）。音色为共振峰合成、机械感明显——
              本初版验证「时间戳驱动音画联动」管线，音质升级路径见页脚<a href="#fn" class="fn-ref">⁵</a>。
            </p>
          </section>
        </aside>

        <!-- 座舱可视化区 -->
        <section class="stage">
          <div class="screen" id="screen" data-state="idle" data-scene="nav" data-dir="ltr">
            <!-- 状态栏 -->
            <div class="hmi-status mono">
              <span class="hmi-brand">COCKPIT HMI · LAB DEMO</span>
              <span class="hmi-scene" id="hmi-scene-tag">NAV / ROUTE</span>
              <span class="hmi-right">
                <span id="hmi-locale" class="hmi-badge">zh-CN</span>
                <span id="hmi-dir" class="hmi-badge">LTR</span>
                <i class="led" aria-hidden="true"></i>
                <span id="hmi-state">IDLE</span>
              </span>
            </div>

            <div class="hmi-body">
              <!-- 仪表簇 -->
              <div class="cluster">
                <svg viewBox="0 0 200 150" class="gauge" aria-hidden="true">
                  <path class="gauge-arc" d="M 32.5 144 A 78 78 0 1 1 167.5 144" pathLength="100" />
                  <path
                    class="gauge-arc-fill"
                    id="gauge-fill"
                    d="M 32.5 144 A 78 78 0 1 1 167.5 144"
                    pathLength="100"
                  />
                  <g id="gauge-ticks"></g>
                  <g id="needle">
                    <line x1="100" y1="105" x2="100" y2="38" />
                  </g>
                  <circle cx="100" cy="105" r="5" class="hub" />
                  <text id="speed-num" x="100" y="128" text-anchor="middle" class="mono">0</text>
                  <text x="100" y="142" text-anchor="middle" class="gauge-unit mono">km/h</text>
                </svg>
                <div class="drive-row mono"><span>D</span><span>ODO 12 806 km</span><span>23°C</span></div>
                <div class="orb-box">
                  <span class="orb" id="orb" aria-hidden="true"></span>
                  <span class="orb-label mono" id="orb-label">VOICE IDLE</span>
                </div>
              </div>

              <!-- 中控 -->
              <div class="console" id="console">
                <div class="cardstage">
                  <!-- 场景 1：单点导航 -->
                  <div class="scene-card card-nav" id="card-nav">
                    <svg viewBox="0 0 520 240" preserveAspectRatio="xMidYMid meet">
                      <g class="citygrid">
                        <path d="M0 40H520M0 80H520M0 120H520M0 160H520M0 200H520M60 0V240M160 0V240M260 0V240M360 0V240M460 0V240" />
                      </g>
                      <g class="blocks">
                        <rect x="42" y="48" width="100" height="60" rx="6" />
                        <rect x="182" y="140" width="96" height="48" rx="6" />
                        <rect x="330" y="150" width="120" height="42" rx="6" />
                        <rect x="336" y="96" width="76" height="34" rx="6" />
                        <rect x="196" y="34" width="86" height="60" rx="6" />
                      </g>
                      <path
                        class="route-base"
                        d="M 60 196 H 150 Q 160 196 160 186 V 130 Q 160 120 170 120 H 296 Q 306 120 306 110 V 78 Q 306 68 316 68 H 452"
                      />
                      <path
                        class="route-live"
                        id="nav-route"
                        pathLength="100"
                        d="M 60 196 H 150 Q 160 196 160 186 V 130 Q 160 120 170 120 H 296 Q 306 120 306 110 V 78 Q 306 68 316 68 H 452"
                      />
                      <circle class="node-start" cx="60" cy="196" r="6" />
                      <g class="dest" id="nav-dest">
                        <circle cx="452" cy="68" r="7" class="dest-dot" />
                        <circle cx="452" cy="68" r="13" class="dest-ring" />
                        <text x="452" y="46" text-anchor="middle" class="map-label">五道口</text>
                      </g>
                      <circle class="car-dot" id="nav-car" r="6" cx="60" cy="196" />
                      <text x="60" y="220" text-anchor="middle" class="map-label dim mono">START</text>
                    </svg>
                    <span class="chip mono" id="nav-chip-dist" style="left:38%;top:34%">≈ 12 km</span>
                    <span class="chip mono" id="nav-chip-eta" style="right:4%;top:64%">ETA 28 min</span>
                  </div>

                  <!-- 场景 2：多途经点 -->
                  <div class="scene-card card-tour" id="card-tour">
                    <svg viewBox="0 0 520 240" preserveAspectRatio="xMidYMid meet">
                      <g class="citygrid">
                        <path d="M0 40H520M0 80H520M0 120H520M0 160H520M0 200H520M60 0V240M160 0V240M260 0V240M360 0V240M460 0V240" />
                      </g>
                      <g class="blocks">
                        <rect x="46" y="60" width="70" height="70" rx="6" />
                        <rect x="176" y="180" width="110" height="34" rx="6" />
                        <rect x="300" y="140" width="90" height="46" rx="6" />
                        <rect x="410" y="110" width="72" height="60" rx="6" />
                        <rect x="210" y="30" width="90" height="40" rx="6" />
                      </g>
                      <path
                        class="route-base"
                        d="M 48 200 H 130 Q 140 200 140 190 V 160 Q 140 150 150 150 H 240 Q 250 150 250 140 V 108 Q 250 98 260 98 H 350 Q 360 98 360 88 V 66 Q 360 56 370 56 H 452"
                      />
                      <path
                        class="route-live"
                        id="tour-route"
                        pathLength="100"
                        d="M 48 200 H 130 Q 140 200 140 190 V 160 Q 140 150 150 150 H 240 Q 250 150 250 140 V 108 Q 250 98 260 98 H 350 Q 360 98 360 88 V 66 Q 360 56 370 56 H 452"
                      />
                      <circle class="node-start" cx="48" cy="200" r="6" />
                      <g class="tour-node" data-wp="1" data-x="150" data-y="150">
                        <circle cx="150" cy="150" r="9" class="wp-dot" />
                        <text x="150" y="154" text-anchor="middle" class="wp-num mono">1</text>
                        <text x="150" y="172" text-anchor="middle" class="map-label">国家大剧院</text>
                      </g>
                      <g class="tour-node" data-wp="2" data-x="260" data-y="98">
                        <circle cx="260" cy="98" r="9" class="wp-dot" />
                        <text x="260" y="102" text-anchor="middle" class="wp-num mono">2</text>
                        <text x="260" y="128" text-anchor="middle" class="map-label">故宫</text>
                      </g>
                      <g class="tour-node" data-wp="3" data-x="452" data-y="56">
                        <circle cx="452" cy="56" r="9" class="wp-dot" />
                        <text x="452" y="60" text-anchor="middle" class="wp-num mono">3</text>
                        <text x="452" y="38" text-anchor="middle" class="map-label">颐和园</text>
                      </g>
                      <circle class="car-dot" id="tour-car" r="6" cx="48" cy="200" />
                    </svg>
                    <span class="chip mono" id="tour-chip" style="left:4%;top:12%">TOTAL ≈ 24 km</span>
                  </div>

                  <!-- 场景 3：车道偏好 -->
                  <div class="scene-card card-lane" id="card-lane">
                    <svg viewBox="0 0 520 240" preserveAspectRatio="xMidYMid meet">
                      <rect x="130" y="0" width="260" height="240" class="road" />
                      <rect x="132" y="0" width="86" height="240" class="lane-hl" id="lane-left-hl" />
                      <line x1="131" y1="0" x2="131" y2="240" class="road-edge" />
                      <line x1="389" y1="0" x2="389" y2="240" class="road-edge" />
                      <line x1="217" y1="0" x2="217" y2="240" class="lane-dash" />
                      <line x1="303" y1="0" x2="303" y2="240" class="lane-dash" />
                      <line x1="0" y1="0" x2="520" y2="0" class="scanline" id="lane-scanline" />
                      <path d="M 175 34 v 26 m 0 -26 l -9 13 m 9 -13 l 9 13" class="lane-arrow" id="lane-arrow" />
                      <text x="175" y="228" text-anchor="middle" class="map-label mono lane-num">L1</text>
                      <text x="260" y="228" text-anchor="middle" class="map-label mono lane-num">L2</text>
                      <text x="347" y="228" text-anchor="middle" class="map-label mono lane-num">L3</text>
                      <g id="lane-car" class="lane-car" style="transform: translate(260px, 170px)">
                        <rect x="-16" y="-30" width="32" height="60" rx="10" />
                        <path d="M -10 -12 Q 0 -20 10 -12 M -10 14 H 10" />
                      </g>
                    </svg>
                    <span class="chip mono" id="lane-chip" style="left:4%;top:10%">LANE PREF · L1 SAVED</span>
                  </div>

                  <!-- 场景 4：地库泊车 -->
                  <div class="scene-card card-park" id="card-park">
                    <svg viewBox="0 0 520 240" preserveAspectRatio="xMidYMid meet">
                      <line x1="24" y1="40" x2="150" y2="40" class="ground" />
                      <text x="26" y="30" class="map-label dim mono">ENTRY</text>
                      <g class="levels">
                        <rect x="250" y="86" width="230" height="36" rx="5" class="lvl" />
                        <rect x="250" y="134" width="230" height="36" rx="5" class="lvl" id="park-b2" />
                        <rect x="250" y="182" width="230" height="36" rx="5" class="lvl" />
                        <text x="238" y="109" text-anchor="end" class="map-label mono">B1</text>
                        <text x="238" y="157" text-anchor="end" class="map-label mono">B2</text>
                        <text x="238" y="205" text-anchor="end" class="map-label mono">B3</text>
                      </g>
                      <path
                        class="route-base"
                        d="M 56 40 H 138 Q 152 40 158 52 L 190 104 Q 196 116 210 116 H 228 Q 242 116 248 128 L 262 148 Q 268 152 276 152 H 430"
                      />
                      <path
                        class="route-live"
                        id="park-path"
                        pathLength="100"
                        d="M 56 40 H 138 Q 152 40 158 52 L 190 104 Q 196 116 210 116 H 228 Q 242 116 248 128 L 262 148 Q 268 152 276 152 H 430"
                      />
                      <rect x="408" y="138" width="46" height="28" rx="4" class="slot" id="park-slot" />
                      <circle class="car-dot" id="park-car" r="6" cx="56" cy="40" />
                    </svg>
                    <span class="chip mono" id="park-chip-found" style="right:4%;top:44%">B2 · SLOT 042</span>
                    <span class="chip mono" id="park-chip-go" style="left:4%;top:10%">AVP ACTIVE</span>
                  </div>

                  <!-- 场景 5：出行参谋（天气） -->
                  <div class="scene-card card-weather" id="card-weather">
                    <div class="wx">
                      <div class="wx-head">
                        <b>哈尔滨</b><span class="mono">HARBIN · TOMORROW</span>
                      </div>
                      <div class="wx-main">
                        <span class="wx-temp mono" id="wx-temp">0°</span>
                        <svg viewBox="0 0 48 48" class="wx-icon" id="wx-icon" aria-hidden="true">
                          <g>
                            <path d="M24 6v36M8.4 15v18l31.2 0v-18zM8.4 33 24 24 8.4 15M39.6 33 24 24l15.6-9" class="flake-x" />
                            <path d="M24 6 24 42 M10 12 38 36 M38 12 10 36" />
                            <path d="M24 6l-4 5h8zM24 42l-4-5h8zM10 12l1 6 5-3zM38 36l-1-6-5 3zM38 12l-6 1 3 5zM10 36l6-1-3-5z" class="flake-tip" />
                          </g>
                        </svg>
                        <div class="wx-cond">
                          <b id="wx-cond-zh">小雪</b>
                          <span class="mono">LIGHT SNOW · WIND 3</span>
                        </div>
                      </div>
                      <div class="wx-chips">
                        <span class="wx-chip" id="wx-chip-jacket">羽绒服 <i class="mono">DOWN JACKET</i></span>
                        <span class="wx-chip" id="wx-chip-hat">帽子 <i class="mono">HAT</i></span>
                        <span class="wx-chip" id="wx-chip-gloves">手套 <i class="mono">GLOVES</i></span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- 对话区 -->
                <div class="dialog">
                  <div class="u-line" id="user-line">
                    <span class="who mono">USER</span>
                    <p class="u-text" id="user-text"></p>
                  </div>
                  <div class="a-line">
                    <span class="who who-a mono">ASSISTANT</span>
                    <p class="caption" id="caption"><span class="cap-placeholder">— 选择语言与场景，点击「播放播报」 —</span></p>
                  </div>
                </div>

                <!-- 波形区 -->
                <div class="wave-row">
                  <canvas id="wave" width="640" height="64" aria-hidden="true"></canvas>
                  <span class="mono clock" id="clock">00.0 / 00.0 s</span>
                </div>
              </div>
            </div>
          </div>
          <p class="stage-note">
            座舱界面与城市路网均为原创抽象设计（虚构城市），不对应任何真实量产 HMI 或真实地图。
            波形来自 Web Audio AnalyserNode 实时频谱（不可用时回退到预计算峰值，仍与播放时钟同步）。
          </p>
        </section>
      </main>

      <!-- ============ 页脚脚注 ============ -->
      <footer class="foot" id="fn">
        <h2 class="ctl-h"><span class="mono">FN</span>语料来源与技术说明</h2>
        <ol class="fnotes">
          <li>
            交互范式参考：理想汽车 OTA 8.0「理想同学 / Livis」及 Livis Day 2026 相关<b>公开媒体报道</b>。
            本页语料为据此改编的虚构演示文案，非官方文案；场景目的地（五道口、国家大剧院、故宫、颐和园、哈尔滨）
            为公开地标组合，与任何真实项目无关。
          </li>
          <li>
            合成引擎：<a href="https://github.com/espeak-ng/espeak-ng" rel="noopener">eSpeak NG</a> 1.51
            （GPLv3 开源共振峰引擎，本地构建期预生成，仓库与站点不含任何 API Key）。
            词级时间戳来自其 WORD 边界事件；分段动作时间点由语料分段字符偏移在事件锚点间插值得到
            （等价于调研文档中 Azure WordBoundary + SSML bookmark 的离线替代）。
          </li>
          <li>
            多语种文案为双引擎交叉思路下的演示翻译，<b>非量产话术</b>；泰语、希伯来语的数字按该语种引擎能力
            改写为文字数词（希伯来语车库层级采用当地惯用的「负二层」表述）。
          </li>
          <li>
            字体：<a href="https://fonts.google.com/noto" rel="noopener">Noto Sans</a> Arabic / Hebrew / Thai /
            Devanagari 子集（SIL OFL 1.1，自托管、按 unicode-range 懒加载）；中文与韩文使用系统字体。
          </li>
          <li>
            技术选型与完整版路线：见站内调研 <code>docs/research/tts-cockpit-visualization.md</code>。
            升级路径——Azure Speech 预生成（150+ locale、WordBoundary/bookmark、Multilingual 音色对照）、
            Rive 状态机动效、MapLibre + deck.gl 真实路线动画。
          </li>
          <li>
            本页零第三方运行时请求：音频、时间轴、字体全部同源托管；无 Cookie、无统计脚本。
            动效遵循 <code>prefers-reduced-motion</code>。
          </li>
        </ol>
        <p class="mono foot-code">RA-01 · BUILD: ESPEAK-NG OFFLINE PIPELINE · 80 CLIPS / 16 LOCALES / 5 SCENES</p>
      </footer>
    </div>

    <script>
      import '../../components/demo/tts-cockpit/main';
    </script>

    <style is:global>
      /* ================= 设计令牌（技术编辑部 × 工业仪表） ================= */
      .ttsc {
        --paper: #f5f4ef;
        --paper-2: #eceade;
        --ink: #1c1d1f;
        --ink-2: #595b60;
        --hairline: #d8d5c9;
        --accent: #cf4a17;
        --accent-soft: #cf4a1722;
        --scr-bg: #11151b;
        --scr-panel: #171d26;
        --scr-line: #2a3342;
        --scr-line-2: #202836;
        --scr-text: #dfe6ee;
        --scr-dim: #7f8b9c;
        --scr-accent: #ff8a4b;
        --scr-good: #59c99a;
        --mono: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, 'Liberation Mono', monospace;
        --sans: 'Noto Sans Arabic', 'Noto Sans Hebrew', 'Noto Sans Thai', 'Noto Sans Devanagari',
          -apple-system, 'Segoe UI', Roboto, 'PingFang SC', 'Source Han Sans SC', 'Noto Sans SC',
          'Microsoft YaHei', sans-serif;
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      .ttsc .mono { font-family: var(--mono); }
      .ttsc .wrap { max-width: 1200px; margin-inline: auto; padding: 0 24px 64px; }
      .ttsc a { color: inherit; }

      /* ================= 页眉 ================= */
      .masthead { padding-top: 18px; }
      .rule-row {
        display: flex; justify-content: space-between; align-items: baseline;
        border-top: 3px solid var(--ink); padding-top: 8px; font-size: 12px;
      }
      .home-link { text-decoration: none; color: var(--ink-2); letter-spacing: 0.04em; }
      .home-link:hover { color: var(--accent); }
      .page-code { color: var(--ink-2); letter-spacing: 0.08em; }
      .kicker { margin: 26px 0 4px; font-size: 12px; letter-spacing: 0.22em; color: var(--accent); }
      .masthead h1 { margin: 0 0 10px; font-size: clamp(26px, 4.2vw, 42px); line-height: 1.2; letter-spacing: 0.01em; }
      .lede { max-width: 62ch; margin: 0 0 16px; color: var(--ink-2); font-size: 15.5px; }
      .lede b { color: var(--ink); }
      .specs { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0 0 18px; padding: 0; font-size: 11px; }
      .specs li { border: 1px solid var(--hairline); background: #fff8; padding: 3px 10px; border-radius: 3px; letter-spacing: 0.06em; color: var(--ink-2); }
      .disclaimer {
        max-width: 86ch; margin: 0; padding: 10px 14px; font-size: 12.5px; color: var(--ink-2);
        border-inline-start: 3px solid var(--accent); background: #fff6; border-radius: 0 4px 4px 0;
      }
      .fn-ref { text-decoration: none; color: var(--accent); }

      /* ================= 主布局 ================= */
      .demo { display: grid; grid-template-columns: 330px minmax(0, 1fr); gap: 22px; margin-top: 26px; }
      @media (max-width: 940px) { .demo { grid-template-columns: 1fr; } }

      /* ================= 控制区 ================= */
      .ctl { border-top: 1px solid var(--ink); padding-top: 10px; margin-bottom: 22px; }
      .ctl-h { display: flex; gap: 10px; align-items: baseline; margin: 0 0 10px; font-size: 13.5px; letter-spacing: 0.05em; }
      .ctl-h .mono { color: var(--accent); font-size: 11px; }

      .locale-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
      .locale-btn {
        display: flex; justify-content: space-between; align-items: center; gap: 6px;
        border: 1px solid var(--hairline); background: #fffdf7; border-radius: 4px;
        padding: 7px 9px; font: inherit; cursor: pointer; text-align: start; transition: border-color 0.15s, background 0.15s;
      }
      .locale-btn:hover { border-color: var(--ink-2); }
      .locale-btn b { font-size: 13px; font-weight: 600; }
      .locale-btn > .mono { font-size: 10px; color: var(--ink-2); display: inline-flex; gap: 4px; align-items: center; }
      .rtl-tag { font-style: normal; border: 1px solid var(--accent); color: var(--accent); border-radius: 2px; padding: 0 3px; font-size: 9px; }
      .locale-btn[aria-pressed='true'] { border-color: var(--accent); background: var(--accent-soft); box-shadow: inset 3px 0 0 var(--accent); }

      .scene-list { display: grid; gap: 6px; }
      .scene-btn {
        border: 1px solid var(--hairline); background: #fffdf7; border-radius: 4px; padding: 8px 10px;
        font: inherit; cursor: pointer; text-align: start; display: grid; gap: 2px; transition: border-color 0.15s, background 0.15s;
      }
      .scene-btn:hover { border-color: var(--ink-2); }
      .scene-btn[aria-pressed='true'] { border-color: var(--accent); background: var(--accent-soft); box-shadow: inset 3px 0 0 var(--accent); }
      .scene-row { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
      .scene-btn b { font-size: 13.5px; }
      .scene-btn .tag { font-size: 9.5px; color: var(--ink-2); letter-spacing: 0.08em; }
      .scene-btn .cmd { font-size: 12px; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

      .play-btn {
        width: 100%; padding: 11px 14px; font-size: 14px; letter-spacing: 0.12em; cursor: pointer;
        border: 1.5px solid var(--ink); background: var(--ink); color: var(--paper); border-radius: 4px;
        transition: background 0.15s, color 0.15s;
      }
      .play-btn:hover { background: var(--accent); border-color: var(--accent); }
      .play-btn[data-playing='true'] { background: var(--paper); color: var(--accent); border-color: var(--accent); }
      .progress { height: 3px; background: var(--hairline); border-radius: 2px; margin: 12px 0 8px; overflow: hidden; }
      #progress-fill { height: 100%; width: 0%; background: var(--accent); }
      .status { margin: 0; font-size: 11px; color: var(--ink-2); letter-spacing: 0.03em; min-height: 2.4em; }
      .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 12px 0 0; }
      .stats > div { border: 1px solid var(--hairline); border-radius: 3px; padding: 6px 8px; background: #fff8; }
      .stats dt { font-size: 10px; color: var(--ink-2); letter-spacing: 0.06em; }
      .stats dd { margin: 0; font-size: 15px; }
      .engine-note { font-size: 11.5px; color: var(--ink-2); margin: 12px 0 0; }

      /* ================= 座舱屏 ================= */
      .stage { min-width: 0; }
      .screen {
        background: var(--scr-bg); border-radius: 14px; border: 1px solid #0a0d11;
        box-shadow: 0 1px 0 #ffffff70 inset, 0 14px 34px -18px #1c1d1f66;
        overflow: hidden; color: var(--scr-text);
      }
      .hmi-status {
        display: flex; justify-content: space-between; align-items: center; gap: 10px;
        font-size: 10px; letter-spacing: 0.1em; color: var(--scr-dim);
        padding: 8px 14px; border-bottom: 1px solid var(--scr-line-2);
      }
      .hmi-brand { color: var(--scr-dim); }
      .hmi-scene { color: var(--scr-accent); }
      .hmi-right { display: inline-flex; align-items: center; gap: 8px; }
      .hmi-badge { border: 1px solid var(--scr-line); border-radius: 3px; padding: 1px 6px; color: var(--scr-text); }
      .led { width: 7px; height: 7px; border-radius: 50%; background: var(--scr-dim); transition: background 0.2s; }
      .screen[data-state='speaking'] .led { background: var(--scr-accent); box-shadow: 0 0 6px var(--scr-accent); }
      .screen[data-state='loading'] .led { background: #d9c04a; }
      .screen[data-state='done'] .led { background: var(--scr-good); }
      .screen[data-state='error'] .led { background: #e05656; }

      .hmi-body { display: grid; grid-template-columns: 212px minmax(0, 1fr); }
      @media (max-width: 640px) { .hmi-body { grid-template-columns: 1fr; } .cluster { display: none; } }

      /* ---- 仪表簇 ---- */
      .cluster { border-inline-end: 1px solid var(--scr-line-2); padding: 14px 12px 10px; display: grid; gap: 8px; align-content: start; }
      .gauge { width: 100%; }
      .gauge-arc { fill: none; stroke: var(--scr-line); stroke-width: 3; stroke-linecap: round; }
      .gauge-arc-fill {
        fill: none; stroke: var(--scr-accent); stroke-width: 3; stroke-linecap: round;
        stroke-dasharray: 100; stroke-dashoffset: 100; opacity: 0.9;
      }
      #gauge-ticks line { stroke: var(--scr-dim); stroke-width: 1.4; }
      #gauge-ticks text { fill: var(--scr-dim); font-size: 8px; font-family: var(--mono); }
      #needle line { stroke: var(--scr-text); stroke-width: 2.4; stroke-linecap: round; }
      #needle { transform-origin: 100px 105px; transition: transform 80ms linear; }
      .hub { fill: var(--scr-accent); }
      #speed-num { fill: var(--scr-text); font-size: 26px; font-weight: 600; }
      .gauge-unit { fill: var(--scr-dim); font-size: 9px; letter-spacing: 0.1em; }
      .drive-row { display: flex; justify-content: space-between; color: var(--scr-dim); font-size: 9.5px; letter-spacing: 0.08em; border-top: 1px solid var(--scr-line-2); padding-top: 8px; }
      .orb-box { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
      .orb {
        width: 14px; height: 14px; border-radius: 50%;
        background: radial-gradient(circle at 35% 35%, var(--scr-accent), #b4470f);
        transform: scale(var(--rms, 0.7)); transition: transform 60ms linear; opacity: 0.55;
      }
      .screen[data-state='speaking'] .orb { opacity: 1; }
      .orb-label { font-size: 9px; color: var(--scr-dim); letter-spacing: 0.14em; }

      /* ---- 中控 ---- */
      .console { display: grid; grid-template-rows: minmax(190px, 1fr) auto auto; min-width: 0; }
      .cardstage { position: relative; margin: 12px 14px 0; border: 1px solid var(--scr-line-2); border-radius: 10px; background: var(--scr-panel); overflow: hidden; min-height: 200px; }
      .scene-card { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity 0.25s; padding: 6px; }
      .scene-card svg { width: 100%; height: 100%; display: block; }
      .screen[data-scene='nav'] .card-nav,
      .screen[data-scene='tour'] .card-tour,
      .screen[data-scene='lane'] .card-lane,
      .screen[data-scene='park'] .card-park,
      .screen[data-scene='travel'] .card-weather { opacity: 1; pointer-events: auto; }

      .citygrid path { stroke: var(--scr-line-2); stroke-width: 1; opacity: 0.5; }
      .blocks rect { fill: none; stroke: var(--scr-line); stroke-width: 1.1; opacity: 0.55; }
      .route-base { fill: none; stroke: var(--scr-line); stroke-width: 3.5; stroke-dasharray: 2 7; stroke-linecap: round; }
      .route-live {
        fill: none; stroke: var(--scr-accent); stroke-width: 3.5; stroke-linecap: round;
        stroke-dasharray: 100; stroke-dashoffset: 100;
        filter: drop-shadow(0 0 4px #ff8a4b55);
      }
      .node-start { fill: var(--scr-bg); stroke: var(--scr-text); stroke-width: 2; }
      .dest-dot { fill: var(--scr-dim); transition: fill 0.3s; }
      .dest-ring { fill: none; stroke: var(--scr-dim); stroke-width: 1.2; opacity: 0.5; transition: stroke 0.3s, opacity 0.3s; }
      .dest.reached .dest-dot { fill: var(--scr-good); }
      .dest.reached .dest-ring { stroke: var(--scr-good); opacity: 1; }
      .map-label { fill: var(--scr-text); font-size: 11px; font-family: var(--sans); }
      .map-label.dim { fill: var(--scr-dim); font-size: 9px; letter-spacing: 0.1em; }
      .car-dot { fill: var(--scr-text); stroke: var(--scr-bg); stroke-width: 2; opacity: 0; }
      .screen[data-state='speaking'] .car-dot, .screen[data-state='done'] .car-dot { opacity: 1; }

      .wp-dot { fill: var(--scr-panel); stroke: var(--scr-dim); stroke-width: 1.6; transition: fill 0.3s, stroke 0.3s; }
      .wp-num { fill: var(--scr-dim); font-size: 10px; transition: fill 0.3s; }
      .tour-node .map-label { fill: var(--scr-dim); transition: fill 0.3s; }
      .tour-node.active .wp-dot { fill: var(--scr-accent); stroke: var(--scr-accent); }
      .tour-node.active .wp-num { fill: var(--scr-bg); font-weight: 700; }
      .tour-node.active .map-label { fill: var(--scr-text); }

      .chip {
        position: absolute; font-size: 10px; letter-spacing: 0.06em; color: var(--scr-bg);
        background: var(--scr-accent); border-radius: 3px; padding: 2px 8px;
        opacity: 0; transform: translateY(4px); transition: opacity 0.25s, transform 0.25s;
      }
      .chip.on { opacity: 1; transform: translateY(0); }

      /* 车道场景 */
      .road { fill: #131922; }
      .road-edge { stroke: var(--scr-dim); stroke-width: 2.5; }
      .lane-dash { stroke: var(--scr-dim); stroke-width: 2; stroke-dasharray: 16 22; }
      .screen[data-state='speaking'] .card-lane .lane-dash { animation: dashflow 1.1s linear infinite; }
      @keyframes dashflow { to { stroke-dashoffset: -38; } }
      .lane-hl { fill: var(--scr-accent); opacity: 0; transition: opacity 0.4s; }
      .lane-hl.on { opacity: 0.14; }
      .lane-arrow { stroke: var(--scr-accent); stroke-width: 2.4; fill: none; stroke-linecap: round; opacity: 0; transition: opacity 0.3s; }
      .lane-arrow.on { opacity: 1; }
      .lane-num { fill: var(--scr-dim); }
      .lane-car rect { fill: var(--scr-panel); stroke: var(--scr-text); stroke-width: 2; }
      .lane-car path { fill: none; stroke: var(--scr-dim); stroke-width: 1.6; }
      .lane-car { transition: transform 0.9s cubic-bezier(0.5, 0, 0.2, 1); }
      .scanline { stroke: var(--scr-accent); stroke-width: 1.2; opacity: 0; }
      .scanline.on { opacity: 0.6; animation: scan 1.4s ease-in-out infinite; }
      @keyframes scan { 0% { transform: translateY(30px); } 50% { transform: translateY(200px); } 100% { transform: translateY(30px); } }

      /* 泊车场景 */
      .ground { stroke: var(--scr-dim); stroke-width: 2; }
      .lvl { fill: none; stroke: var(--scr-line); stroke-width: 1.2; }
      .lvl.on { stroke: var(--scr-accent); stroke-width: 1.8; filter: drop-shadow(0 0 4px #ff8a4b44); }
      .slot { fill: none; stroke: var(--scr-good); stroke-width: 1.6; stroke-dasharray: 5 4; opacity: 0; transition: opacity 0.3s; }
      .slot.on { opacity: 1; }

      /* 天气场景 */
      .card-weather { display: grid; }
      .wx { display: grid; align-content: center; gap: 10px; padding: 12px 22px; }
      .wx-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--scr-line-2); padding-bottom: 8px; }
      .wx-head b { font-size: 16px; }
      .wx-head .mono { font-size: 10px; color: var(--scr-dim); letter-spacing: 0.12em; }
      .wx-main { display: flex; align-items: center; gap: 20px; }
      .wx-temp { font-size: 52px; font-weight: 600; min-width: 3.2ch; color: var(--scr-text); }
      .wx-icon { width: 44px; height: 44px; opacity: 0.25; transition: opacity 0.4s; }
      .wx-icon path { stroke: var(--scr-text); stroke-width: 2; fill: none; stroke-linecap: round; }
      .wx-icon .flake-x, .wx-icon .flake-tip { display: none; }
      .wx-icon.on { opacity: 1; animation: flake 6s linear infinite; }
      @keyframes flake { to { transform: rotate(60deg); } }
      .wx-icon { transform-origin: center; }
      .wx-cond b { display: block; font-size: 16px; }
      .wx-cond .mono { font-size: 9.5px; color: var(--scr-dim); letter-spacing: 0.1em; }
      .wx-chips { display: flex; gap: 8px; flex-wrap: wrap; }
      .wx-chip {
        border: 1px solid var(--scr-line); color: var(--scr-dim); border-radius: 4px;
        padding: 4px 10px; font-size: 12px; transition: border-color 0.3s, color 0.3s, background 0.3s;
      }
      .wx-chip i { font-style: normal; font-size: 9px; letter-spacing: 0.08em; margin-inline-start: 4px; }
      .wx-chip.on { border-color: var(--scr-accent); color: var(--scr-text); background: #ff8a4b14; }

      /* ---- 对话区 ---- */
      .dialog { padding: 10px 16px 2px; display: grid; gap: 6px; }
      .who { font-size: 9px; letter-spacing: 0.16em; color: var(--scr-dim); border: 1px solid var(--scr-line); border-radius: 3px; padding: 1px 5px; flex-shrink: 0; }
      .who-a { color: var(--scr-accent); border-color: var(--scr-accent); }
      .u-line, .a-line { display: flex; gap: 10px; align-items: baseline; min-width: 0; }
      .u-line { opacity: 0; transition: opacity 0.3s; }
      .u-line.visible { opacity: 1; }
      .u-text { margin: 0; font-size: 13px; color: var(--scr-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .caption { margin: 0; font-size: 16.5px; line-height: 1.75; min-height: 3.6em; color: var(--scr-text); unicode-bidi: plaintext; }
      .cap-placeholder { color: var(--scr-dim); font-size: 13px; }
      .caption .w { opacity: 0.32; transition: opacity 0.12s; border-radius: 2px; }
      .caption .w.said { opacity: 1; }
      .caption .w.now { opacity: 1; color: var(--scr-accent); box-shadow: 0 1.5px 0 var(--scr-accent); }
      .console[dir='rtl'] .u-text { text-align: right; }

      /* ---- 波形区 ---- */
      .wave-row { display: flex; align-items: center; gap: 12px; padding: 6px 16px 14px; }
      #wave { flex: 1; min-width: 0; height: 44px; }
      .clock { font-size: 10px; color: var(--scr-dim); letter-spacing: 0.08em; white-space: nowrap; }

      .stage-note { font-size: 11.5px; color: var(--ink-2); margin: 10px 2px 0; max-width: 80ch; }

      /* ================= 页脚 ================= */
      .foot { margin-top: 44px; border-top: 3px solid var(--ink); padding-top: 12px; }
      .fnotes { max-width: 90ch; padding-inline-start: 20px; margin: 8px 0 18px; display: grid; gap: 8px; font-size: 13px; color: var(--ink-2); }
      .fnotes b { color: var(--ink); }
      .fnotes code { font-family: var(--mono); font-size: 12px; background: var(--paper-2); padding: 0 4px; border-radius: 2px; }
      .foot-code { font-size: 10px; color: var(--ink-2); letter-spacing: 0.1em; border-top: 1px solid var(--hairline); padding-top: 10px; }

      /* ================= 动效纪律 ================= */
      @media (prefers-reduced-motion: reduce) {
        .ttsc * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
      }
    </style>
  </body>
</html>
