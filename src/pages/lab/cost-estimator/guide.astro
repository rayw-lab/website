---
// RC-01 成本粗估 · 使用说明（网页版）。正文唯一源 = src/data/cost-estimator/guide.md；
// 同一份原文另由 guide.md.ts 提供 Markdown 下载；PDF 走浏览器「打印 → 存为 PDF」（下方 print 样式）。
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Content } from '../../../data/cost-estimator/guide.md';
import { getLabModule } from '../../../lab/manifest';
import { VT_GUARD } from '../../../lab/modules/cost-estimator/vt-guard';
import { shortcutLinks } from '../../../lab/modules/cost-estimator/shortcuts';
import type { Params } from '../../../lab/modules/cost-estimator/core/types';
import params from '../../../data/cost-estimator/params.json';

const module = getLabModule('cost-estimator');
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const tool = `${base}/lab/cost-estimator/`;
const headerLinks = [
  ...shortcutLinks(params as unknown as Params, tool),
  { href: tool, label: '打开计算器', kind: 'button' as const },
];
---

<BaseLayout
  title={`使用说明｜${module.title}｜王磊`}
  description={`${module.title}的使用说明：三步出数、快捷入口、看懂结果、算法口径、保存分享与 Excel 下载。`}
  headerLinks={headerLinks}
  headerNavLabel={`${module.title} 快捷入口`}
  headerNavCaption="快捷入口"
  headerToggle={false}
  footer={false}
>
  <script is:inline slot="head" set:html={VT_GUARD} />
  <div class="ceg">
    <div class="ceg-bar">
      <span class="ceg-ver">参数 {params.version} 版</span>
      <span class="ceg-acts">
        <button type="button" class="ceg-btn" data-ceg-print>打印 / 存为 PDF</button>
        <a class="ceg-btn" href={`${tool}guide.md`} download="成本粗估使用说明.md">下载 Markdown</a>
      </span>
    </div>
    <article class="ceg-doc">
      <Content />
    </article>
  </div>
</BaseLayout>

<script>
  document.querySelector('[data-ceg-print]')?.addEventListener('click', () => window.print());
</script>

<style is:global>
  .ceg {
    --ceg-bg: #f5f4ef;
    --ceg-panel: #fffdf7;
    --ceg-line: #d8d5c9;
    --ceg-text: #1c1d1f;
    --ceg-muted: #595b60;
    --ceg-accent: #b8420f;
    background: var(--ceg-bg);
    color: var(--ceg-text);
    color-scheme: light;
    min-height: calc(100vh - 64px);
    padding: 28px 16px 64px;
  }
  .ceg-bar,
  .ceg-doc {
    max-width: 820px;
    margin: 0 auto;
  }
  .ceg-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    margin-bottom: 16px;
    font-size: 13px;
    color: var(--ceg-muted);
  }
  .ceg-acts {
    display: flex;
    gap: 8px;
  }
  .ceg-btn {
    font: inherit;
    font-size: 13px;
    padding: 5px 14px;
    border: 1px solid var(--ceg-line);
    border-radius: 999px;
    background: var(--ceg-panel);
    color: var(--ceg-text);
    cursor: pointer;
    text-decoration: none;
  }
  .ceg-btn:hover {
    border-color: var(--ceg-accent);
    color: var(--ceg-accent);
  }
  .ceg-doc {
    background: var(--ceg-panel);
    border: 1px solid var(--ceg-line);
    border-radius: 12px;
    padding: 36px 44px 40px;
    font-size: 15px;
    line-height: 1.8;
  }
  .ceg-doc h1 {
    margin: 0 0 12px;
    font-size: 26px;
    line-height: 1.3;
  }
  .ceg-doc h2 {
    margin: 32px 0 10px;
    padding-top: 18px;
    border-top: 1px solid var(--ceg-line);
    font-size: 18px;
    line-height: 1.4;
  }
  .ceg-doc p,
  .ceg-doc ul,
  .ceg-doc ol {
    margin: 0 0 10px;
  }
  .ceg-doc ul,
  .ceg-doc ol {
    padding-left: 1.4em;
  }
  .ceg-doc ul {
    list-style: disc;
  }
  .ceg-doc ol {
    list-style: decimal;
  }
  .ceg-doc li {
    margin: 4px 0;
  }
  .ceg-doc strong {
    color: var(--ceg-text);
    font-weight: 650;
  }
  .ceg-doc table {
    width: 100%;
    border-collapse: collapse;
    margin: 8px 0 12px;
    font-size: 14px;
  }
  .ceg-doc th,
  .ceg-doc td {
    border: 1px solid var(--ceg-line);
    padding: 6px 10px;
    text-align: left;
    vertical-align: top;
  }
  .ceg-doc th {
    background: var(--ceg-bg);
    font-weight: 600;
  }
  @media print {
    .site-header,
    .skip-link,
    .ceg-bar {
      display: none !important;
    }
    .ceg {
      padding: 0;
      background: #fff;
      min-height: 0;
    }
    .ceg-doc {
      border: 0;
      padding: 0;
      max-width: none;
      font-size: 11pt;
    }
    .ceg-doc h2 {
      break-after: avoid;
    }
    .ceg-doc table,
    .ceg-doc li {
      break-inside: avoid;
    }
    @page {
      size: A4;
      margin: 16mm 16mm;
    }
  }
</style>
