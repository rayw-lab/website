---
// About —— 专业叙事页（PRD ABT-01 / master-plan §3「About」）。
// 三要件：①以「解决什么问题」组织的专业叙事（非职责罗列）；
// ②职业演进主线图（物联网→整车前瞻→AR-HUD→多语种座舱→端云大模型→AI 工作流）；
// ③可复制的第三人称讲者简介（一键复制，US-16）。
// JSON-LD：ProfilePage（mainEntity → Person）+ BreadcrumbList（SRD §9.4）。
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaButton from '../../components/ui/CtaButton.astro';
import { PERSON, TITLE_SUFFIX } from '../../data/site';
import { breadcrumbJsonLd, profilePageJsonLd } from '../../data/jsonld';
import { problems as problemCopy, timeline, speakerBio } from '../../data/about-copy';
import '../../styles/about.css';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const title = `关于${TITLE_SUFFIX}`;
const description =
  '王磊的专业叙事：从物联网到 AI 工作流的职业演进主线，聚焦智能座舱多语种、端云大模型与 AI 原生工作流三个交叉领域的解决方案能力。';

const homeUrl = new URL(`${base}/`, Astro.site).href;
const aboutUrl = new URL(`${base}/about/`, Astro.site).href;
const jsonLd = [
  profilePageJsonLd(homeUrl, aboutUrl),
  breadcrumbJsonLd([
    { name: '首页', url: homeUrl },
    { name: '关于', url: aboutUrl },
  ]),
];

const problems = problemCopy.map((p, i) => ({
  n: String(i + 1).padStart(2, '0'),
  q: p.q,
  how: p.how,
  proofHref: `${base}${p.proofPath}`,
  proofLabel: p.proofLabel,
}));

const stationIds = ['iot', 'vehicle', 'hud', 'cockpit', 'llm', 'workflow'] as const;
const stations = timeline.map((t, i) => ({
  id: `station-${stationIds[i]}`,
  n: String(i + 1).padStart(2, '0'),
  stage: t.stage,
  note: t.note,
}));

const illustSrc = `${base}/media/about-hall/about-illustration-s0h.webp`;
const hallHref = `${base}/world/about-pavilion/`;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="about-page" data-about-page>
    <!-- 页头：定位语 + 手绘插图（lazy，不进 LCP） -->
    <header class="about-hero">
      <div class="container about-hero-grid">
        <nav class="crumb data" aria-label="面包屑">
          <a href={`${base}/`}>首页</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">关于</span>
        </nav>
        <h1>我解决的是「复杂技术 → 可决策方案」这段路</h1>
        <p class="lede">
          {PERSON.jobTitle}。十余年从物联网到 AI 工作流的演进里，我反复做的是同一件事：
          把不确定的新技术，变成团队敢拍板、能交付、可复用的方案。这一页不罗列职责，只讲我解决什么问题。
        </p>
        <figure class="about-hero-illust">
          <img
            src={illustSrc}
            alt="手绘炭笔肖像：王磊站在连接技术侧与落地侧的桥上"
            width="794"
            height="720"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
          />
        </figure>
      </div>
    </header>

    <!-- ① 以问题组织的专业叙事：CSS 翻转，无 JS -->
    <section class="section" aria-labelledby="problems-title">
      <div class="container">
        <SectionHeading
          index="01"
          label="Problems I Solve"
          title="解决什么问题"
          id="problems-title"
        />
        <div class="about-qlist">
          {
            problems.map((p) => (
              <article class="about-qcard">
                <div class="about-qcard-inner">
                  <div class="about-qcard-face about-qcard-front">
                    <p class="about-qcard-kicker data">{p.n}</p>
                    <h3>{p.q}</h3>
                    <p class="about-qcard-hint data">悬停或聚焦看做法</p>
                  </div>
                  <div class="about-qcard-face about-qcard-back">
                    <p>{p.how}</p>
                    <a href={p.proofHref}>{p.proofLabel} →</a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ② 职业演进主线：:target + IO 聚焦，无年份 -->
    <section class="section" aria-labelledby="timeline-title">
      <div class="container">
        <SectionHeading
          index="02"
          label="Trajectory"
          title="职业演进主线"
          id="timeline-title"
          lede="每一站都在把「更复杂的技术」推向「更接近决策与交付的位置」——结构化履历时间线与一页纸 PDF 随 V1 增补（ABT-02/05）。"
        />
        <ol class="about-timeline">
          {
            stations.map((t, i) => (
              <li id={t.id} class:list={[i === 0 && 'is-current']}>
                <a class="tl-index data" href={`#${t.id}`}>{t.n}</a>
                <span class="tl-stage">{t.stage}</span>
                <span class="tl-note">{t.note}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ③ 可复制讲者简介 -->
    <section class="section" aria-labelledby="bio-title">
      <div class="container">
        <SectionHeading
          index="03"
          label="Speaker Bio"
          title="讲者简介（第三人称，可直接复制）"
          id="bio-title"
        />
        <figure class="card about-bio">
          <blockquote id="speaker-bio">{speakerBio}</blockquote>
          <figcaption class="about-bio-actions">
            <button type="button" class="about-copy-btn" data-copy-target="#speaker-bio">
              一键复制讲者简介
            </button>
            <span class="about-copy-done data" data-copy-done hidden aria-live="polite">已复制 ✓</span>
            <noscript><span class="data">无 JS 环境请直接选中文本复制。</span></noscript>
          </figcaption>
        </figure>
        <p class="about-bio-note">
          演讲与播客署名请统一外链 <a href={`${base}/now/`}>/now/</a>（实时近况）；
          合作与邀约方式见 <a href={`${base}/contact/`}>Contact</a>。
        </p>
      </div>
    </section>

    <!-- 收尾 CTA（deepLink 语义主 CTA 不变） -->
    <section class="section" aria-labelledby="about-cta-title">
      <div class="container">
        <div class="card about-band">
          <p class="about-ask" id="about-cta-title">想验证这些说法？</p>
          <div class="about-actions">
            <CtaButton href={`${base}/lab/`}>看可交互 Demo →</CtaButton>
            <CtaButton href={`${base}/now/`} variant="secondary">正在进行</CtaButton>
            <CtaButton href={`${base}/contact/`} variant="secondary">联系我</CtaButton>
          </div>
        </div>
        <p class="about-hall-link">
          <a href={hallHref}>想看 3D 版：进入个人档案馆</a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<!-- 一键复制（US-16）：Clipboard API + 选区回退；成功态 1.5s -->
<script is:inline>
  document.querySelectorAll('[data-copy-target]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = document.querySelector(btn.getAttribute('data-copy-target'));
      if (!target) return;
      var text = target.textContent.trim();
      var done = function () {
        var tip = btn.parentElement.querySelector('[data-copy-done]');
        if (tip) {
          tip.hidden = false;
          setTimeout(function () {
            tip.hidden = true;
          }, 1500);
        }
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done);
      } else {
        var range = document.createRange();
        range.selectNodeContents(target);
        var sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        document.execCommand('copy');
        sel.removeAllRanges();
        done();
      }
    });
  });
</script>

<!-- 六站当前聚焦：IntersectionObserver（≤2KB），无滚动劫持 -->
<script is:inline>
  (function () {
    var root = document.querySelector('[data-about-page]');
    if (!root || !('IntersectionObserver' in window)) return;
    var items = root.querySelectorAll('.about-timeline li[id]');
    if (!items.length) return;
    var io = new IntersectionObserver(
      function (entries) {
        var best = null;
        for (var i = 0; i < entries.length; i++) {
          if (!entries[i].isIntersecting) continue;
          if (!best || entries[i].intersectionRatio > best.intersectionRatio) best = entries[i];
        }
        if (!best) return;
        for (var j = 0; j < items.length; j++) items[j].classList.remove('is-current');
        best.target.classList.add('is-current');
      },
      { rootMargin: '-28% 0px -55% 0px', threshold: [0, 0.25, 0.5, 1] },
    );
    for (var k = 0; k < items.length; k++) io.observe(items[k]);
  })();
</script>
