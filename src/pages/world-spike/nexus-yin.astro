---
/** W3 spike · S0 洇组件的部署态自证。noindex,follow + canonical → `/`。 */
import Yin from '../../components/city/halls/nexus/Yin.astro';
// 🔴 canonical 必须带 base。`Astro.site` 是站点根（.../），项目页部署在 `/website` 下，
// 直接拿它当 canonical 会指向 404 —— check-links 的 base 前缀判据会红（本轮才第一次跑到）。
const site = new URL(`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`, Astro.site).href;
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" /><link rel="canonical" href={site} />
    <title>W3 spike · S0 洇</title>
    <style>html,body{margin:0;background:#efe9dc}</style>
  </head>
  <body><Yin /></body>
</html>
