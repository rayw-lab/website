---
// ThemeToggle —— 日间/夜间驾驶模式切换（spec §3.1 / §5.2）。
// 图形语言：半填充仪表盘（◐），夜间旋转 180°；
// 状态写入 <html> class 并持久化到 localStorage（防闪烁脚本在 BaseLayout）。
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="切换日间/夜间驾驶模式"
  title="日间/夜间驾驶模式"
>
  <svg
    class="dial"
    viewBox="0 0 20 20"
    width="18"
    height="18"
    aria-hidden="true"
  >
    <circle
      cx="10"
      cy="10"
      r="7.25"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"></circle>
    <path d="M10 2.75 a7.25 7.25 0 0 0 0 14.5 Z" fill="currentColor"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const isDark = () =>
    root.classList.contains('dark') ||
    (!root.classList.contains('light') && media.matches);

  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.classList.remove('light', 'dark');
      root.classList.add(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* localStorage 不可用时仅本页生效 */
      }
    });
  });
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    /* 触控目标 ≥ 44×44px（spec §8.4） */
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: var(--radius-chip);
    color: var(--ink-2);
    transition: color var(--duration-hover) var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .dial {
    transition: transform var(--duration-hover) var(--ease-out);
  }

  :global(html.dark) .dial {
    transform: rotate(180deg);
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not(.light)) .dial {
      transform: rotate(180deg);
    }
  }
</style>
