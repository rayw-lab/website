---
// 第 7 幕：六向能力交叉。SVG 六边形 + 六标签，hover 高亮对应顶点。
import { crystalAxes, jobEntries } from '../../../../data/about-copy';

const cx = 100;
const cy = 100;
const r = 58;
const labelR = 86;
const vertices = crystalAxes.map((axis, i) => {
  const rad = ((-90 + i * 60) * Math.PI) / 180;
  return {
    ...axis,
    x: cx + r * Math.cos(rad),
    y: cy + r * Math.sin(rad),
    lx: `${((cx + labelR * Math.cos(rad)) / 200) * 100}%`,
    ly: `${((cy + labelR * Math.sin(rad)) / 200) * 100}%`,
  };
});
const hexPoints = vertices.map((v) => `${v.x.toFixed(1)},${v.y.toFixed(1)}`).join(' ');
---

<section
  class="hall-crystal"
  data-scene="s7"
  data-bind="stage:none;pillar:cockpit-i18n,edge-cloud-llm,ai-workflow;proof:/about/"
>
  <div class="hall-panel">
    <p class="hall-kicker">交汇 · 六向</p>
    <h2>单项不稀缺，交叉即壁垒</h2>
    <p class="hall-crystal-lede">
      汽车行业经验 × 智能座舱 × 多语种全球化 × 大模型 × AI 工作流 × 复杂项目交付。差异化标签是
      AI 原生方案工作流。
    </p>
    <div class="hall-crystal-board">
      <div class="hall-hex">
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <polygon
            points={hexPoints}
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            opacity="0.7"
          ></polygon>
          {
            vertices.map((v) => (
              <circle
                class:list={['hall-hex-pt', `pt-${v.id}`]}
                cx={v.x}
                cy={v.y}
                r="6"
              />
            ))
          }
        </svg>
        {
          vertices.map((v) => (
            <button type="button" class="hall-hex-label" data-axis={v.id} style={`left:${v.lx};top:${v.ly}`}>
              {v.label}
            </button>
          ))
        }
      </div>
      <div class="hall-jobs">
        {
          jobEntries.map((job) => (
            <article class="card">
              <h3>{job.title}</h3>
              <p>{job.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
