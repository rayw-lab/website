---
// 六站地轨：地面轨道 + 六个站点。无年份。键盘 Tab 到节点、Enter 跳到该站。
import { timeline } from '../../../../data/about-copy';

const STOPS = timeline.map((item, i) => {
  const scene = i < 2 ? 's2' : (`s${i + 1}` as 's3' | 's4' | 's5' | 's6');
  const at = i === 1 ? 0.62 : 0.18;
  return {
    n: String(i + 1).padStart(2, '0'),
    name: item.stage,
    scene,
    at,
  };
});
---

<nav class="hall-rail" data-station-rail aria-label="六站地轨">
  <ol class="hall-rail-list">
    {
      STOPS.map((stop) => (
        <li>
          <button
            type="button"
            class="hall-rail-stop"
            data-rail-scene={stop.scene}
            data-rail-at={String(stop.at)}
            data-rail-n={stop.n}
          >
            <span class="hall-rail-node" aria-hidden="true"></span>
            <span class="hall-rail-n">{stop.n}</span>
            <span class="hall-rail-name">{stop.name}</span>
          </button>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const rail = document.querySelector<HTMLElement>('[data-station-rail]');
  if (rail) {
    const stops = [...rail.querySelectorAll<HTMLButtonElement>('.hall-rail-stop')];
    const reduceMq = matchMedia('(prefers-reduced-motion: reduce)');

    const sceneOf = (el: Element) => (el as HTMLElement).dataset.scene ?? '';

    const revealOf = (el: HTMLElement) => {
      const n = Number.parseFloat(getComputedStyle(el).getPropertyValue('--hall-reveal').trim());
      return Number.isFinite(n) ? Math.min(1, Math.max(0, n)) : 1;
    };

    const currentScene = (): string => {
      const nodes = document.querySelectorAll<HTMLElement>('[data-scene]');
      let best: HTMLElement | null = null;
      let bestScore = -1;
      for (const el of nodes) {
        const r = el.getBoundingClientRect();
        const visible = Math.min(r.bottom, innerHeight) - Math.max(r.top, 0);
        if (visible > bestScore) {
          bestScore = visible;
          best = el;
        }
      }
      return best ? sceneOf(best) : '';
    };

    const currentN = (): string => {
      const scene = currentScene();
      if (scene === 's8') return '';
      const best = document.querySelector<HTMLElement>(`[data-scene="${scene}"]`);
      if (!best) return '';
      if (scene === 's2') return revealOf(best) < 0.5 ? '01' : '02';
      if (scene === 's3') return '03';
      if (scene === 's4') return '04';
      if (scene === 's5') return '05';
      if (scene === 's6') return '06';
      return '';
    };

    const paint = () => {
      const scene = currentScene();
      const away = scene === 's8';
      rail.classList.toggle('is-away', away);
      rail.toggleAttribute('inert', away);
      const n = away ? '' : currentN();
      for (const btn of stops) {
        const on = btn.dataset.railN === n;
        btn.classList.toggle('is-current', on);
        if (on) btn.setAttribute('aria-current', 'location');
        else btn.removeAttribute('aria-current');
      }
    };

    const jump = (btn: HTMLButtonElement) => {
      const scene = btn.dataset.railScene;
      const at = Number(btn.dataset.railAt || '0');
      const section = document.querySelector<HTMLElement>(`[data-scene="${scene}"]`);
      if (!section) return;
      const travel = Math.max(0, section.offsetHeight - window.innerHeight);
      const y = section.getBoundingClientRect().top + window.scrollY + travel * at;
      window.scrollTo({ top: y, behavior: reduceMq.matches ? 'auto' : 'smooth' });
    };

    for (const btn of stops) {
      btn.addEventListener('click', () => jump(btn));
    }

    const io = new IntersectionObserver(
      () => {
        paint();
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    for (const el of document.querySelectorAll('[data-scene]')) io.observe(el);
    paint();
  }
</script>

<style is:global>
  html:has([data-station-rail]) .hall-main {
    padding-bottom: 5.25rem;
  }

  html:has([data-station-rail]) .site-footer {
    padding-bottom: 5.75rem;
  }

  .hall-rail {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 6;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-block-start: 1px solid var(--line);
    padding: 0.55rem var(--container-pad) 0.7rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hall-rail {
      transition: opacity 300ms ease;
    }
  }

  .hall-rail.is-away {
    opacity: 0;
    pointer-events: none;
  }

  .hall-rail-list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    position: relative;
    width: min(72rem, 100%);
    margin-inline: auto;
  }

  .hall-rail-list::before {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0.72rem;
    height: 1px;
    background: color-mix(in srgb, #fef3c7 42%, transparent);
    pointer-events: none;
  }

  .hall-rail-stop {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.15rem 0.2rem 0.1rem;
    color: var(--ink-3);
    font: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .hall-rail-node {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, #fef3c7 70%, transparent);
    background: var(--bg);
  }

  /* [AH-VIS-1 债5b] 六站原本 01–06 全同字号同色、站名只差一档灰，当前站除了节点
     换色之外读不出「你在这」。改三段层级：序号退为安静索引（小一档 + 米色降透明），
     当前站序号回满米色并加粗，当前站名加粗 —— 无新循环动画。 */
  .hall-rail-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: color-mix(in srgb, #fef3c7 52%, transparent);
  }

  .hall-rail-name {
    font-size: var(--text-data);
    line-height: 1.3;
    text-align: center;
    max-width: 100%;
  }

  .hall-rail-stop.is-current .hall-rail-n {
    font-size: var(--text-data);
    font-weight: 600;
    color: #fef3c7;
  }

  .hall-rail-stop.is-current .hall-rail-name {
    font-weight: 600;
  }

  .hall-rail-stop:hover .hall-rail-name,
  .hall-rail-stop:focus-visible .hall-rail-name,
  .hall-rail-stop.is-current .hall-rail-name {
    color: var(--ink);
  }

  .hall-rail-stop.is-current .hall-rail-node {
    background: var(--accent);
    border-color: var(--accent);
    /* 静态光环（零时间项）：当前站节点在六个等距圆点里先被眼睛抓到 */
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .hall-rail-stop:hover .hall-rail-n,
  .hall-rail-stop:focus-visible .hall-rail-n {
    color: #fef3c7;
  }

  .hall-rail-stop:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 639px) {
    .hall-rail-name {
      font-size: 0.62rem;
    }
  }
</style>
