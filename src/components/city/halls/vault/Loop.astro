---
/**
 * 帧库 · S2 闭环陈列「一集是一次构建」
 *
 * 立方体炸开（E）之后落到这里：阶段锁矩阵（七集 × D/S/A/P/M/F，全部从 episodes.json 渲染）、
 * L0–L3 门禁金字塔（文案照抄 raw TOPOLOGY §6）、人审日志（各集 manifest.reviews）、
 * dogfood（这块立方体自己怎么来的：BUILD-RECEIPT 逐条渲染）。数字一个都不手写。
 */
import episodesDoc from '../../../../data/frame-vault/episodes.json';
import type { VaultManifest } from './Vault';

interface Episode { ep: string; title: string | null; stage: string | null; label: string | null; gates: Record<string, string | null> | null; has_video: boolean; sha8: string | null; duration_s: number | null; human_score: number | null }
interface Receipt { ep: string; input_sha256: string; fps: number; n: number; atlas_count: number; atlas_bytes_total: number; products: { name: string; bytes: number; sha256: string }[]; video: { bytes: number; sha256: string }; ffmpeg: string; cwebp: string; built_at: string }

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const locks = episodesDoc.locks as { letter: string; name: string }[];
const episodes = episodesDoc.episodes as Episode[];
const manifests = Object.values(import.meta.glob<{ default: VaultManifest }>('../../../../data/frame-vault/ep*.json', { eager: true })).map((m) => m.default).filter((m) => Array.isArray(m.reviews));   // ep*.json 也会匹配到 episodes.json，按形状过滤
const receipts = Object.values(import.meta.glob<{ default: Receipt }>('../../../../../evidence/frame-vault/*/BUILD-RECEIPT.json', { eager: true })).map((m) => m.default).sort((a, b) => a.ep.localeCompare(b.ep));
const reviews = manifests.flatMap((m) => m.reviews.map((r) => ({ ...r, ep: m.ep }))).sort((a, b) => (a.date < b.date ? 1 : -1));
const rejects = manifests.reduce((s, m) => s + m.rings.length, 0);
const idx = (letter: string | null): number => locks.findIndex((l) => l.letter === letter);
const gateName: Record<string, string> = { L0: '确定性', L1: '语义', L2: '观察', L3: '人审' };
const fmtMB = (b: number): string => `${(b / 1048576).toFixed(1)} MB`;
// 门禁金字塔四行：照抄 raw TOPOLOGY.md §6（2026-09-04 读表），不改写
const pyramid = [
  { k: 'L0', what: '容器/流/解码；帧数与时间轴一致；空白帧=0；意外硬切=0；渲染态文字 bbox 不与字幕带相交、不与彼此相交；每 cue 首中尾三帧存在；片头片尾音量窗；AAC packet 账', who: 'QC 脚本，每次构建', block: '阻断' },
  { k: 'L1', what: 'ASR 转写 ↔ 台本逐句对齐；字幕 ↔ 台本逐字一致；DIRECTOR 每句的 settled_state 在该 cue 尾帧存在；案例原声窗相关性', who: 'QC 脚本', block: '阻断' },
  { k: 'L2', what: 'VLM/OCR 只输出带 bbox 和时间戳的观察，不打分', who: '可选', block: '不阻断，只进看片包' },
  { k: 'L3', what: '磊哥按阶段锁看 / 听', who: '磊哥', block: '阻断，且唯一能签通过' },
];
---

<section class="loop" id="vault-loop" data-vault-loop aria-label="一集是一次构建">
  <header class="loop__head">
    <p class="loop__kicker">S2 · 闭环</p>
    <h2 class="loop__title">一集是一次构建</h2>
    <p class="loop__lede">视频不是文件。每一集都从立项走到定稿，中间过五个锁，每个锁先由机器门（L0/L1）拦一次，再由人看一次；被退回只回到最近的锁。上面那块立方体，就是这条流水线吐出来的一个构建产物。</p>
  </header>

  <!-- 阶段锁矩阵：行 = 集，列 = D + 五个锁；实心 = 已过，亮格 = 当前锁（带 L0–L3 四盏灯），线框 = 未到 -->
  <div class="loop__matrix" role="table" aria-label="阶段锁矩阵">
    <div class="loop__row loop__row--head" role="row">
      <span role="columnheader">集</span>
      {locks.map((l) => <span role="columnheader" class="loop__lk"><b>{l.letter}</b>{l.name}</span>)}
    </div>
    {episodes.map((e) => (
      <div class="loop__row" role="row" data-ep={e.ep} data-has-video={e.has_video ? '1' : '0'} data-vault-slab>
        <span role="rowheader" class="loop__ep">
          <i class={`loop__cube ${e.has_video ? '' : 'loop__cube--wire'}`} aria-hidden="true"></i>
          <b>{e.ep}</b><span>{e.title ?? '（候选）'}</span>
          <small>{e.has_video ? `sha ${e.sha8}${e.label ? ` · ${e.label}` : ''}` : '无成片 · 线框'}{e.human_score !== null ? ` · 人审 ${e.human_score}` : ''}</small>
        </span>
        {locks.map((l, i) => {
          const cur = idx(e.stage);
          const state = i < cur ? 'passed' : i === cur ? 'current' : 'future';
          return (
            <span role="cell" class="loop__cell" data-state={state} title={`${e.ep} · ${l.letter} ${l.name} · ${state === 'passed' ? '已过' : state === 'current' ? '当前锁' : '未到'}`}>
              {state === 'current' && e.gates && (
                <span class="loop__lamps" aria-label="门禁四态">
                  {(['L0', 'L1', 'L2', 'L3'] as const).map((g) => (
                    <i data-gate={g} data-v={e.gates?.[g] ?? 'null'} title={`${g} ${gateName[g]}：${e.gates?.[g] ?? '未跑'}`}></i>
                  ))}
                </span>
              )}
            </span>
          );
        })}
      </div>
    ))}
  </div>

  <div class="loop__grid">
    <!-- 门禁金字塔 -->
    <article class="loop__card">
      <h3>门禁金字塔</h3>
      <ol class="loop__pyr">
        {pyramid.map((p) => (
          <li data-gate={p.k}>
            <b>{p.k} {gateName[p.k]}</b>
            <span>{p.what}</span>
            <small>{p.who} · {p.block}</small>
          </li>
        ))}
      </ol>
      <p class="loop__note">L3 那盏灯拨不动：只有磊哥能签通过。上面矩阵里每个当前锁格子的第四盏灯，就是它。</p>
    </article>

    <!-- 人审日志 -->
    <article class="loop__card">
      <h3>人审日志 <small>{reviews.length} 条 · {rejects} 次退回落在时间轴上</small></h3>
      <ul class="loop__log">
        {reviews.slice(0, 12).map((r) => (
          <li data-verdict={r.verdict}><b>{r.ep}</b><span>{r.date}</span><i>{r.verdict}</i><em>{r.category}</em>{r.timecode ? <code>{r.timecode}</code> : null}</li>
        ))}
      </ul>
      {reviews.length > 12 && <p class="loop__note">只列最近 12 条；全部退回可在上方标尺的门环上逐个看原话。</p>}
    </article>
  </div>

  <!-- dogfood：这块立方体自己怎么来的 -->
  <article class="loop__card loop__dog">
    <h3>这块立方体自己怎么来的 <small>同一条流水线，构建期跑，收据入库</small></h3>
    <ol class="loop__steps">
      <li><b>1</b><span>核身份</span><small>原片 sha256 必须等于 EPISODE-STATE 登记值，不等即 FAIL</small></li>
      <li><b>2</b><span>抽帧</span><small>ffmpeg 按 ≤2000 片选帧率，缩到 160×90</small></li>
      <li><b>3</b><span>打包</span><small>每 256 帧一张 16×16 图集，WebP 无损（纸色 + 文字：无损反而最小）</small></li>
      <li><b>4</b><span>投影</span><small>逐帧差分沿 y / x 取最大 → 立方体四个侧面的金色纸带</small></li>
      <li><b>5</b><span>过门</span><small>sha 一致、环时刻在时长内、零本地路径、图集张数、投影尺寸、体积 ≤10 MB</small></li>
    </ol>
    <div class="loop__receipts">
      {receipts.map((r) => (
        <dl>
          <dt>{r.ep}</dt>
          <dd>输入 sha <code>{r.input_sha256.slice(0, 12)}</code></dd>
          <dd>{r.fps} fps · {r.n} 片 · {r.atlas_count} 张图集 · {fmtMB(r.atlas_bytes_total)}</dd>
          <dd>视频 {fmtMB(r.video.bytes)} · sha <code>{r.video.sha256.slice(0, 8)}</code></dd>
          <dd><small>{r.cwebp.replace(/^.*?(\d+\.\d+\.\d+).*$/, 'cwebp $1')} · {r.built_at.slice(0, 16).replace('T', ' ')}</small></dd>
        </dl>
      ))}
    </div>
  </article>

  <!-- scout-r0 指向卡（磊哥 R1-1：并入叙事不搬迁） -->
  <a class="loop__card loop__pointer" href={`${base}/work/ai-native-workflow/`}>
    <span class="loop__kicker">另一条闭环</span>
    <b>scout-r0 · 自动化视频闭环</b>
    <span>同一套锁与门，跑在另一条产线上 →</span>
  </a>

  <!-- S3 收官：三个出口（回城走 film 快门；下一栋；把片子带走） -->
  <nav class="loop__exits" aria-label="出口">
    <a class="loop__exit" href={`${base}/?poi=workflow-foundry&from=hall`} data-vault-exit="city"><span class="loop__kicker">出口 · 回城</span><b>快门合上，回到车里</b><span>接着开去下一栋</span></a>
    <a class="loop__exit" href={`${base}/world/agent-nexus/`} data-vault-exit="next"><span class="loop__kicker">出口 · 隔壁</span><b>墨迹 · Ink Ledger</b><span>另一种物证：会话即笔迹</span></a>
    <div class="loop__exit" data-vault-exit="take"><span class="loop__kicker">出口 · 带走</span><b>把片子带走</b><span class="loop__dl">{manifests.map((m) => <a href={m.video.src} download>{m.ep}{m.stage === 'F' ? '' : ` ${m.label ?? ''}`}</a>)}</span></div>
  </nav>
</section>

<style is:global>
  .loop { --bg: #05070d; --paper: #ece9e1; --gold: #ffd278; --metal: #9aa3ad; --red: #e0483a; scroll-margin-top: 76px;
    background: var(--bg); color: var(--paper); padding: clamp(3rem, 8vh, 6rem) clamp(1rem, 3vw, 2.5rem) clamp(4rem, 10vh, 7rem); }
  .loop__head { max-width: 62rem; margin-bottom: 2.6rem; }
  .loop__kicker { margin: 0 0 .5rem; font: 11px/1 ui-monospace, Menlo, monospace; letter-spacing: .2em; color: var(--gold); }
  .loop__title { margin: 0 0 .9rem; font: 400 clamp(1.7rem, 3.4vw, 2.6rem)/1.15 "Songti SC", "Source Han Serif SC", serif; letter-spacing: .04em; }
  .loop__lede { margin: 0; max-width: 46rem; color: #cfd3dc; opacity: .85; line-height: 1.75; }

  /* 矩阵 */
  .loop__matrix { display: grid; gap: .35rem; margin-bottom: 2.4rem; }
  .loop__row { display: grid; grid-template-columns: minmax(14rem, 1.4fr) repeat(6, 1fr); gap: .35rem; align-items: stretch; }
  .loop__row--head { color: var(--metal); font: 11px/1.2 ui-monospace, Menlo, monospace; letter-spacing: .1em; }
  .loop__row--head span { padding: .4rem .5rem; }
  .loop__lk b { display: block; color: var(--gold); font-size: 13px; margin-bottom: .2rem; }
  .loop__ep { display: grid; grid-template-columns: auto auto 1fr; grid-template-rows: auto auto; column-gap: .6rem; align-items: baseline; padding: .55rem .6rem; border: 1px solid #ffffff12; }
  .loop__ep b { font: 500 15px/1 "Songti SC", "Source Han Serif SC", serif; }
  .loop__ep > span { font-size: .85rem; color: #cfd3dc; }
  .loop__ep small { grid-column: 2 / -1; font: 11px/1.4 ui-monospace, Menlo, monospace; color: var(--metal); }
  .loop__cube { width: 14px; height: 14px; border: 1.5px solid var(--gold); background: linear-gradient(135deg, #2a2418, #0b0c10); transform: skewY(-12deg); grid-row: 1 / 3; align-self: center; }
  .loop__cube--wire { background: none; border-style: dashed; opacity: .55; }
  .loop__cell { position: relative; min-height: 2.6rem; border: 1px solid #ffffff12; background: #0a0d15; }
  .loop__cell[data-state='passed'] { background: linear-gradient(180deg, #2b2316, #1a160e); border-color: #ffd27855; }
  .loop__cell[data-state='passed']::after { content: ''; position: absolute; inset: 0; margin: auto; width: 6px; height: 6px; border-radius: 50%; background: var(--gold); }
  .loop__cell[data-state='current'] { border-color: var(--gold); box-shadow: inset 0 0 0 1px #ffd27833, 0 0 24px #ffd27822; }
  .loop__cell[data-state='future'] { border-style: dashed; opacity: .45; }
  .loop__lamps { position: absolute; inset: 0; display: grid; grid-auto-flow: column; place-content: center; gap: 6px; }
  .loop__lamps i { width: 8px; height: 8px; border-radius: 50%; background: #2a2f3a; border: 1px solid #00000080; }
  .loop__lamps i[data-v='PASS'], .loop__lamps i[data-v='HUMAN_PASS'] { background: var(--gold); box-shadow: 0 0 6px var(--gold); }
  .loop__lamps i[data-v='OBSERVED'] { background: #7dd3c0; }
  .loop__lamps i[data-v='HUMAN_REJECT'] { background: var(--red); box-shadow: 0 0 6px var(--red); }
  .loop__lamps i[data-v='HUMAN_UNKNOWN'] { background: none; border-color: var(--metal); }
  .loop__lamps i[data-gate='L3'] { width: 10px; height: 10px; }

  .loop__grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 1rem; margin-bottom: 1rem; }
  .loop__card { border: 1px solid #ffffff14; background: #080b12; padding: 1.2rem 1.3rem; }
  .loop__card h3 { margin: 0 0 .9rem; font: 400 1.05rem/1.3 "Songti SC", "Source Han Serif SC", serif; letter-spacing: .06em; }
  .loop__card h3 small { margin-left: .6rem; font: 11px/1 ui-monospace, Menlo, monospace; color: var(--metal); letter-spacing: .08em; }
  .loop__note { margin: .9rem 0 0; font-size: .8rem; color: var(--metal); line-height: 1.6; }
  .loop__pyr { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .loop__pyr li { display: grid; grid-template-columns: 6.5rem 1fr; gap: .2rem .8rem; padding: .55rem .7rem; border-left: 2px solid #ffd27866; background: #0b0f18; }
  .loop__pyr li[data-gate='L3'] { border-left-color: var(--red); }
  .loop__pyr b { font: 500 13px/1.4 ui-monospace, Menlo, monospace; color: var(--gold); }
  .loop__pyr li[data-gate='L3'] b { color: var(--red); }
  .loop__pyr span { font-size: .82rem; line-height: 1.55; color: #cfd3dc; }
  .loop__pyr small { grid-column: 2; font: 11px/1.4 ui-monospace, Menlo, monospace; color: var(--metal); }
  .loop__log { list-style: none; margin: 0; padding: 0; display: grid; gap: .3rem; font: 12px/1.5 ui-monospace, Menlo, monospace; }
  .loop__log li { display: grid; grid-template-columns: 2.6rem 6rem 5.4rem 1fr auto; gap: .5rem; color: var(--metal); border-bottom: 1px dashed #ffffff10; padding-bottom: .3rem; }
  .loop__log b { color: var(--paper); font-weight: 500; }
  .loop__log i { font-style: normal; color: #7dd3c0; }
  .loop__log li[data-verdict='REJECT'] i, .loop__log li[data-verdict='HUMAN_REJECT'] i { color: var(--red); }
  .loop__log em { font-style: normal; }
  .loop__steps { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: .5rem; }
  .loop__steps li { display: grid; gap: .25rem; padding: .6rem .7rem; border-top: 2px solid var(--gold); background: #0b0f18; }
  .loop__steps b { font: 500 11px/1 ui-monospace, Menlo, monospace; color: var(--gold); }
  .loop__steps span { font-size: .9rem; }
  .loop__steps small { font-size: .74rem; line-height: 1.5; color: var(--metal); }
  .loop__receipts { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .6rem; }
  .loop__receipts dl { margin: 0; padding: .6rem .7rem; border: 1px solid #ffffff12; font: 11.5px/1.6 ui-monospace, Menlo, monospace; color: var(--metal); }
  .loop__receipts dt { color: var(--paper); font-size: 13px; margin-bottom: .2rem; }
  .loop__receipts dd { margin: 0; }
  .loop__receipts code { color: var(--gold); }
  .loop__pointer { display: grid; gap: .3rem; margin-top: 1rem; text-decoration: none; color: var(--paper); transition: border-color .2s; }
  .loop__pointer:hover { border-color: var(--gold); }
  .loop__pointer b { font: 500 1rem/1.3 "Songti SC", "Source Han Serif SC", serif; }
  .loop__pointer > span:last-child { color: var(--metal); font-size: .85rem; }
  .loop__exits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 3rem; }
  .loop__exit { display: grid; gap: .3rem; padding: 1.2rem 1.3rem; border: 1px solid #ffffff14; background: #080b12; color: var(--paper); text-decoration: none; transition: border-color .2s, transform .2s; }
  a.loop__exit:hover { border-color: var(--gold); transform: translateY(-2px); }
  .loop__exit b { font: 500 1.05rem/1.3 "Songti SC", "Source Han Serif SC", serif; }
  .loop__exit > span:last-child { color: var(--metal); font-size: .85rem; }
  .loop__dl { display: flex; gap: .8rem; flex-wrap: wrap; }
  .loop__dl a { color: var(--gold); font: 12px/1.6 ui-monospace, Menlo, monospace; text-decoration: none; border-bottom: 1px dotted #ffd27866; }
  @media (max-width: 960px) { .loop__exits { grid-template-columns: 1fr; } }

  /* 爆炸过场：E 之后立方体分层落下来 —— 各集行从上方带层间距滑入（reduced-motion 直达） */
  .loop.is-exploded [data-vault-slab] { animation: loop-slab .7s cubic-bezier(.2,.7,.2,1) both; }
  .loop.is-exploded [data-vault-slab]:nth-child(2) { animation-delay: .04s } .loop.is-exploded [data-vault-slab]:nth-child(3) { animation-delay: .09s }
  .loop.is-exploded [data-vault-slab]:nth-child(4) { animation-delay: .14s } .loop.is-exploded [data-vault-slab]:nth-child(5) { animation-delay: .19s }
  .loop.is-exploded [data-vault-slab]:nth-child(6) { animation-delay: .24s } .loop.is-exploded [data-vault-slab]:nth-child(7) { animation-delay: .29s }
  .loop.is-exploded [data-vault-slab]:nth-child(8) { animation-delay: .34s }
  @keyframes loop-slab { from { opacity: 0; transform: translateY(-2.2rem) skewY(-3deg); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .loop.is-exploded [data-vault-slab] { animation: none; } }
  @media (max-width: 960px) {
    .loop__grid, .loop__steps { grid-template-columns: 1fr; }
    .loop__row { grid-template-columns: minmax(9rem, 1.4fr) repeat(6, 1fr); }
    .loop__log li { grid-template-columns: 2.6rem 6rem 1fr; }
    .loop__log em, .loop__log code { display: none; }
  }
</style>
