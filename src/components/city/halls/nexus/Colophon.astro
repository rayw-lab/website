---
/**
 * 一篇题跋的骨架：题 / 文 / 迹 / 印 / 背面（草案 §2.1，机器可校验）。
 * 正文与迹待磊哥；这里只把**形状与绑定**立起来，占位明写「待定稿」，不假装有内容。
 */
import ledger from '../../../../data/nexus-ledger.json';
import type { Colophon } from '../../../../data/nexus-colophons';
interface Props { c: Colophon }
const { c } = Astro.props;

interface Receipt { id: string; seat: string; servedModel: string | null; identityOk: boolean | null }
const machine = (ledger.colophons as Array<{ id: string; seals: Array<{ kind: string; receipt: string }> }>)
  .find((x) => x.id === c.id);
const receipts = (ledger.receipts ?? []) as Receipt[];
// 印：跋④来自真实收据（三态严格对应 identityOk），其余跋没有机器收据 → 一枚灰印，如实。
const seals = c.sealsFrom
  ? (machine?.seals ?? []).slice(0, 8).map((s) => receipts.find((r) => r.id === s.receipt)).filter(Boolean) as Receipt[]
  : [];
const state = (r: Receipt) => (r.identityOk === true ? 'go' : r.identityOk === false ? 'nogo' : 'unknown');
const bind = [
  ...c.rules.map((r) => `rule:~/.claude/rules/${r}`),
  ...seals.map((r) => `receipt:${r.id}`),
].join(';');
---

<article class="cf" data-scene={c.scene} data-colophon={c.id} data-bind={bind} data-status="needs-leige">
  <p class="cf__k">跋{c.n} · {c.method}</p>
  <h3 class="cf__t">{c.titleCandidate}<span class="cf__cand">候选 · 待定稿</span></h3>
  <p class="cf__ph" data-ph="body">文 · 正文待磊哥口述（≤200 字，每一句可追到文件）</p>
  <p class="cf__ph" data-ph="trace">迹 · 一条真实事件，待点名</p>
  <div class="cf__seals" aria-label="印">
    {seals.length > 0
      ? seals.slice(0, 4).map((r) => (
          <span class={`cf__seal cf__seal--${state(r)}`} title={`${r.seat} · ${r.servedModel ?? '未知模型'}`}>
            {r.id}
          </span>
        ))
      : <span class="cf__seal cf__seal--unknown" title="该跋无机器收据">无收据</span>}
    {seals.length > 4 && (
      <span class="cf__seal cf__seal--sum" title={seals.map((r) => r.id).join('、')}>共 {seals.length} 迹</span>
    )}
  </div>
  <p class="cf__back">背面 · 绑定 {c.rules.length} 条规则（标题级，公开尺度待批）</p>
</article>

<style>
  /* 题跋面从 34rem 宽的横卡改成 22rem 宽、≥27rem 高的纵势面（高宽比≈1.25:1，W4r 改法 2）：
     单行正文 18–20 字，手卷横移时眼前是一幕幕挺立的题跋，不是趴着的卡片。 */
  .cf {
    position: relative;
    inline-size: min(78vw, 22rem); min-block-size: 27rem; flex: 0 0 auto;
    display: grid; align-content: start; gap: .8rem;
    padding: .4rem .2rem .4rem 0;
    font-family: "Songti SC", "STSong", "Source Han Serif SC", "Noto Serif CJK SC", "SimSun", serif;
    color: #1c1f26;
  }
  /* 接纸缝：不是通底网格线，是纵向 75% 的渐隐纸缝（W4r 改法 3） */
  .cf::after { content: ''; position: absolute; right: -2rem; top: 12.5%; inline-size: 1px; block-size: 75%;
    background: linear-gradient(to bottom, transparent, #1c1f262e 20%, #1c1f2647 50%, #1c1f262e 80%, transparent); }
  /* 骑缝小印：接缝中点一枚极淡朱砂方，托裱分段的物理断连（agy W8 手卷专项） */
  .cf::before { content: ''; position: absolute; right: calc(-2rem - 6px); top: calc(50% - 6px); inline-size: 12px; block-size: 12px;
    border: 1px solid #9e2a2b66; border-radius: 1px; }
  .cf:last-child::before { display: none; }
  .cf:last-child::after { display: none; }
  /* 五段 token（W4r §三）：序 .72rem/字距 .22em；题 1.4rem/1.42；文 .95rem/1.95；迹 .8125rem/1.65；背面 .72rem/1.5 */
  .cf__k { margin: 0; font: 400 .72rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .22em; color: #7a7265; }
  .cf__t { margin: 0; font-weight: 400; font-size: 1.4rem; line-height: 1.42; letter-spacing: .05em; color: #1c1f26; }
  .cf__cand { margin-inline-start: .5em; font: 400 .6em/1 ui-monospace, Menlo, monospace; letter-spacing: .14em; color: #9e2a2b; vertical-align: .3em; white-space: nowrap; }
  .cf__ph { margin: 0; color: #524c42; font: 400 .95rem/1.95 inherit; letter-spacing: .03em; }
  .cf__ph[data-ph="trace"] { font-size: .8125rem; line-height: 1.65; letter-spacing: .04em; }
  /* 卷尾钤印：最多 4 枚 + 合印，不排成发票码；错落=每枚微转（agy W9 P1-7 采纳） */
  .cf__seals { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .3rem; }
  .cf__seals > :nth-child(2n) { transform: rotate(-1.2deg) translateY(1px); }
  .cf__seals > :nth-child(3n) { transform: rotate(1deg); }
  .cf__seal--sum { color: #9e2a2b; border-color: #9e2a2b66; background: transparent; }
  .cf__seal {
    display: inline-grid; place-items: center; inline-size: 2.3rem; aspect-ratio: 1;
    font: 500 .56rem/1 ui-monospace, Menlo, monospace; letter-spacing: .05em; border-radius: 1px;
    transform: rotate(var(--r, -0.8deg));
  }
  .cf__seal:nth-child(2n) { --r: .9deg; } .cf__seal:nth-child(3n) { --r: -1.3deg; }
  .cf__seal--go { color: #9e2a2b; border: 1.5px solid #9e2a2b; background: #efe9dc; }
  .cf__seal--nogo { color: #efe9dc; background: #9e2a2b; border: 1.5px solid #9e2a2b; }
  .cf__seal--unknown { color: #1c1f2659; border: 1.5px solid #1c1f2626; box-shadow: inset 0 -6px 10px -8px #1c1f2633; inline-size: auto; padding: 0 .5rem; }
  .cf__back { margin: 0; padding-inline-start: .6rem; border-inline-start: 1.5px solid #1c1f2626;
    font: 400 .72rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; color: #82786a; letter-spacing: .08em; }
  /* 矮视口：画心 = 100svh − header < 36rem 时，27rem 面装不下，地脚线会被 overflow:hidden 裁掉（glm W9 反核遗漏角度 1） */
  @media (max-height: 720px) { .cf { min-block-size: 18rem; } }
  @media (max-width: 768px) { .cf { inline-size: auto; min-block-size: auto; padding-block-end: 1.6rem; border-block-end: 1px solid #1c1f2618; } .cf::after, .cf::before { display: none; } }
</style>
