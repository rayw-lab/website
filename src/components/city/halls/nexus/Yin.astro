---
/**
 * S0 洇 —— 展厅开场：一滴墨在宣纸上洇开，标题随之显影。
 *
 * 设计取向（与「作品集炫技感」划清界限）：
 * - 落墨**不在正中**：中国画的重心从不居中，正中构图是最快显出业余的一步。
 * - 文字**只淡入、不位移**：「渐显 + 上移 20px」是 2020 年代模板腔，一眼可辨。
 * - 文字**避开墨**：墨是主体，字是题款；题款压在画心上是外行做法。
 * - 单色，衬线中文：水墨配无衬线会散，配宋体才立得住。
 */
interface Props {
  /** 主标题两行 */
  lines?: [string, string];
  /** 副题（小字） */
  sub?: string;
}
import ledger from '../../../../data/nexus-ledger.json';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
// 起手印的印文也由 ledger 派生：会话数 / 天数，不手写
const tot = ledger.totals as Record<string, number>;
const {
  lines = ['会话即笔迹，收据即印。', '一个人与多智能体共事的一百天。'],
  sub = '墨迹 · Ink Ledger',
} = Astro.props;
---

<section class="yin" data-nexus-yin>
  <canvas data-yin-canvas aria-hidden="true"></canvas>
  <!-- 降级海报：canvas 被隐藏时顶上。构建期由 scripts/nexus-poster.mjs 截真实停帧，
       不是占位图 —— 弱环境看到的应该是「墨已经洇开的那一帧」，不是一张空白纸。 -->
  <img class="yin__poster" src={`${base}/posters/nexus-yin.webp`} alt="" hidden />

  <div class="yin__type">
    <p class="yin__sub">{sub}</p>
    <h1 class="yin__h">
      <span class="yin__l" style="--d:1.6s">{lines[0]}</span>
      <span class="yin__l" style="--d:2.9s">{lines[1]}</span>
    </h1>
    <!-- 起手印。草案 §1「第一枚印落下时标题浮现」—— 缺了它，标题写着「收据即印」
         而画面无印，概念在首屏就断了（k3 视觉审 5/10 的主要扣分项）。
         印文同样由 ledger 派生，不手写数字。 -->
    <span class="yin__seal" aria-hidden="true">
      <b>{tot.sessions}</b><i>{tot.days}日</i>
    </span>
  </div>

  <div class="yin__more" aria-hidden="true"><span></span></div>
</section>

<style>
  .yin {
    position: relative;
    width: 100%;
    min-height: 100svh;
    background: #efe9dc;                 /* 与引擎的纸色同值，降级时也是这张纸 */
    overflow: hidden;
  }
  .yin canvas, .yin__poster { position: absolute; inset: 0; width: 100%; height: 100%; display: block;
                              object-fit: cover; }
  .yin__poster[hidden] { display: none; }

  /* 题款落在右下留白处：墨的重心在左上，字与墨互不相压 */
  .yin__type {
    position: absolute;
    right: clamp(1.5rem, 6vw, 6rem);
    bottom: clamp(4rem, 12vh, 9rem);
    text-align: right;
    /* em 相对的是本元素字号（继承 16px = 544px），不是标题的 46px；
       用它会把第二行挤成两行。改用 rem 锚定根字号。
       注：此处曾用全角引号，导致 Astro scoped CSS 整块被静默丢弃且 build 不报错。 */
    max-width: min(92vw, 48rem);
    color: #1c1f26;
  }
  .yin__sub {
    margin: 0 0 1.1em;
    font: 500 clamp(.7rem, 1.1vw, .82rem)/1 ui-sans-serif, system-ui, sans-serif;
    /* 字距只微展到 .18em：拉到 .3em 以上就落进「SaaS 模板腔的细长英文碎屑」形态。
       这行是展厅名（有实义），不是装饰性标语，所以留着，但不许拉成装饰条。 */
    letter-spacing: .18em;
    text-indent: .18em;
    opacity: 0;
    animation: yin-in .9s cubic-bezier(.22,.61,.36,1) .8s forwards;
  }
  .yin__h {
    margin: 0;
    font-family: "Songti SC", "STSong", "Source Han Serif SC", "Noto Serif CJK SC",
                 "SimSun", "PingFang SC", serif;
    font-weight: 400;                    /* 宋体本身有骨，加粗反而俗 */
    font-size: clamp(1.35rem, 3.4vw, 2.7rem);
    line-height: 1.85;                   /* 中文正文级行高，给字留呼吸 */
    letter-spacing: .06em;
  }
  .yin__l {
    display: block;
    opacity: 0;
    letter-spacing: .02em;
    /* 只淡入 + 字间微展，不做 Y 轴位移。
       位移是 SaaS 模板腔；字距从 .02em 展到 .06em 更像颜料慢慢透进纸纤维。 */
    animation: yin-ink 1.6s cubic-bezier(.22,.61,.36,1) var(--d) forwards;
  }
  @keyframes yin-in { to { opacity: 1; } }

  /* 印：整幅唯一的颜色。方形、等宽字、不引篆书（草案已定）。
     微旋转是钤印的偶然性 —— 正对齐的方块是贴纸不是印。 */
  .yin__seal {
    display: inline-grid; place-items: center; gap: .1em;
    margin-top: 1.2rem; padding: .3rem;
    /* 🔴 边长不能用 em：em 相对的是印文自己的 .34em 字号，两层缩放叠起来只剩 26px。
       印该与主标题字号相当（约 40-48px），否则「整幅唯一的颜色」小到看不见。 */
    box-sizing: border-box;   /* 否则 padding+border 叠在 inline-size 之外，实测 51px 变 64px */
    inline-size: clamp(2.1rem, 2.7vw, 2.6rem); aspect-ratio: 1;
    color: #a855f7; border: 2px solid #a855f7; border-radius: 1px;
    background: #a855f70d;
    font: 500 clamp(.52rem, .74vw, .64rem)/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .04em;
    transform: rotate(-1.4deg);
    opacity: 0;
    animation: yin-in 1.1s cubic-bezier(.22,.61,.36,1) 4.2s forwards;
  }
  .yin__seal b { font-weight: 600; font-size: 1.18em; }
  .yin__seal i { font-style: normal; opacity: .82; }

  @keyframes yin-ink { to { opacity: 1; letter-spacing: .06em; } }

  .yin__more {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    width: 1px;
    height: 3.2rem;
    background: linear-gradient(to bottom, transparent, #1c1f2655);
    opacity: 0;
    animation: yin-in 1.2s ease 6s forwards;
  }
  .yin__more span {
    position: absolute; left: 0; top: 0; width: 1px; height: 1.1rem;
    background: #1c1f26aa;
    animation: yin-drop 2.6s cubic-bezier(.5,0,.5,1) 6.4s infinite;
  }
  @keyframes yin-drop { 0% { transform: translateY(0); opacity: 0 } 30% { opacity: 1 } 100% { transform: translateY(2.1rem); opacity: 0 } }

  @media (prefers-reduced-motion: reduce) {
    /* 不许动时：字直接在位，墨由构建期海报承担（canvas 由脚本隐藏） */
    .yin__sub, .yin__l, .yin__more, .yin__seal { animation: none; opacity: 1; }
    .yin__more span { animation: none; }
  }
</style>

<script>
  import { InkSurface } from './ink/InkSurface';
  import type { InkEngine } from './ink/InkEngine';

  for (const root of document.querySelectorAll<HTMLElement>('[data-nexus-yin]')) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-yin-canvas]');
    if (!canvas) continue;
    let a = false;
    // 构建期截海报走 ?poster=1：不开 preserveDrawingBuffer 时 WebGL 内容
    // 不进入页面合成截图（实测截整页只剩文字），海报会拍成一张白纸。
    const poster = new URLSearchParams(location.search).has('poster');
    InkSurface.mount(canvas, {
      preserveDrawingBuffer: poster,
      mobile: window.matchMedia('(max-width: 768px)').matches,
      onFrame: (ink: InkEngine, t: number) => {
        // 🔴 单滴起手（异源调研 agy 裁定，本席采纳）：
        // 两滴会立刻造出两个竞争性焦点、破坏开场静气；更要紧的是**叙事同构** ——
        // 单滴 = 磊哥发出的一次派单，随后流体自主分离出多道晕 = 生发多个席位，
        // 「一令生万象」。这比「疏密对比」更贴本厅主题。
        // 位置偏左上：中国画的重心从不居中，正中扩散像罗夏墨迹测验。
        if (!a && t > 0.4) { a = true; ink.drop(0.36, 0.60, 0.072, [1.3, 1.3, 1.3], 19, { vigor: 1.2, eccentricity: 0.26 }); }
      },
      onFallback: (reason) => {
        canvas.style.display = 'none';
        const poster = root.querySelector<HTMLImageElement>('.yin__poster');
        if (poster) poster.hidden = false;
        root.dataset.yinFallback = reason;
      },
    });
  }
</script>
