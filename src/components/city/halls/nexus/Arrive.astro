---
// [NX-W7] 到达墨幕的**动画**部分（首帧部分见 ArriveHead.astro，它在 <head> 里抢在首绘前挂墨）。
// 城里按 E 进楼时 PoiArrival 的墨幕（#1c1f26）不卸、带过跨文档跳转，本页 head 首帧同色接上，
// 然后被宣纸「反向虹吸」——墨向开篇那一滴的实测落点 (36vw, 46.8vh) 收缩，交棒给 S0 的 drop。
// 🔴 落点/宽高比不是按引擎坐标推的，是对 S0 成片做像素质心实测：canvas 顶边 y=69 但高仍 900，
//    引擎 y=0.60 → canvas 内 40% → 视口 46.8%；质心 (36.1%, 46.8%)、宽高比 1.48。
---
<svg class="nx-arrive__defs" width="0" height="0" aria-hidden="true" focusable="false">
  <filter id="nx-arrive-edge" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
    <!-- 低频=大起伏的洇形，高频=纤维缝里的细碎毛刺。只有低频时边缘是「水下气泡」（agy W11 P1）。 -->
    <feTurbulence type="fractalNoise" baseFrequency="0.011 0.017" numOctaves="3" seed="7" result="lo" />
    <feTurbulence type="fractalNoise" baseFrequency="0.055 0.085" numOctaves="2" seed="19" result="hi" />
    <feDisplacementMap in="SourceGraphic" in2="lo" scale="46" xChannelSelector="R" yChannelSelector="G" result="d1" />
    <feDisplacementMap in="d1" in2="hi" scale="13" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>
<script is:inline>
  (function () {
    var root = document.documentElement;
    if (!root.classList.contains('nx-transit')) return;
    // 运行痕迹（e2e/审计一手源）：起止墙钟 + 实际跑过的帧数。SwiftShader 下逐时点截图不稳，
    // 只能靠这份痕迹判「真的收缩过」而不是「挂上又直接删」。
    var trace = { startedAt: performance.now(), frames: 0, endedAt: 0, hold: false };
    window.__nxArrive = trace;
    var hold = /nx-arrive-hold/.test(location.hash);   // 停在 35% 供自看
    var done = function () {
      if (trace.endedAt) return;
      trace.endedAt = performance.now();
      root.classList.remove('nx-transit', 'nx-transit--edge', 'nx-transit--fade', 'nx-transit--out');
      root.style.removeProperty('--nx-r');
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('nx-transit--fade');
      requestAnimationFrame(function () { root.classList.add('nx-transit--out'); });
      setTimeout(done, 420);
      return;
    }
    root.classList.add('nx-transit--edge');   // defs 已解析，可以挂毛边滤镜了
    var vmax = Math.max(innerWidth, innerHeight) / 100;
    // 170vmax → 7vmax（不是 0）：收到 S0 墨团一半大小就交棒，剩下的由真墨自己长出来，
    // 避免「缩成一点再凭空冒出一团」。720ms easeOutExpo，起始延 100ms 给引擎抢跑。
    var R0 = 170 * vmax, R1 = 7 * vmax, DUR = 720, DELAY = 100, t0 = performance.now();
    root.style.setProperty('--nx-r', R0 + 'px');
    var tick = function (now) {
      var t = Math.min(1, Math.max(0, (now - t0 - DELAY) / DUR));
      trace.frames += 1;
      if (hold && t > 0.35) { trace.hold = true; t = 0.35; root.setAttribute('data-nx-arrive-state', 'hold'); }
      var e = t >= 1 ? 1 : 1 - Math.pow(2, -10 * t);
      root.style.setProperty('--nx-r', (R1 + (R0 - R1) * (1 - e)) + 'px');
      if (t > 0.88) root.style.setProperty('opacity', '');
      if (t < 1) requestAnimationFrame(tick); else done();
    };
    requestAnimationFrame(tick);
    if (!hold) setTimeout(done, 1600);
  })();
</script>
<style is:global>
  .nx-arrive__defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  /* 收尾 12%：墨核已缩到 S0 墨团大小，用透明度把最后一层交给真墨 */
  html.nx-transit::before { transition: opacity .09s linear; }
</style>
