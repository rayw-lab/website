---
// [NX-W7] 到达墨幕：城里按 E 进楼时，PoiArrival 的墨幕（#1c1f26）在跨文档跳转后由本层首帧同色接力，
// 然后被宣纸「反向虹吸」——墨向开篇那一滴的落点 (36%, 40%) 收缩、消失，S0 的 drop 在 0.4s 接上。
// 只在 ?from=city&poi=agent-nexus 命中时点亮；其它入口（直链/站内导航）不出现，脚本 is:inline 不打 chunk。
// 🔴 [hidden] 必须在 author 层再声明一次（规则 41），否则 .nx-arrive 的 display 会盖过 UA。
---
<div class="nx-arrive" data-nx-arrive hidden aria-hidden="true"></div>
<!-- 墨幕毛边：湍流位移把遮罩圆边揉成洇散边（不是几何圆）。只作用于 .nx-arrive，SVG 0 尺寸不占版面。 -->
<svg class="nx-arrive__defs" width="0" height="0" aria-hidden="true" focusable="false">
  <filter id="nx-arrive-edge" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.011 0.017" numOctaves="3" seed="7" result="n" />
    <feDisplacementMap in="SourceGraphic" in2="n" scale="46" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>
<script is:inline>
  (function () {
    var el = document.querySelector('[data-nx-arrive]');
    if (!el) return;
    var p = new URLSearchParams(location.search);
    if (p.get('from') !== 'city' || p.get('poi') !== 'agent-nexus') { el.remove(); return; }
    el.hidden = false;
    el.setAttribute('data-state', 'playing');
    // 运行痕迹（e2e/审计一手源）：起止墙钟 + 实际跑过的帧数。SwiftShader 下主线程被引擎初始化占满，
    // 逐时点截图看不见过程，只能靠这份痕迹判「真的收缩过」而不是「挂上又直接删」。
    var trace = { startedAt: performance.now(), frames: 0, endedAt: 0, hold: false };
    window.__nxArrive = trace;
    // #nx-arrive-hold：把收缩停在 35%（自看/视觉审计用），不影响正常路径
    var hold = /nx-arrive-hold/.test(location.hash);
    var done = function () {
      if (!el.isConnected) return;
      trace.endedAt = performance.now();
      el.setAttribute('data-state', 'done');
      el.remove();
    };
    var rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (rm) { el.classList.add('nx-arrive--fade'); el.addEventListener('animationend', done); setTimeout(done, 900); return; }
    // 🔴 半径不交给 CSS 自定义属性插值（实测 Chromium 上 --nx-r 全程不动、只有 opacity 在走）：rAF 逐帧写，
    // 170vmax → 0 用 easeOutExpo（先快后慢：墨先大面积退回纸里，最后一点点缩进落点），720ms 起始延 100ms。
    var vmax = Math.max(innerWidth, innerHeight) / 100;
    var R0 = 170 * vmax, DUR = 720, DELAY = 100, t0 = performance.now();
    el.style.setProperty('--nx-r', R0 + 'px');
    var tick = function (now) {
      var t = Math.min(1, Math.max(0, (now - t0 - DELAY) / DUR));
      trace.frames += 1;
      if (hold && t > 0.35) { trace.hold = true; t = 0.35; el.setAttribute('data-state', 'hold'); }
      var e = t >= 1 ? 1 : 1 - Math.pow(2, -10 * t);
      el.style.setProperty('--nx-r', (R0 * (1 - e)) + 'px');
      el.style.opacity = t > 0.88 ? String(1 - (t - 0.88) / 0.12) : '1';
      if (t < 1) requestAnimationFrame(tick); else done();
    };
    requestAnimationFrame(tick);
    if (!hold) setTimeout(done, 1600);
  })();
</script>
<style is:global>
  .nx-arrive[hidden] { display: none; }
  .nx-arrive__defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  /* 🔴 filter 先于 mask 作用：同一元素上「位移一个纯色矩形」等于没位移、遮罩边仍是几何圆（hold35-edge 对照实证）。
     所以墨色与遮罩放到 ::before，父元素只挂湍流位移——滤镜处理的是已被遮罩过的子渲染，毛边才会出来。 */
  .nx-arrive { position: fixed; inset: 0; z-index: 60; pointer-events: none; --nx-r: 170vmax; filter: url(#nx-arrive-edge); }
  .nx-arrive::before { content: ''; position: absolute; inset: -12vmax; background: #1c1f26;
    -webkit-mask-image: radial-gradient(circle at calc(36% + 12vmax * .36) calc(40% + 12vmax * .4), #000 0 var(--nx-r), transparent calc(var(--nx-r) + 7vmax));
    mask-image: radial-gradient(circle at calc(36% + 12vmax * .36) calc(40% + 12vmax * .4), #000 0 var(--nx-r), transparent calc(var(--nx-r) + 7vmax)); }
  .nx-arrive--fade { filter: none; animation: nx-arrive-fade .3s ease-out forwards; }
  .nx-arrive--fade::before { -webkit-mask-image: none; mask-image: none; inset: 0; }
  @keyframes nx-arrive-fade { to { opacity: 0; } }
</style>
