---
/**
 * S2–S6 手卷：桌面由**竖向滚动 progress** 驱动横向平移（ADR-7），
 * 移动端纯竖滚，reduced-motion 下不平移、五跋走常规文档流。
 * 🔴 禁 `wheel + preventDefault`（TECH-ARCH §3）：唯一输入是页面滚动，
 * 这里只读 rect，从不拦截事件。刷新落在中段按当前滚动恢复（首帧即算一次）。
 */
import scenes from '../../../../data/nexus-hall-scenes.json';
import { COLOPHONS } from '../../../../data/nexus-colophons';
import Colophon from './Colophon.astro';
const { stripVh } = scenes.scroll;
---

<section class="scroll" data-nexus-scroll data-progress="0" style={`--strip-vh:${stripVh}`}>
  <div class="scroll__sticky">
    <div class="scroll__head">
      <h2 class="scroll__t">题跋 · 五则</h2>
      <p class="scroll__n">手卷随滚动向右展开　<span data-scroll-pct>0%</span></p>
    </div>
    <div class="scroll__strip" data-strip>
      {COLOPHONS.map((c) => <Colophon c={c} />)}
    </div>
  </div>
</section>

<style>
  .scroll { position: relative; block-size: calc(var(--strip-vh) * 1vh); }
  .scroll__sticky {
    position: sticky; top: var(--hall-header-stack, 0px);
    /* 高度封顶：大屏上五跋只占上半，下面留一片空白是"内容顶着上沿"的默认布局味；
       封顶后 sticky 区间≈内容高度，手卷读起来像一幅横幅而不是一张空纸。 */
    block-size: min(calc(100svh - var(--hall-header-stack, 0px)), 46rem);
    overflow: hidden; display: grid; grid-template-rows: auto 1fr; gap: .8rem;
    padding: clamp(1.2rem, 4vh, 2.4rem) clamp(1.5rem, 6vw, 6rem) 0;
  }
  .scroll__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    border-bottom: 1px solid #1c1f2622; padding-bottom: .8rem; }
  .scroll__t { margin: 0; font-weight: 400; letter-spacing: .05em; font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-family: "Songti SC", "STSong", "Source Han Serif SC", "Noto Serif CJK SC", "SimSun", serif; }
  .scroll__n { margin: 0; letter-spacing: .12em; opacity: .62; font: 400 clamp(.72rem, 1.1vw, .84rem)/1.7 ui-sans-serif, system-ui, sans-serif; }
  .scroll__strip { display: flex; align-items: stretch; align-self: center; inline-size: max-content; will-change: transform; }
  /* 移动端与 reduced-motion：不平移，五跋走文档流（ADR-7） */
  @media (max-width: 768px), (prefers-reduced-motion: reduce) {
    .scroll { block-size: auto; }
    .scroll__sticky { position: static; block-size: auto; overflow: visible; }
    .scroll__strip { display: grid; inline-size: auto; transform: none !important; }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-nexus-scroll]')) {
    const strip = root.querySelector<HTMLElement>('[data-strip]');
    const pct = root.querySelector<HTMLElement>('[data-scroll-pct]');
    const sticky = root.querySelector<HTMLElement>('.scroll__sticky');
    if (!strip || !sticky) continue;
    const active = () =>
      window.matchMedia('(min-width: 769px)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0;
    const paint = () => {
      raf = 0;
      if (!active()) { strip.style.transform = ''; root.dataset.progress = '0'; return; }
      const rect = root.getBoundingClientRect();
      const travel = root.offsetHeight - sticky.offsetHeight;
      const p = travel > 0 ? Math.min(1, Math.max(0, -rect.top / travel)) : 0;
      const dx = Math.max(0, strip.scrollWidth - sticky.clientWidth);
      strip.style.transform = `translateX(${(-p * dx).toFixed(1)}px)`;
      root.dataset.progress = p.toFixed(3);
      if (pct) pct.textContent = `${Math.round(p * 100)}%`;
    };
    const ask = () => { if (!raf) raf = requestAnimationFrame(paint); };
    addEventListener('scroll', ask, { passive: true });
    addEventListener('resize', ask, { passive: true });
    paint(); // 刷新落在中段：首帧按当前滚动恢复
  }
</script>
