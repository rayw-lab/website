---
// HallChrome —— 展厅到达条（ADR-2 §1/§2/§3）。
// 构建期从 buildings JSON 查楼名/楼色（禁止进 snapshot）。
// 运行期读 ?from=city&poi= 与 sessionStorage['world-arrival-v1']；
// 探索 n/N 读 localStorage['world-explore-v1']（与 ExploreProgress 同键，合法 id 计数）。
// 无 JS 保持 hidden。Hall-0：脚本 is:inline，不另打 chunk。
import cityMap from '../../data/cyber-city-buildings.json';

interface Props {
  buildingId: string;
}

const { buildingId } = Astro.props;
const building = cityMap.buildings.find((b) => b.id === buildingId);
if (!building) {
  throw new Error(`HallChrome: buildingId「${buildingId}」不在 cyber-city-buildings.json`);
}

const poiIds = cityMap.buildings.map((b) => b.id);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
// [NX-W17 回城协议] from=hall = 城侧续驶（跳过机器人仪式、车头朝街、filters driving、幕布替代封面）；
// 退场 fx 与进站同一 token（buildings JSON arrivalFx，缺席 = 'fade'）——第 3–12 楼零代码接入
const returnHref = `${base}/?poi=${encodeURIComponent(building.id)}&from=hall`;
const returnFx = (building as { arrivalFx?: string }).arrivalFx ?? 'fade';
---

<aside
  class="hall-chrome"
  data-hall-chrome
  data-poi={building.id}
  data-allow={poiIds.join(',')}
  data-explore-total={String(poiIds.length)}
  data-return-fx={returnFx}
  hidden
  aria-label="从科技城到达"
>
  <span
    class="hall-chrome-dot"
    style={`background-color: ${building.neonColor}`}
    aria-hidden="true"
  ></span>
  <span class="hall-chrome-name">{building.title.zh}</span>
  <span class="hall-chrome-explore">
    探索 <span data-explore-count>0/{poiIds.length}</span>
  </span>
  <span class="hall-chrome-drive" data-hall-drive hidden></span>
  <a class="hall-chrome-back" href={returnHref}>返回科技城</a>
</aside>
<!-- [NX-W17] 退场遮罩：点「返回科技城」→ ink 从指尖漫开吞屏（进站 bloom 同构，接城侧首帧幕布 #1c1f26）
     / 缺省城市底色淡入 → 跳转。reduced-motion 直接跳转。bfcache 回到本页时自卸（pageshow persisted）。 -->
<div class="hall-leave-veil" data-hall-leave-veil aria-hidden="true"></div>

<script is:inline>
  (function () {
    function reveal() {
      var root = document.querySelector('[data-hall-chrome]');
      if (!root) return;
      var params = new URLSearchParams(location.search);
      var from = params.get('from');
      var poi = params.get('poi');
      var hallPoi = root.getAttribute('data-poi') || '';
      var allow = (root.getAttribute('data-allow') || '').split(',').filter(Boolean);
      if (from !== 'city' || !poi || allow.indexOf(poi) === -1 || poi !== hallPoi) return;
      // [NX-W17] 续驶记忆：合法从城里到达 = 已看过首幕；浏览器后退/手势返回不带 from=hall，
      // 城侧无显式场景参数时读此键续驶（读后即清）。直接落地本厅的访客不写——首幕留给他们。
      try {
        sessionStorage.setItem('world-return-v1', JSON.stringify({ poi: poi, at: Date.now() }));
      } catch (e4) { /* 无 storage = 后退走默认首幕 */ }
      var snap = null;
      try {
        var raw = sessionStorage.getItem('world-arrival-v1');
        if (raw) {
          var parsed = JSON.parse(raw);
          if (parsed && typeof parsed === 'object') {
            if (parsed.poi && parsed.poi !== poi) {
              // 🔴 旧卡属于上一栋楼：只丢掉驾驶短句，**不藏整条到达条**。
              // 原来这里 `return`，会把楼名 + 探索计数 + 「返回科技城」一起藏掉——
              // 从 A 楼出来再进 B 楼时，只要新快照没写成（隐私模式 / 配额满），
              // 用户就失去了回城入口。实测对照：注入 A 卡进 B 厅 → hidden:true；
              // 清掉 A 卡同 URL → hidden:false（grok 动线审计 P1-4，R37-3 坐实）。
              // 合法 query 即应显示身份条；顺手清陈旧卡，免得继续污染下一栋。
              try { sessionStorage.removeItem('world-arrival-v1'); } catch (e3) { /* 清不掉不影响本次显示 */ }
            } else {
              snap = parsed;
            }
          }
        }
      } catch (e) {
        /* 坏快照当缺失：W2 可只凭合法 query 显示到达条 */
      }
      var total = Number(root.getAttribute('data-explore-total') || '0');
      var n = 0;
      var allowSet = Object.create(null);
      for (var i = 0; i < allow.length; i++) allowSet[allow[i]] = 1;
      try {
        var exp = JSON.parse(localStorage.getItem('world-explore-v1') || '[]');
        if (Array.isArray(exp)) {
          for (var j = 0; j < exp.length; j++) {
            if (typeof exp[j] === 'string' && allowSet[exp[j]]) n++;
          }
        }
      } catch (e2) {
        n = 0;
      }
      var countEl = root.querySelector('[data-explore-count]');
      if (countEl) countEl.textContent = n + '/' + total;
      // ADR-4 决策 B 文案模板：有 maxKmh → 否则 coneHits>0 → 否则保底探索 n/N（探索行已在）
      var driveText = '';
      if (snap && typeof snap.maxKmh === 'number' && isFinite(snap.maxKmh)) {
        driveText = '最高巡航 ' + Math.round(snap.maxKmh) + ' km/h';
      } else if (snap && typeof snap.coneHits === 'number' && snap.coneHits > 0) {
        driveText = '途中碰倒 ' + snap.coneHits + ' 个锥桶';
      }
      var driveEl = root.querySelector('[data-hall-drive]');
      if (driveEl) {
        driveEl.textContent = driveText;
        driveEl.hidden = !driveText;
      }
      root.hidden = false;
    }
    // [NX-W17] 退场：主键左击且无修饰键才接管；键盘 Enter（clientX/Y=0）从链接中心漫开
    function armExit() {
      var root = document.querySelector('[data-hall-chrome]');
      var link = root && root.querySelector('.hall-chrome-back');
      if (!link) return;
      var html = document.documentElement;
      link.addEventListener('click', function (ev) {
        if (ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
        if (html.classList.contains('hall-leaving')) { ev.preventDefault(); return; }
        var reduced = false;
        try { reduced = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e5) { /* 当作不减动 */ }
        if (reduced) return;
        ev.preventDefault();
        var href = link.getAttribute('href');
        var x = ev.clientX, y = ev.clientY;
        if (!x && !y) { var r = link.getBoundingClientRect(); x = r.left + r.width / 2; y = r.top + r.height / 2; }
        html.style.setProperty('--hall-leave-x', x + 'px');
        html.style.setProperty('--hall-leave-y', y + 'px');
        var fx = root.getAttribute('data-return-fx') || 'fade';
        html.setAttribute('data-hall-leaving-fx', fx);
        html.classList.add('hall-leaving');
        window.setTimeout(function () { location.assign(href); }, fx === 'ink' ? 460 : fx === 'film' ? 380 : 300);
      });
      window.addEventListener('pageshow', function (e6) {
        if (e6.persisted) html.classList.remove('hall-leaving');
      });
    }
    function boot() { reveal(); armExit(); }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>

<style is:global>
  /* [NX-W17] 退场遮罩（global：类挂在 <html> 上，scoped 选择器够不到） */
  /* 🔴 类名不能叫 .hall-exit：hall.css:746 已有同名（展厅出口链接块），撞名会被它的纸白底盖成全白（自看实证） */
  .hall-leave-veil {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    pointer-events: none;
    overflow: hidden;
  }
  html.hall-leaving .hall-leave-veil {
    display: block;
    pointer-events: auto;
    background: #05070d;
    opacity: 0;
    animation: hall-leave-fade 300ms ease-out forwards;
  }
  html.hall-leaving[data-hall-leaving-fx='ink'] .hall-leave-veil {
    background: transparent;
    opacity: 1;
    animation: none;
  }
  html.hall-leaving[data-hall-leaving-fx='ink'] .hall-leave-veil::before {
    content: '';
    position: absolute;
    left: var(--hall-leave-x, 50%);
    top: var(--hall-leave-y, 50%);
    width: 100vmax;
    height: 100vmax;
    margin: -50vmax 0 0 -50vmax;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 50% 50%, #1c1f26 0 56%, transparent 100%),
      radial-gradient(closest-side at 64% 36%, #1c1f26 0 46%, transparent 100%),
      radial-gradient(closest-side at 38% 64%, #1c1f26 0 38%, transparent 100%);
    transform: scale(0.04);
    animation: hall-leave-ink 460ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  @keyframes hall-leave-ink {
    to {
      transform: scale(6.5);
    }
  }
  /* [FV-W4] 帧库退场 = 快门合上：上下两片叶板 .34s 合拢 + 一格白闪，与到达快门同一母题 */
  html.hall-leaving[data-hall-leaving-fx='film'] .hall-leave-veil {
    background: transparent;
    opacity: 1;
    animation: none;
  }
  html.hall-leaving[data-hall-leaving-fx='film'] .hall-leave-veil::before,
  html.hall-leaving[data-hall-leaving-fx='film'] .hall-leave-veil::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 50.5%;
    background: #000;
  }
  html.hall-leaving[data-hall-leaving-fx='film'] .hall-leave-veil::before {
    top: 0;
    transform: translateY(-100%);
    animation: hall-leave-film-top 340ms cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }
  html.hall-leaving[data-hall-leaving-fx='film'] .hall-leave-veil::after {
    bottom: 0;
    transform: translateY(100%);
    animation: hall-leave-film-bottom 380ms cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }
  @keyframes hall-leave-film-top { to { transform: translateY(0); } }
  @keyframes hall-leave-film-bottom {
    0% { transform: translateY(100%); }
    85% { transform: translateY(0); background: #000; }
    88%, 91% { transform: translateY(0); background: #fff; height: 100%; }
    100% { transform: translateY(0); background: #000; height: 100%; }
  }
  @keyframes hall-leave-fade {
    to {
      opacity: 1;
    }
  }
</style>

<style>
  /* [AH-VIS-1 债5c] 三段原本只靠 gap 分隔、探索与驾驶卡同字号同色，读成一串没有
     层级的流水字。改「· 分隔 + 三级字重/色阶」：楼名主 → 探索次 → 驾驶卡末（会话
     临时读数）。分隔点走 ::before，驾驶卡 hidden 时分隔点随之消失，不留孤点。 */
  .hall-chrome {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3) 0;
    border-block-end: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }

  .hall-chrome[hidden] {
    display: none !important;
  }

  .hall-chrome-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    flex: none;
    box-shadow: 0 0 0.55rem color-mix(in srgb, var(--hall-neon, currentColor) 70%, transparent);
    animation: hall-chrome-pulse 2.4s ease-in-out infinite;
  }

  .hall-chrome-name {
    color: var(--ink);
    font-weight: 600;
  }

  .hall-chrome:not([hidden]) {
    animation: hall-chrome-in 400ms ease-out;
  }

  .hall-chrome-explore,
  .hall-chrome-drive {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    font-variant-numeric: tabular-nums;
  }

  /* 结构性分隔点：不是内容，压到最暗一级 */
  .hall-chrome-explore::before,
  .hall-chrome-drive::before {
    content: '·';
    color: color-mix(in srgb, var(--ink-3) 70%, transparent);
  }

  .hall-chrome-explore {
    color: var(--ink-2);
  }

  .hall-chrome-drive {
    color: var(--ink-3);
  }

  .hall-chrome-drive[hidden] {
    display: none;
  }

  .hall-chrome-back {
    margin-inline-start: auto;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 0.2em;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .hall-chrome-back:hover {
    text-decoration-color: var(--accent);
  }

  @keyframes hall-chrome-pulse {
    50% {
      opacity: 0.65;
    }
  }

  @keyframes hall-chrome-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hall-chrome:not([hidden]),
    .hall-chrome-dot {
      animation: none;
    }
  }
</style>
