---
// EvidenceTag —— MDX 白名单组件（SRD §9.1）：行内证据等级标签 + 可选脱敏备注。
// 用于案例模块 10「证据」逐条标注与 Insights 关键结论行内标注；零 JS。
interface Props {
  level: 'L1' | 'L2' | 'L3' | 'L4';
  note?: string;
}

const { level, note } = Astro.props;

const LEVEL_LABELS: Record<Props['level'], string> = {
  L1: '可公开验证',
  L2: '有形产出',
  L3: '量化自述',
  L4: '定性自述',
};
---

<span class="evidence-tag data">
  <span class="tick" aria-hidden="true"></span>
  {level}
  <span class="label">{LEVEL_LABELS[level]}</span>
  {note && <span class="note">· {note}</span>}
</span>

<style>
  .evidence-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.0625rem var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    color: var(--ink-2);
    background: var(--bg);
    white-space: nowrap;
    vertical-align: 0.1em;
  }

  .tick {
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 1px;
    background: var(--accent-strong);
  }

  .label {
    color: var(--ink-3);
  }

  .note {
    color: var(--ink-3);
    white-space: normal;
  }
</style>
