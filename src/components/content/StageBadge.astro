---
// StageBadge —— MDX 白名单组件（SRD §9.1）：AI Lab 工作阶段标签。
// 阶段枚举与 content.config.ts ai-lab.stage 同源口径；零 JS。
interface Props {
  stage:
    | 'requirements-planning'
    | 'design-development'
    | 'test-delivery'
    | 'ops-retrospective';
}

const { stage } = Astro.props;

const STAGE_LABELS: Record<Props['stage'], string> = {
  'requirements-planning': '需求与规划',
  'design-development': '设计与开发',
  'test-delivery': '测试与交付',
  'ops-retrospective': '运营与复盘',
};
---

<span class="stage-badge data">{STAGE_LABELS[stage]}</span>

<style>
  .stage-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--accent-strong);
    border-radius: var(--radius-chip);
    color: var(--accent);
    background: var(--accent-soft);
    white-space: nowrap;
  }
</style>
