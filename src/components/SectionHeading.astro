---
// SectionHeading —— 编号章节标题：`01 / CAPABILITIES` + hairline + 中文 H2。
// 规格：spec §2 线框、§5.2（brittanychiang 式层级锚点）。
interface Props {
  /** 编号，如 '01'（等宽渲染，仪表感） */
  index: string;
  /** 英文标签，如 'CAPABILITIES'（大写 eyebrow） */
  label: string;
  /** 中文区块标题（H2）；供 aria-labelledby 的 id 必填 */
  title: string;
  id: string;
  /** 可选一句引导语 */
  lede?: string;
}

const { index, label, title, id, lede } = Astro.props;
---

<header class="section-heading reveal">
  <p class="kicker">
    <span class="num data" aria-hidden="true">{index}</span>
    <span class="sep" aria-hidden="true">/</span>
    <span class="label eyebrow">{label}</span>
    <span class="rule" aria-hidden="true"></span>
  </p>
  <h2 id={id}>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .section-heading {
    margin-block-end: var(--heading-gap);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .num {
    color: var(--accent);
  }

  .sep {
    color: var(--ink-3);
    font-size: var(--text-data);
  }

  .label {
    color: var(--ink-2);
  }

  .rule {
    flex: 1;
    block-size: 1px;
    background: var(--line);
  }

  h2 {
    margin-block-start: var(--space-4);
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: var(--leading-h2);
    letter-spacing: -0.01em;
  }

  .lede {
    margin-block-start: var(--space-3);
    max-inline-size: var(--measure);
    font-size: var(--text-body);
    color: var(--ink-2);
  }
</style>
