---
// HeroCarStage —— Hero 车模舞台（spec §4.1 主方案「实车即首屏」）。
// Phase 1：静态 poster（fetchpriority=high + 显式宽高，即 LCP 元素）；
// Phase 2：挂 facade 脚本 → WebGPU 慢速自转 + 实时后端徽章 + 车漆深链。
// 降级链内建：poster 本身就是合格的 Hero 视觉。
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<figure class="stage">
  <div class="frame">
    <img
      src={`${base}/posters/car-configurator-poster.webp`}
      alt="CarConcept 通用概念车渲染帧：深色展厅中的红色概念跑车"
      width="1280"
      height="720"
      fetchpriority="high"
      decoding="async"
    />
    <figcaption class="hud">CARCONCEPT STAGE · WEBP POSTER · 21 KB</figcaption>
  </div>
</figure>

<style>
  .stage {
    position: relative;
  }

  .frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg-raised);
  }

  /* 工程图纸角标线（blueprint corner ticks） */
  .stage::before,
  .stage::after {
    content: '';
    position: absolute;
    inline-size: 1rem;
    block-size: 1rem;
    border: 2px solid var(--accent-strong);
    pointer-events: none;
  }

  .stage::before {
    inset-block-start: -0.375rem;
    inset-inline-start: -0.375rem;
    border-inline-end: none;
    border-block-end: none;
  }

  .stage::after {
    inset-block-end: -0.375rem;
    inset-inline-end: -0.375rem;
    border-inline-start: none;
    border-block-start: none;
  }

  img {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .hud {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    padding: var(--space-5) var(--space-4) var(--space-3);
    background: linear-gradient(transparent, rgba(6, 7, 8, 0.55));
    color: rgba(236, 235, 230, 0.82);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }
</style>
