    "segments": 153,
    "cues": [
      {
        "start": 9.96,
        "end": 11.08,
        "text": "做仓里的对话"
      },
      {
        "start": 11.08,
        "end": 12.6,
        "text": "常常由多个座位"
      },
      {
        "start": 12.6,
        "end": 14,
        "text": "多个话题交叉组成"
      },
      {
        "start": 14.7,
        "end": 15.94,
        "text": "可以先把context"
      },
      {
        "start": 15.94,
        "end": 18.16,
        "text": "想成一本容量有限的本子"
      },
      {
        "start": 19.02,
        "end": 19.42,
        "text": "Master"
      },
      {
        "start": 19.42,
        "end": 20.12,
        "text": "Agent"
      },
      {
        "start": 20.12,
        "end": 21.78,
        "text": "要分清谁在说"
      },
      {
        "start": 21.78,
        "end": 22.62,
        "text": "要做什么"
      },
      {
        "start": 22.62,
        "end": 24.44,
        "text": "还要维护当前任务状态"
      },
      {
        "start": 24.94,
        "end": 25.6,
        "text": "这一集"
      },
      {
        "start": 25.6,
        "end": 26.86,
        "text": "我们从一句话"
      },
      {
        "start": 26.86,
        "end": 28.06,
        "text": "多意图开始"
      },
      {
        "start": 28.06,
        "end": 29.82,
        "text": "看清context"
      },
      {
        "start": 29.82,
        "end": 31.6,
        "text": "怎样管理这些信息"
      },
      {
        "start": 35.46,
        "end": 37.06,
        "text": "先看一句话多意图"
      },
      {
        "start": 37.9,
        "end": 39.06,
        "text": "比如用户说"
      },
      {
        "start": 39.06,
        "end": 41.36,
        "text": "带孩子去上周那家川菜馆"
      },
      {
        "start": 41.36,
        "end": 43.08,
        "text": "空调调到24度"
      },
      {
        "start": 43.08,
        "end": 44.78,
        "text": "再给后排放动画片"
      },
      {
        "start": 45.5,
        "end": 46.16,
        "text": "导航"
      },
      {
        "start": 46.16,
        "end": 46.94,
        "text": "空调"
      },
      {
        "start": 46.94,
        "end": 47.5,
        "text": "娱乐"
      },
      {
        "start": 47.5,
        "end": 48.34,
        "text": "三个意图"
      },
      {
        "start": 48.34,
        "end": 49.74,
        "text": "藏在同一句话里"
      },
      {
        "start": 50.34,
        "end": 52.52,
        "text": "系统先识别说话人和座位"
      },
      {
        "start": 52.52,
        "end": 54,
        "text": "再拆成独立任务"
      },
      {
        "start": 54.7,
        "end": 55.16,
        "text": "地点"
      },
      {
        "start": 55.16,
        "end": 55.74,
        "text": "温度"
      },
      {
        "start": 55.74,
        "end": 56.5,
        "text": "播放位置"
      },
      {
        "start": 56.5,
        "end": 57.92,
        "text": "分别进入任务状态"
      },
      {
        "start": 57.92,
        "end": 59.34,
        "text": "参数不能串现"
      },
      {
        "start": 60.28,
        "end": 60.64,
        "text": "下面"
      },
      {
        "start": 60.64,
        "end": 62.62,
        "text": "看一段家庭座舱实拍"
      },
      {
        "start": 62.62,
        "end": 63.8,
        "text": "主驾找餐厅"
      },
      {
        "start": 63.8,
        "end": 65.66,
        "text": "后排提出娱乐请求"
      },
      {
        "start": 66.72,
        "end": 67.26,
        "text": "小琪"
      },
      {
        "start": 67.26,
        "end": 67.96,
        "text": "我们饿了"
      },
      {
        "start": 67.96,
        "end": 68.82,
        "text": "去附近的餐厅"
      },
      {
        "start": 68.82,
        "end": 69.36,
        "text": "好嘞"
      },
      {
        "start": 69.36,
        "end": 71.1,
        "text": "这就为你导航附近的餐厅"
      },
      {
        "start": 71.1,
        "end": 72.36,
        "text": "我要看数码宝贝"
      },
      {
        "start": 72.36,
        "end": 73.86,
        "text": "以为您在后排电视"
      },
      {
        "start": 73.86,
        "end": 74.96,
        "text": "打开数码宝贝"
      },
      {
        "start": 76.72,
        "end": 77.72,
        "text": "两路请求"
      },
      {
        "start": 77.72,
        "end": 78.9,
        "text": "来自不同座位"
      },
      {
        "start": 78.9,
        "end": 81.28,
        "text": "系统分别维护各自的context"
      },
      {
        "start": 83.08,
        "end": 84.54,
        "text": "主驾在说第二家时"
      },
      {
        "start": 84.54,
        "end": 87.08,
        "text": "这个纸袋仍然落在餐厅候选"
      },
      {
        "start": 87.08,
        "end": 88.58,
        "text": "不会跳到动画片列表"
      },
      {
        "start": 89.24,
        "end": 91.18,
        "text": "一句话里的任务拆开以后"
      },
      {
        "start": 91.18,
        "end": 92.76,
        "text": "还要解决另一个限制"
      },
      {
        "start": 92.76,
        "end": 95.74,
        "text": "模型一次能看到的信息是有限的"
      },
      {
        "start": 95.74,
        "end": 99.12,
        "text": "这里需要引入context上下文窗口"
      },
      {
        "start": 103.12,
        "end": 106.6,
        "text": "下面把context上下文窗口分层讲清楚"
      },
      {
        "start": 106.6,
        "end": 109.76,
        "text": "我们把窗口总容量记作bmax"
      },
      {
        "start": 109.76,
        "end": 112.86,
        "text": "把当前已经占用的容量记作beused"
      },
      {
        "start": 112.86,
        "end": 115.12,
        "text": "一次推理能看到多少内容"
      },
      {
        "start": 115.12,
        "end": 116.46,
        "text": "取决于这个窗口"
      },
      {
        "start": 117.04,
        "end": 118.04,
        "text": "如图所示"
      },
      {
        "start": 118.04,
        "end": 120.76,
        "text": "beud等于系统提示词"
      },
      {
        "start": 120.76,
        "end": 121.86,
        "text": "工具定义"
      },
      {
        "start": 121.86,
        "end": 122.84,
        "text": "当前对话"
      },
      {
        "start": 122.84,
        "end": 125.26,
        "text": "检索结果四部分占用之和"
      },
      {
        "start": 125.26,
        "end": 127.68,
        "text": "它们共同消耗有限的token预算"
      },
      {
        "start": 127.68,
        "end": 130.86,
        "text": "同时还要为下一步生成预留be reserve"
      },
      {
        "start": 132.7,
        "end": 134.74,
        "text": "系统提示词规定角色"
      },
      {
        "start": 134.74,
        "end": 136.66,
        "text": "行为边界和安全要求"
      },
      {
        "start": 137.52,
        "end": 139.98,
        "text": "工具定义列出可用接口"
      },
      {
        "start": 139.98,
        "end": 142.2,
        "text": "还会说明需要哪些参数"
      },
      {
        "start": 142.94,
        "end": 144.12,
        "text": "当前对话记录"
