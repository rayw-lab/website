  "script": {
    "source": "asr",
    "model": "mlx-community/whisper-large-v3-turbo",
    "segments": 283,
    "cues": [
      {
        "start": 12.1,
        "end": 14.3,
        "text": "上一集把一步做对"
      },
      {
        "start": 14.3,
        "end": 17.08,
        "text": "这一集看十几步怎么排"
      },
      {
        "start": 21.58,
        "end": 22.44,
        "text": "地图没动"
      },
      {
        "start": 22.44,
        "end": 24.1,
        "text": "他嘴上说做完了"
      },
      {
        "start": 24.1,
        "end": 25.62,
        "text": "车上什么都没变"
      },
      {
        "start": 25.62,
        "end": 26.98,
        "text": "中间少了什么"
      },
      {
        "start": 26.98,
        "end": 29.1,
        "text": "这一集只盯着一个问题"
      },
      {
        "start": 29.1,
        "end": 29.98,
        "text": "我们把他做完"
      },
      {
        "start": 29.98,
        "end": 31.38,
        "text": "把一句真话放进车里"
      },
      {
        "start": 31.38,
        "end": 33.86,
        "text": "跟着系统近距离走完这一单"
      },
      {
        "start": 33.86,
        "end": 36.14,
        "text": "看他到底要长出哪些东西"
      },
      {
        "start": 36.14,
        "end": 37.7,
        "text": "才配说出那三个字"
      },
      {
        "start": 37.7,
        "end": 38.48,
        "text": "做完了"
      },
      {
        "start": 38.48,
        "end": 39.48,
        "text": "提醒一句"
      },
      {
        "start": 39.48,
        "end": 41.28,
        "text": "这一单中途会出事"
      },
      {
        "start": 41.72,
        "end": 43.76,
        "text": "上一集说的是把一步做对"
      },
      {
        "start": 43.76,
        "end": 47.32,
        "text": "这一集难的是十几步之间的关系"
      },
      {
        "start": 47.32,
        "end": 50.14,
        "text": "车里这句话被真的说了出来"
      },
      {
        "start": 50.52,
        "end": 51.62,
        "text": "腰有点不舒服"
      },
      {
        "start": 51.62,
        "end": 52.68,
        "text": "帮我放松一下"
      },
      {
        "start": 52.68,
        "end": 54.9,
        "text": "然后去上次去过的那家穿菜馆"
      },
      {
        "start": 55.38,
        "end": 56.14,
        "text": "对人说"
      },
      {
        "start": 56.14,
        "end": 58.1,
        "text": "对方听完就知道该干嘛"
      },
      {
        "start": 58.1,
        "end": 59.06,
        "text": "对车说"
      },
      {
        "start": 59.06,
        "end": 60.4,
        "text": "麻烦才刚开始"
      },
      {
        "start": 60.4,
        "end": 61.74,
        "text": "哪个座位的腰"
      },
      {
        "start": 61.74,
        "end": 62.96,
        "text": "放松是按摩"
      },
      {
        "start": 62.96,
        "end": 63.68,
        "text": "是加热"
      },
      {
        "start": 63.68,
        "end": 64.88,
        "text": "还是把靠背放倒"
      },
      {
        "start": 64.88,
        "end": 66.66,
        "text": "上次那家是哪一次"
      },
      {
        "start": 66.66,
        "end": 68.3,
        "text": "那家店今天还开着吗"
      },
      {
        "start": 68.3,
        "end": 70.02,
        "text": "更要命的是先后"
      },
      {
        "start": 70.42,
        "end": 71.76,
        "text": "座椅现在就能动"
      },
      {
        "start": 71.76,
        "end": 73.4,
        "text": "导航却不能在地点"
      },
      {
        "start": 73.4,
        "end": 74.62,
        "text": "没定下来的时候瞎跑"
      },
      {
        "start": 75.2,
        "end": 76.1,
        "text": "从这一秒起"
      },
      {
        "start": 76.1,
        "end": 77.14,
        "text": "我们不举例"
      },
      {
        "start": 77.14,
        "end": 77.86,
        "text": "不讲课"
      },
      {
        "start": 77.86,
        "end": 79.08,
        "text": "就跟着这一单"
      },
      {
        "start": 79.08,
        "end": 80.84,
        "text": "看系统怎么把它跑完"
      },
      {
        "start": 80.84,
        "end": 82.6,
        "text": "又在哪里差点栽进去"
      },
      {
        "start": 83.1,
        "end": 84.42,
        "text": "系统的第一个动作"
      },
      {
        "start": 84.42,
        "end": 85.64,
        "text": "甚至不是动手"
      },
      {
        "start": 86.02,
        "end": 87.58,
        "text": "他先弄清楚几件事"
      },
      {
        "start": 88.02,
        "end": 89.02,
        "text": "说话的是谁"
      },
      {
        "start": 89.02,
        "end": 90.18,
        "text": "坐在哪个位置"
      },
      {
        "start": 90.18,
        "end": 91.54,
        "text": "这个座位的座椅"
      },
      {
        "start": 91.54,
        "end": 92.6,
        "text": "现在是什么状态"
      },
      {
        "start": 92.6,
        "end": 94.4,
        "text": "最近这几句聊过什么"
      },
      {
        "start": 94.82,
        "end": 95.74,
        "text": "历史记录里"
      },
      {
        "start": 95.74,
        "end": 96.86,
        "text": "去过的穿菜馆"
      },
      {
        "start": 96.86,
        "end": 97.52,
        "text": "有哪几家"
      },
      {
        "start": 97.52,
        "end": 99.18,
        "text": "最近一次是什么时候"
      },
      {
        "start": 99.68,
        "end": 101.6,
        "text": "这一层叫上下文"
      },
      {
        "start": 101.6,
        "end": 103.02,
        "text": "他不追求全"
      },
      {
        "start": 103.02,
        "end": 105.32,
        "text": "只留会改变下一步的那几样"
      },
      {
        "start": 105.32,
        "end": 106.7,
        "text": "搞错说话人"
      },
      {
        "start": 106.7,
        "end": 108.28,
        "text": "按摩就开到副驾去了"
      },
      {
        "start": 108.28,
        "end": 109.7,
        "text": "地点没坐实"
      },
      {
        "start": 109.7,
        "end": 111.32,
        "text": "导航拿着一个店名"
      },
      {
        "start": 111.32,
        "end": 112.18,
        "text": "也会走错门"
      },
      {
        "start": 112.6,
        "end": 113.66,
        "text": "还要记住一件事"
      },
      {
        "start": 113.66,
        "end": 115.28,
        "text": "查出来的上次那家"
      },
      {
        "start": 115.28,
        "end": 116.58,
        "text": "此刻只是候选"
      },
      {
        "start": 116.58,
        "end": 118.16,
        "text": "还不能直接送去导航"
      },
      {
        "start": 118.56,
        "end": 119.34,
        "text": "拆单开始"
      },
      {
        "start": 119.84,
        "end": 120.68,
        "text": "你看这张图"
      },
      {
        "start": 120.68,
        "end": 121.54,
        "text": "长出来的样子"
      },
      {
        "start": 121.92,
        "end": 122.94,
        "text": "座椅这一只"
      },
      {
        "start": 122.94,
        "end": 124.24,
        "text": "没有前置条件"
      },
      {
        "start": 124.24,
        "end": 125.16,
        "text": "立刻能动"
      },
      {
        "start": 125.68,
        "end": 126.68,
        "text": "餐厅这一只"
      },
      {
        "start": 126.68,
        "end": 128.24,
        "text": "得先查到访记录"
      },
      {
        "start": 128.24,
        "end": 129.64,
        "text": "把候选拿回来"
      },
      {
        "start": 129.64,
        "end": 130.86,
        "text": "两只同时跑"
      },
      {
        "start": 130.86,
        "end": 132.38,
        "text": "按摩不用等地图"
      },
      {
        "start": 132.38,
        "end": 134.22,
        "text": "查电也不该卡着座椅"
      },
      {
        "start": 134.22,
        "end": 136.5,
        "text": "真正连着线的是导航"
      },
      {
        "start": 136.5,
        "end": 138.46,
        "text": "他必须等一个能用的地点"
      },
      {
        "start": 138.46,
        "end": 139.68,
        "text": "复杂任务"
      },
      {
        "start": 139.68,
        "end": 140.84,
        "text": "真正多出来的东西"
      },
      {
        "start": 140.84,
        "end": 142.26,
        "text": "不是多叫几个工具"
      },
      {
        "start": 142.26,
        "end": 143.24,
        "text": "是这些线"
      },
      {
        "start": 143.92,
        "end": 145.92,
        "text": "这个东西叫任务图"
      },
      {
        "start": 145.92,
        "end": 147.28,
        "text": "它跟第一步"
      },
      {
        "start": 147.28,
        "end": 147.74,
        "text": "第二步"
      },
      {
        "start": 147.74,
        "end": 148.98,
        "text": "第三步的区别在于"
      },
      {
        "start": 148.98,
        "end": 150.7,
        "text": "清单只有先后"
      },
      {
        "start": 150.7,
        "end": 153,
        "text": "图上写着谁能并行"
      },
      {
        "start": 153,
        "end": 154.18,
        "text": "谁在等谁"
      },
      {
        "start": 154.18,
        "end": 155.14,
        "text": "谁失败了"
      },
      {
        "start": 155.14,
        "end": 155.92,
        "text": "会挡住谁"
      },
      {
        "start": 156.42,
        "end": 157.64,
        "text": "座椅先动了"
      },
      {
        "start": 158.14,
        "end": 159.56,
        "text": "注意右下角这块板"
      },
      {
        "start": 160,
        "end": 160.92,
        "text": "左边一栏"
      },
      {
        "start": 160.92,
        "end": 162,
        "text": "记他说过的话"
      },
      {
        "start": 162,
        "end": 165.2,
        "text": "右边一栏只记车上真实发生的变化"
      },
      {
        "start": 165.2,
        "end": 166.32,
        "text": "刚才那声"
      },
      {
        "start": 166.32,
        "end": 166.78,
        "text": "好的"
      },
      {
        "start": 166.78,
        "end": 167.6,
        "text": "帮您放松"
      },
      {
        "start": 167.6,
        "end": 168.58,
        "text": "落在左栏"
      },
      {
        "start": 169.06,
        "end": 171.2,
        "text": "现在座椅垫机的读数回来了"
      },
      {
        "start": 171.2,
        "end": 173.04,
        "text": "右栏落下第一笔"
      },
      {
        "start": 173.04,
        "end": 174.38,
        "text": "先别急着打勾"
      },
      {
        "start": 174.38,
        "end": 176.08,
        "text": "这一单还长着呢"
      },
      {
        "start": 176.08,
        "end": 178.04,
        "text": "这块板会一直挂在这"
      },
      {
        "start": 178.04,
        "end": 179.46,
        "text": "到访记录回来了"
      },
      {
        "start": 179.46,
        "end": 181.38,
        "text": "三家川菜馆"
      },
      {
        "start": 181.88,
        "end": 183.06,
        "text": "系统停住了"
      },
      {
        "start": 183.48,
        "end": 184.84,
        "text": "他没有替你赌一家"
      },
      {
        "start": 184.84,
        "end": 186.76,
        "text": "也没有把三家都塞给导航"
      },
      {
        "start": 186.76,
        "end": 187.74,
        "text": "他问了一句"
      },
      {
        "start": 187.74,
        "end": 189.64,
        "text": "上次那家是不是这家"
      },
      {
        "start": 189.64,
        "end": 191.56,
        "text": "然后车在等人"
      },
      {
        "start": 191.56,
        "end": 192.96,
        "text": "看起来像卡顿"
      },
      {
        "start": 192.96,
        "end": 194.34,
        "text": "其实是一道门"
      },
      {
        "start": 194.34,
        "end": 196.54,
        "text": "钥匙在真实世界手里"
      },
      {
        "start": 196.54,
        "end": 198.3,
        "text": "这个门叫等待"
      },
      {
        "start": 198.3,
        "end": 200.02,
        "text": "等的可以是人开口"
      },
      {
        "start": 200.02,
        "end": 202.12,
        "text": "也可以是一件事真的发生"
      },
      {
        "start": 202.12,
        "end": 203.44,
        "text": "在别的单子里"
      },
      {
        "start": 203.44,
        "end": 204.66,
        "text": "这道门更阴"
      },
      {
        "start": 204.66,
        "end": 205.86,
        "text": "车到了学校"
      },
      {
        "start": 205.86,
        "end": 207.4,
        "text": "不等于孩子已经上车"
      },
      {
        "start": 207.4,
        "end": 209.34,
        "text": "导航能把车带到校门口"
      },
      {
        "start": 209.34,
        "end": 210.88,
        "text": "但接到孩子这件事"
      },
      {
        "start": 210.88,
        "end": 212.5,
        "text": "得等车门真的开过"
      },
      {
        "start": 212.5,
        "end": 213.96,
        "text": "后排真的坐下人"
      },
      {
        "start": 213.96,
        "end": 214.9,
        "text": "才算数"
      },
      {
        "start": 215.4,
        "end": 216.92,
        "text": "门口还躺着一条"
      },
      {
        "start": 216.92,
        "end": 218.38,
        "text": "容易越过去的边界"
      },
      {
        "start": 218.38,
        "end": 219.84,
        "text": "帮我放松一下"
      },
      {
        "start": 219.84,
        "end": 222.18,
        "text": "授权的是这个座位的一次放松"
      },
      {
        "start": 222.18,
        "end": 223.5,
        "text": "他没有允许系统"
      },
      {
        "start": 223.5,
        "end": 224.52,
        "text": "替你把电定了"
      },
      {
        "start": 224.52,
        "end": 226.28,
        "text": "更没有允许他趁你犹豫"
      },
      {
        "start": 226.28,
        "end": 227.48,
        "text": "先把路线改了"
      },
      {
        "start": 227.48,
        "end": 229.5,
        "text": "编排要分得清三件事"
      },
      {
        "start": 229.5,
        "end": 231.3,
        "text": "哪一步现在能坐"
      },
      {
        "start": 231.3,
        "end": 232.86,
        "text": "哪一步必须等"
      },
      {
        "start": 232.86,
        "end": 235.14,
        "text": "哪一步压根没被授权"
      },
      {
        "start": 235.14,
        "end": 236.66,
        "text": "这三件事分不清"
      },
      {
        "start": 236.66,
        "end": 238.84,
        "text": "能力越强的系统越吓人"
      },
      {
        "start": 239.22,
        "end": 240.1,
        "text": "你答了一句"
      },
      {
        "start": 240.1,
        "end": 242.08,
        "text": "就上次那家门开了"
      },
      {
        "start": 242.08,
        "end": 243.38,
        "text": "调度不神秘"
      },
      {
        "start": 243.38,
        "end": 245.48,
        "text": "看哪些节点的条件齐了"
      },
      {
        "start": 245.48,
        "end": 246.52,
        "text": "把活派下去"
      },
      {
        "start": 246.94,
        "end": 248.64,
        "text": "查营业时间和算路线"
      },
      {
        "start": 248.64,
        "end": 249.34,
        "text": "可以一起跑"
      },
      {
        "start": 249.34,
        "end": 250.78,
        "text": "要抢同一块屏"
      },
      {
        "start": 250.78,
        "end": 252.32,
        "text": "同一个座椅垫机的"
      },
      {
        "start": 252.32,
        "end": 252.98,
        "text": "排队等"
      },
      {
        "start": 252.98,
        "end": 254.98,
        "text": "两个活同时去改地图"
      },
      {
        "start": 254.98,
        "end": 256.86,
        "text": "或者座椅状态还没读回来"
      },
      {
        "start": 256.86,
        "end": 257.76,
        "text": "又发一遍指令"
      },
      {
        "start": 257.76,
        "end": 258.98,
        "text": "系统只会更乱"
      },
      {
        "start": 259.44,
        "end": 260.8,
        "text": "并行是挑出来的"
      },
      {
        "start": 260.8,
        "end": 261.9,
        "text": "不是越多越好"
      },
      {
        "start": 261.9,
        "end": 263.02,
        "text": "这套走法"
      },
      {
        "start": 263.02,
        "end": 264.34,
        "text": "学界吵了好几年"
      },
      {
        "start": 264.34,
        "end": 266.2,
        "text": "一波叫模型怎么想"
      },
      {
        "start": 266.2,
        "end": 267.74,
        "text": "先练完计划再动手"
      },
      {
        "start": 267.74,
        "end": 268.92,
        "text": "还是边想边做"
      },
      {
        "start": 268.92,
        "end": 270.88,
        "text": "另一波管工具怎么调度"
      },
      {
        "start": 270.88,
        "end": 272.7,
        "text": "让模型排出一张任务表"
      },
      {
        "start": 272.7,
        "end": 273.62,
        "text": "标清楚依赖"
      },
      {
        "start": 273.62,
        "end": 275.22,
        "text": "运行时按依赖派活"
      },
      {
        "start": 275.86,
        "end": 276.84,
        "text": "今天这单走的"
      },
      {
        "start": 276.84,
        "end": 277.7,
        "text": "就是第二波的路"
      },
      {
        "start": 277.7,
        "end": 279.62,
        "text": "再加一层车上才有的规矩"
      },
      {
        "start": 279.62,
        "end": 281.82,
        "text": "每一步都要回真实世界"
      },
      {
        "start": 281.82,
        "end": 282.38,
        "text": "对一次账"
      },
      {
        "start": 282.92,
        "end": 283.96,
        "text": "导航发下去了"
      },
      {
        "start": 283.96,
        "end": 285.3,
        "text": "车机打得干脆"
      },
      {
        "start": 285.3,
        "end": 287.1,
        "text": "好的导航已经设好了"
      },
      {
        "start": 287.7,
        "end": 288.96,
        "text": "左栏记了一笔"
      },
      {
        "start": 288.96,
        "end": 290.34,
        "text": "右栏没动"
      },
      {
        "start": 290.34,
        "end": 292.18,
        "text": "开头那段路平"
      },
      {
        "start": 292.18,
        "end": 293.32,
        "text": "你已经见过这一幕"
      },
      {
        "start": 293.32,
        "end": 293.96,
        "text": "非常答应了"
      },
      {
        "start": 293.96,
        "end": 295.06,
        "text": "地图没变"
      },
      {
        "start": 295.06,
        "end": 296.52,
        "text": "当时我们不知道"
      },
      {
        "start": 296.52,
        "end": 297.32,
        "text": "中间少了什么"
      },
      {
        "start": 297.32,
        "end": 298.6,
        "text": "现在这张图上"
      },
      {
        "start": 298.6,
        "end": 300.18,
        "text": "红掉的就是那个节点"
      },
      {
        "start": 300.18,
        "end": 302.18,
        "text": "系统要是信了自己那句"
      },
      {
        "start": 302.18,
        "end": 305.42,
        "text": "好了往下每一步都踩在一个错的状态上"
      },
      {
        "start": 305.42,
        "end": 306.82,
        "text": "所以他没有往下走"
      },
      {
        "start": 306.82,
        "end": 308.96,
        "text": "他先去读车上的真实状态"
      },
      {
        "start": 308.96,
        "end": 310.66,
        "text": "地图到底变没变"
      },
      {
        "start": 310.66,
        "end": 311.92,
        "text": "读不回来结果"
      },
      {
        "start": 311.92,
        "end": 313.2,
        "text": "就先记成不知道"
      },
      {
        "start": 313.2,
        "end": 313.94,
        "text": "不猜"
      },
      {
        "start": 313.94,
        "end": 315.1,
        "text": "也不急着重发"
      },
      {
        "start": 315.76,
        "end": 316.5,
        "text": "核对回来了"
      },
      {
        "start": 316.5,
        "end": 317.86,
        "text": "刚才那条指令没送到"
      },
      {
        "start": 317.86,
        "end": 319.82,
        "text": "地图服务那几秒正好在重启"
      },
      {
        "start": 319.82,
        "end": 321.88,
        "text": "确认这一步确实没执行过"
      },
      {
        "start": 321.88,
        "end": 323.62,
        "text": "才允许原样再来一遍"
      },
      {
        "start": 323.62,
        "end": 324.82,
        "text": "要是参数错了"
      },
      {
        "start": 324.82,
        "end": 325.78,
        "text": "该改的是参数"
      },
      {
        "start": 325.78,
        "end": 327.34,
        "text": "要是这条路彻底堵死"
      },
      {
        "start": 327.34,
        "end": 328.16,
        "text": "就换条路"
      },
      {
        "start": 328.16,
        "end": 329.16,
        "text": "或者回头问人"
      },
      {
        "start": 329.16,
        "end": 330.3,
        "text": "最麻烦的是"
      },
      {
        "start": 330.3,
        "end": 331.6,
        "text": "动作已经发生的那种"
      },
      {
        "start": 331.6,
        "end": 332.84,
        "text": "靠背已经放倒了"
      },
      {
        "start": 332.84,
        "end": 334.7,
        "text": "只能在放倒的基础上接着算"
      },
      {
        "start": 334.7,
        "end": 335.92,
        "text": "装没发生过"
      },
      {
        "start": 335.92,
        "end": 336.92,
        "text": "才是最危险的"
      },
      {
        "start": 336.92,
        "end": 337.66,
        "text": "重启"
      },
      {
        "start": 337.66,
        "end": 338.98,
        "text": "是原样再跑一遍"
      },
      {
        "start": 338.98,
        "end": 339.66,
        "text": "重排"
      },
      {
        "start": 339.66,
        "end": 341.2,
        "text": "是把还有效的留下"
      },
      {
        "start": 341.2,
        "end": 342.26,
        "text": "把失效的撤掉"
      },
      {
        "start": 342.26,
        "end": 343.9,
        "text": "只重划受影响的那一块"
      },
      {
        "start": 343.9,
        "end": 344.76,
        "text": "这一单"
      },
      {
        "start": 344.76,
        "end": 345.76,
        "text": "没伤到别的节点"
      },
      {
        "start": 345.76,
        "end": 346.74,
        "text": "重启就够"
      },
      {
        "start": 347.28,
        "end": 348.08,
        "text": "这套动作"
      },
      {
        "start": 348.08,
        "end": 349.2,
        "text": "今天的真车"
      },
      {
        "start": 349.2,
        "end": 350.26,
        "text": "能走到哪一步"
      },
      {
        "start": 350.26,
        "end": 351.72,
        "text": "看一段公开演示"
      },
      {
        "start": 352.18,
        "end": 353.78,
        "text": "系统把地点听错了"
      },
      {
        "start": 353.78,
        "end": 354.82,
        "text": "是人停下来"
      },
      {
        "start": 354.82,
        "end": 355.72,
        "text": "重新说了一遍"
      },
      {
        "start": 355.72,
        "end": 356.46,
        "text": "才走通"
      },
      {
        "start": 357,
        "end": 357.84,
        "text": "公开场合"
      },
      {
        "start": 357.84,
        "end": 359.14,
        "text": "愿意留下失败画面"
      },
      {
        "start": 359.14,
        "end": 360.06,
        "text": "这很诚实"
      },
      {
        "start": 360.06,
        "end": 361.52,
        "text": "但人工重说"
      },
      {
        "start": 361.52,
        "end": 362.9,
        "text": "和自动发现之间"
      },
      {
        "start": 362.9,
        "end": 363.6,
        "text": "差的那一段"
      },
      {
        "start": 363.6,
        "end": 364.5,
        "text": "就是刚才"
      },
      {
        "start": 364.5,
        "end": 365.3,
        "text": "你看着系统"
      },
      {
        "start": 365.3,
        "end": 366.5,
        "text": "自己走完的那一段"
      },
      {
        "start": 366.88,
        "end": 367.74,
        "text": "第二次下发"
      },
      {
        "start": 367.74,
        "end": 369.2,
        "text": "车机又说了一遍"
      },
      {
        "start": 369.2,
        "end": 369.72,
        "text": "设好了"
      },
      {
        "start": 369.72,
        "end": 371.08,
        "text": "这次我们不听他的"
      },
      {
        "start": 371.08,
        "end": 371.9,
        "text": "看右蓝"
      },
      {
        "start": 372.28,
        "end": 373.26,
        "text": "地图动了"
      },
      {
        "start": 373.26,
        "end": 374.28,
        "text": "路线出来了"
      },
      {
        "start": 374.28,
        "end": 375.02,
        "text": "右蓝"
      },
      {
        "start": 375.02,
        "end": 375.6,
        "text": "落笔"
      },
      {
        "start": 375.6,
        "end": 376.9,
        "text": "回到那句话"
      },
      {
        "start": 377.32,
        "end": 378.26,
        "text": "跑完这一单"
      },
      {
        "start": 378.26,
        "end": 379.8,
        "text": "它长出来的东西是"
      },
      {
        "start": 379.8,
        "end": 381.02,
        "text": "一层上下纹"
      },
      {
        "start": 381.02,
        "end": 382.28,
        "text": "一张任务图"
      },
      {
        "start": 382.28,
        "end": 383.66,
        "text": "一道等待的门"
      },
      {
        "start": 383.66,
        "end": 385.24,
        "text": "一条授权的边界"
      },
      {
        "start": 385.24,
        "end": 386.16,
        "text": "一次对账"
      },
      {
        "start": 386.16,
        "end": 387.1,
        "text": "一次改道"
      },
      {
        "start": 387.64,
        "end": 388.4,
        "text": "这些东西"
      },
      {
        "start": 388.4,
        "end": 389.52,
        "text": "以前都装在"
      },
      {
        "start": 389.52,
        "end": 391.28,
        "text": "产品经理和工程师的脑子里"
      },
      {
        "start": 391.28,
        "end": 392.88,
        "text": "现在得写下来"
      },
      {
        "start": 392.88,
        "end": 394.9,
        "text": "写成一张系统能跑的图"
      },
      {
        "start": 395.3,
        "end": 396.2,
        "text": "而这张图"
      },
      {
        "start": 396.2,
        "end": 397.56,
        "text": "配不配叫做完了"
      },
      {
        "start": 397.56,
        "end": 399.04,
        "text": "标准从头到尾"
      },
      {
        "start": 399.04,
        "end": 399.64,
        "text": "只有一条"
      },
      {
        "start": 399.64,
        "end": 400.62,
        "text": "画的账"
      },
      {
        "start": 400.62,
        "end": 402,
        "text": "对上世界的账"
      },
      {
        "start": 402.4,
        "end": 403.34,
        "text": "至于下一集"
      },
      {
        "start": 403.34,
        "end": 404.6,
        "text": "车开在半路"
      },
      {
        "start": 404.6,
        "end": 405.66,
        "text": "人改了主意"
      },
      {
        "start": 405.66,
        "end": 406.7,
        "text": "先别去这"
      },
      {
        "start": 406.7,
        "end": 407.46,
        "text": "换个地方"
      },
      {
        "start": 407.46,
        "end": 408.6,
        "text": "到那时"
      },
      {
        "start": 408.6,
        "end": 409.88,
        "text": "系统是原样"
      },
      {
        "start": 409.88,
        "end": 410.56,
        "text": "再试一次"
      },
      {
        "start": 410.56,
        "end": 411.74,
        "text": "还是真有本事"
      },
      {
        "start": 411.74,
        "end": 413.04,
        "text": "把整张图重排"
      },
      {
        "start": 413.48,
        "end": 414.2,
        "text": "这一单"
      },
      {
        "start": 414.2,
        "end": 415.14,
        "text": "对上了"
      },
      {
        "start": 415.14,
        "end": 418.32,
        "text": "请不吝点赞 订阅 转发 打赏支持明镜与点点栏目"
      },
      {
        "start": 420.14,
        "end": 423.04,
        "text": "请不吝点赞 订阅 转发 打赏支持明镜与点点栏目"
      },
